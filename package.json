{
  "name": "vaultique",
  "version": "1.0.0",
  "description": "Luxury watch e-commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod-install": "npm install --omit=dev",
    "install:ci": "npm ci --omit=dev",
    "build": "echo 'No build step required for backend'",
    "seed": "node seed/Products-Seed.js",
    "seed:brands": "node seed/Brands-Seed.js",
    "seed:collections": "node seed/Collections-Seed.js",
    "seed:users": "node seed/Users-Seed.js",
    "seed:all": "npm run seed && npm run seed:brands && npm run seed:collections && npm run seed:users",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:server": "jest server.test.js",
    "test:auth": "jest auth.test.js",
    "test:products": "jest products.test.js",
    "test:cart": "jest cart.test.js",
    "test:unit": "jest --testPathPattern=__tests__/.*\\.test\\.js --testNamePattern='(Server|Auth|Products|Cart)'",
    "test:integration": "jest --testPathPattern=__tests__/.*\\.test\\.js --testNamePattern='(API|Routes|Database)'",
    "fix-passwords": "node scripts/fix-passwords.js",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "qrcode": "^1.5.3",
    "stream-chat": "^9.1.1",
    "stripe": "^14.25.0",
    "three": "^0.160.0",
    "twilio": "^4.19.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "punycode": "^2.3.1",
    "rimraf": "^5.0.5",
    "glob": "^10.3.10",
    "npmlog": "^7.0.1"
  }
}
