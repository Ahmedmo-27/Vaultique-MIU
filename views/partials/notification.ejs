<!-- Notification Modal -->
<div class="modal-overlay<%= typeof locals !== 'undefined' && locals.show ? ' show' : '' %>" id="notificationModal">
    <div class="modal-container">
        <div class="modal-header">
            <h3><%= typeof locals !== 'undefined' && locals.type ? locals.type.charAt(0).toUpperCase() + locals.type.slice(1) : 'Notification' %></h3>
            <button class="close-modal" onclick="closeNotification()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="notification-icon <%= typeof locals !== 'undefined' ? locals.type : 'info' %>">
                <% if (typeof locals !== 'undefined' && locals.type) { %>
                    <% if (locals.type === 'success') { %>
                        ✓
                    <% } else if (locals.type === 'error') { %>
                        ✕
                    <% } else { %>
                        ℹ
                    <% } %>
                <% } else { %>
                    ℹ
                <% } %>
            </div>
            <div class="notification-message">
                <%= typeof locals !== 'undefined' && locals.message ? locals.message : 'An error occurred' %>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeNotification()" data-translate="close">Close</button>
        </div>
    </div>
</div>

<script>
    // Auto close notification after 5 seconds if shown
    if (typeof locals !== 'undefined' && locals.show) {
        setTimeout(() => {
            closeNotification();
        }, 5000);
    }

    // Only define closeNotification if it doesn't already exist
    if (typeof closeNotification === 'undefined') {
        // Close notification function
        function closeNotification() {
            const modal = document.getElementById('notificationModal');
            if (modal) {
                modal.classList.remove('show');
                setTimeout(() => {
                    modal.remove();
                }, 300);
            }
        }
    }
</script>
  <!-- ملفات الترجمة -->
  <script src="/Javascript/translations.js"></script>
  <script src="/Javascript/language.js"></script>
<style>
