<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Make sure Font Awesome is loaded
        if (typeof FontAwesome === 'undefined') {
            const fontAwesomeLink = document.createElement('link');
            fontAwesomeLink.rel = 'stylesheet';
            fontAwesomeLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css';
            document.head.appendChild(fontAwesomeLink);
        }
        
        // Manual initialization for side panel
        const sideIcon = document.getElementById('side-icon');
        const closebtn = document.getElementById('closebtn');
        
        if(sideIcon) {
            sideIcon.addEventListener('click', function() {
                const panel = document.getElementById('mySidepanel');
                panel.style.display = 'block';
                panel.style.width = '250px';
            });
        }
        
        if(closebtn) {
            closebtn.addEventListener('click', function() {
                document.getElementById('mySidepanel').style.width = '0';
            });
        }
    });
</script>