<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  
  <!-- SEO Meta Tags -->
  <title><%= title || 'Vaultique | Watch Recommendation System - Find Your Perfect Timepiece' %></title>
  <meta name="description" content="Discover your perfect luxury watch with Vaultique's intelligent recommendation system. Take our personalized quiz to find the ideal Swiss timepiece that matches your style and preferences.">
  <meta name="keywords" content="watch recommendation, luxury watch quiz, Swiss watch finder, personalized watch selection, watch personality quiz, luxury timepiece recommendation, Vaultique quiz">
  <meta name="author" content="Vaultique">
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Vaultique | Watch Recommendation System - Find Your Perfect Timepiece">
  <meta property="og:description" content="Discover your perfect luxury watch with Vaultique's intelligent recommendation system. Take our personalized quiz to find the ideal Swiss timepiece.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vaultique.com/user/Recommendation-System">
  <meta property="og:image" content="/Assets/Images/LogoV.jpg">
  <meta property="og:site_name" content="Vaultique">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Vaultique | Watch Recommendation System - Find Your Perfect Timepiece">
  <meta name="twitter:description" content="Discover your perfect luxury watch with Vaultique's intelligent recommendation system. Take our personalized quiz to find the ideal Swiss timepiece.">
  <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://vaultique.com/user/Recommendation-System">
  
  <!-- Preconnect to external resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="/CSS/Loading Screen.css">
  <script src="/Javascript/Loading Screen.js"></script>
  <link rel="stylesheet" href="/CSS/nav-bar.css">
  <link rel="stylesheet" href="/CSS/Recommendation.css" /> 
  <link rel="stylesheet" href="/CSS/footer.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  
  <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
  
  <!-- JSON-LD Schema Markup -->
  <script type="application/ld+json">
  {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Vaultique Watch Recommendation System",
      "description": "Intelligent watch recommendation system that helps users find their perfect luxury timepiece",
      "url": "https://vaultique.com/user/Recommendation-System",
      "applicationCategory": "RecommendationSystem",
      "operatingSystem": "Web Browser",
      "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
          "availability": "https://schema.org/InStock"
      },
      "featureList": [
          "Personalized Quiz",
          "Style Analysis",
          "Watch Recommendations",
          "Interactive Questions",
          "Results Summary"
      ],
      "author": {
          "@type": "Organization",
          "name": "Vaultique"
      }
  }
  </script>
</head>
<body class="dark-mode">    

  <%- include('partials/navigation') %>
  <%- include('partials/loading-screen') %>

  <div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
  </div>
    
  <main class="quiz-container animate__animated animate__fadeIn">
    <div class="quiz-header">
      <h1 class="question" id="question">What's your approach to wearing watches?</h1>
      <div class="question-counter" id="questionCounter" data-translate="questionCounter">1/5</div>
    </div>

    <div class="options" id="options"></div>

    <div class="quiz-footer">
      <button class="btn-skip" id="skipBtn" data-translate="skipQuestion">Skip question</button>
    </div>

    <div id="quizResults"></div>
  </main>

  <%- include('partials/footer') %>

  <!-- Scripts -->
  <script src="/Javascript/nav-bar.js"></script>
  <script src="/Javascript/Light-Mode.js"></script>
  <script src="/Javascript/Recommendation.js"></script>
      <!-- ملفات الترجمة -->
<script src="/Javascript/translations.js"></script>
<script src="/Javascript/language.js"></script>
</body>
</html>
