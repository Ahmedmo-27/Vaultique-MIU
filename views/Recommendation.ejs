<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'Discover Your Watch Personality' %></title>


  <link rel="stylesheet" href="/CSS/Recommendation.css" /> 
  <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg"> 

  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet"/>
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
</head>
<body>    

  <div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
  </div>

<div id="loading-screen" class="loading-screen">
  <div class="loader"></div>
 
</div>

  
  
  <main class="quiz-container animate__animated animate__fadeIn">
    <div class="quiz-header">
      <h1 class="question" id="question">What's your approach to wearing watches?</h1>
      <div class="question-counter" id="questionCounter">1/5</div>
    </div>

    <div class="options" id="options"></div>

    <div class="quiz-footer">
      <button class="btn-skip" id="skipBtn">Skip question</button>
    </div>

    <div id="quizResults"></div>
  </main>

  <script src="/Javascript/Recommendation.js"></script>
  
</body>
</html>
