<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/css/404.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <header>
        <a href="/" class="logo">VAULTIQUE</a>
    </header>
    
    <main class="error-container">
        <div class="watch-animation">
            <div class="watch-face">
                <div class="hour-hand"></div>
                <div class="minute-hand"></div>
            </div>
        </div>
        
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Time Seems to Have Stopped</h2>
        <p class="error-message">
            <%= message %>
        </p>
        
        <div class="btn-group">
            <a href="/" class="btn">
                <i class="fas fa-home"></i> Return Home
            </a>
            <a href="/collections" class="btn btn-secondary">
                <i class="fas fa-clock"></i> Browse Collections
            </a>
        </div>
    </main>
    
    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Vaultique Watches. All rights reserved.</p>
    </footer>
</body>
</html> 