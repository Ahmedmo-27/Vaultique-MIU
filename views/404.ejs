<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/CSS/404.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
</head>
<body>
    <header>
        <a href="/" class="logo" data-translate="logo">VAULTIQUE</a>
    </header>
    
    <main class="error-container">
        <div class="watch-animation">
            <div class="watch-face">
                <div class="hour-hand"></div>
                <div class="minute-hand"></div>
            </div>
        </div>
        
        <h1 class="error-code">404</h1>
        <h2 class="error-title" data-translate="404title">Time Seems to Have Stopped</h2>
        <p class="error-message" data-translate="404message">
            <%= message %>
        </p>
        
        <div class="btn-group">
            <a href="/" class="btn" data-translate="returnHome">
                <i class="fas fa-home"></i> Return Home
            </a>
            <a href="/collections" class="btn btn-secondary" data-translate="browseCollections">
                <i class="fas fa-clock"></i> Browse Collections
            </a>
        </div>
    </main>
    
    <footer>
        <p data-translate="copyright">&copy; <%= new Date().getFullYear() %> Vaultique Watches. All rights reserved.</p>
    </footer>
    <!-- ملفات الترجمة -->
<script src="/Javascript/translations.js"></script>
<script src="/Javascript/language.js"></script>
</body>
</html> 