<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Vaultique | <%= collection.name %></title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/CSS/Loading Screen.css">
        <link rel="stylesheet" href="/CSS/nav-bar.css">
        <link rel="stylesheet" href="/CSS/Slider.css">
        <link rel="stylesheet" href="/CSS/Products.css">
        <link rel="stylesheet" href="/CSS/footer.css">
        <link rel="stylesheet" href="/CSS/notifications.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <script src="/Javascript/Loading Screen.js"></script>
        <script src="/Javascript/nav-bar.js"></script>
        <script src="/Javascript/Page-Handler.js"></script>
        <script src="/Javascript/Slider.js"></script>
        <script src="/Javascript/Products.js"></script>
        <script src="/Javascript/Light-Mode.js"></script>
        <script src="/Javascript/notifications.js"></script>
        <script src="/Javascript/compare.js" defer></script>
    </head>
    <body>
        <%- include('partials/loading-screen') %>
        <%- include('partials/navigation') %>
        
        <!-- Hero Section -->
        <section class="section topic">
            <div class="video-container">
                <video autoplay muted loop playsinline>
                    <source src="<%= collection.heroVideo %>" id="brandVideoSource">
                </video>
            </div>
        </section>

        <!-- Collection Slider Section -->
        <div class="slider-container">
            <div class="slides-wrapper" id="slidesWrapper">
                <% if (collection.featuredItems && collection.featuredItems.length > 0) { %>
                    <% collection.featuredItems.forEach((model, index) => { %>
                        <div class="slide" data-index="<%= index %>" data-model="<%= index + 1 %>">
                            <div class="slide-content">
                                <div class="watch-info">
                                    <h1 class="watch-title"><%= model.name %></h1>
                                    <h2 class="watch-tagline"><%= model.tagline %></h2>
                                    <p class="watch-description"><%= model.description %></p>
                                </div>
                                <div class="watch-image-container">
                                    <img src="<%= model.image %>" alt="<%= model.name %>" class="watch-image" onerror="this.style.display='none'">
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Navigation Arrows -->
            <button id="prevSlide" class="nav-arrow nav-arrow-left" aria-label="Previous slide">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
            </button>
            <button id="nextSlide" class="nav-arrow nav-arrow-right" aria-label="Next slide">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
            </button>

            <!-- Pagination Dots -->
            <div class="pagination-slider" id="paginationSlider">
                <% if (collection.featuredItems && collection.featuredItems.length > 0) { %>
                    <% collection.featuredItems.forEach((_, index) => { %>
                        <button class="dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>" aria-label="Go to slide <%= index + 1 %>" <%= index === 0 ? 'aria-current="true"' : '' %>></button>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <!-- Collection Info Section -->
        <div class="image" style="margin-bottom: -90px;">
            <img src="<%= collection.coverImage %>" alt="Brand Image" id="brandCoverImage">
            <div class="brand-logo">
                <h1 id="brandLogo"><%= collection.name %></h1>
            </div>
            <div class="text-overlay">
                <h2 id="brandHeader"><%= collection.header %></h2>
                <p id="brandDescription"><%= collection.description %></p>
            </div>
        </div>

        <!-- Filter Button -->
        <button class="filter-btn" onclick="openFilterPanel()">
            <span>Filters and Sorting</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="12" y1="4" x2="12" y2="8" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="8" y1="10" x2="8" y2="14" />    
                <line x1="4" y1="18" x2="20" y2="18" />
                <line x1="16" y1="16" x2="16" y2="20" />
            </svg>
        </button>

        <!-- Filter Panel -->
        <div class="overlay" id="overlay" onclick="closeFilterPanel()"></div>
        <div class="filter-panel" id="filterPanel">
            <button class="close-btn" onclick="closeFilterPanel()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M18 6L6 18" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M6 6L18 18" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <div class="sort-options">
                <h3>Sort By</h3>
                <a href="javascript:void(0)" onclick="updateSort('default')" class="<%= sort === 'default' ? 'active' : '' %>">Default</a>
                <a href="javascript:void(0)" onclick="updateSort('new')" class="<%= sort === 'new' ? 'active' : '' %>">New</a>
                <a href="javascript:void(0)" onclick="updateSort('price-asc')" class="<%= sort === 'price-asc' ? 'active' : '' %>">Price ↑</a>
                <a href="javascript:void(0)" onclick="updateSort('price-desc')" class="<%= sort === 'price-desc' ? 'active' : '' %>">Price ↓</a>
                <a href="javascript:void(0)" onclick="updateSort('popularity')" class="<%= sort === 'popularity' ? 'active' : '' %>">Popularity</a>
            </div>

            <!-- Filters Form -->
            <form method="GET" action="/collections/<%= collection.slug %>" class="filters">
                <h3>Filters</h3>
                <input type="hidden" name="sort" value="<%= sort %>">
                <input type="hidden" name="page" value="1">

                <!-- Collection Filter -->
                <div class="filter-group">
                    <label>Collection:</label>
                    <select name="Vcollection" class="tag">
                        <option value="<%= collection.name %>" selected><%= collection.name %></option>
                    </select>
                </div>

                <!-- Brand Filter -->
                <div class="filter-group">
                    <label>Brand:</label>
                    <select name="brand" class="tag">
                        <option value="All" <%= filters.brand === 'All' ? 'selected' : '' %>>All</option>
                        <% brands.forEach(brand => { %>
                            <option value="<%= brand.name %>" <%= filters.brand === brand.name ? 'selected' : '' %>><%= brand.name %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Gender Filter -->
                <div class="filter-group">
                    <label>Gender:</label>
                    <select name="gender" class="tag">
                        <option value="All" <%= filters.gender === 'All' ? 'selected' : '' %>>All</option>
                        <option value="Male" <%= filters.gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= filters.gender === 'Female' ? 'selected' : '' %>>Female</option>
                        <option value="Unisex" <%= filters.gender === 'Unisex' ? 'selected' : '' %>>Unisex</option>
                    </select>
                </div>

                <!-- Strap Material Filter -->
                <div class="filter-group">
                    <label>Strap Material:</label>
                    <select name="strapMaterial" class="tag">
                        <option value="All" <%= filters.strapMaterial === 'All' ? 'selected' : '' %>>All</option>
                        <option value="Leather" <%= filters.strapMaterial === 'Leather' ? 'selected' : '' %>>Leather</option>
                        <option value="Metal" <%= filters.strapMaterial === 'Metal' ? 'selected' : '' %>>Metal</option>
                        <option value="Rubber" <%= filters.strapMaterial === 'Rubber' ? 'selected' : '' %>>Rubber</option>
                        <option value="Gold" <%= filters.strapMaterial === 'Gold' ? 'selected' : '' %>>Gold</option>
                        <option value="Rose Gold" <%= filters.strapMaterial === 'Rose Gold' ? 'selected' : '' %>>Rose Gold</option>
                        <option value="White Gold" <%= filters.strapMaterial === 'White Gold' ? 'selected' : '' %>>White Gold</option>
                        <option value="Else" <%= filters.strapMaterial === 'Else' ? 'selected' : '' %>>Else</option>
                    </select>
                </div>

                <!-- Movement Filter -->
                <div class="filter-group">
                    <label>Movement:</label>
                    <select name="movement" class="tag">
                        <option value="All" <%= filters.movement === 'All' ? 'selected' : '' %>>All</option>
                        <option value="Automatic" <%= filters.movement === 'Automatic' ? 'selected' : '' %>>Automatic</option>
                        <option value="Quartz" <%= filters.movement === 'Quartz' ? 'selected' : '' %>>Quartz</option>
                        <option value="Manual" <%= filters.movement === 'Manual' ? 'selected' : '' %>>Manual</option>
                    </select>
                </div>

                <!-- Water Resistance Filter -->
                <div class="filter-group">
                    <label>Water Resistance:</label>
                    <select name="waterResistance" class="tag">
                        <option value="All" <%= filters.waterResistance === 'All' ? 'selected' : '' %>>All</option>
                        <option value="30m" <%= filters.waterResistance === '30m' ? 'selected' : '' %>>30m</option>
                        <option value="50m" <%= filters.waterResistance === '50m' ? 'selected' : '' %>>50m</option>
                        <option value="100m" <%= filters.waterResistance === '100m' ? 'selected' : '' %>>100m</option>
                        <option value="200m" <%= filters.waterResistance === '200m' ? 'selected' : '' %>>200m</option>
                    </select>
                </div>

                <!-- Case Material Filter -->
                <div class="filter-group">
                    <label>Case Material:</label>
                    <select name="caseMaterial" class="tag">
                        <option value="All" <%= filters.caseMaterial === 'All' ? 'selected' : '' %>>All</option>
                        <option value="Stainless Steel" <%= filters.caseMaterial === 'Stainless Steel' ? 'selected' : '' %>>Stainless Steel</option>
                        <option value="Gold" <%= filters.caseMaterial === 'Gold' ? 'selected' : '' %>>Gold</option>
                        <option value="Rose Gold" <%= filters.caseMaterial === 'Rose Gold' ? 'selected' : '' %>>Rose Gold</option>
                        <option value="White Gold" <%= filters.caseMaterial === 'White Gold' ? 'selected' : '' %>>White Gold</option>
                        <option value="Silver" <%= filters.caseMaterial === 'Silver' ? 'selected' : '' %>>Silver</option>
                        <option value="Titanium" <%= filters.caseMaterial === 'Titanium' ? 'selected' : '' %>>Titanium</option>
                        <option value="Platinum" <%= filters.caseMaterial === 'Platinum' ? 'selected' : '' %>>Platinum</option>
                        <option value="Ceramic" <%= filters.caseMaterial === 'Ceramic' ? 'selected' : '' %>>Ceramic</option>
                        <option value="Else" <%= filters.caseMaterial === 'Else' ? 'selected' : '' %>>Else</option>
                    </select>
                </div>

                <!-- Price Range Filter -->
                <div class="filter-group price-range">
                    <h3>Price Range</h3>
                    <input type="number" name="minPrice" class="priceRangeValue" placeholder="From" value="<%= filters.minPrice || '' %>">
                    <input type="number" name="maxPrice" class="priceRangeValue" placeholder="To" value="<%= filters.maxPrice || '' %>">
                </div>

                <!-- Dial Color Filter -->
                <div class="filter-group">
                    <h3>Dial Color</h3>
                    <% const selectedColors = filters.dialColor ? filters.dialColor.split(',') : ['All']; %>
                    <label><input type="checkbox" name="dialColor" value="All" class="dial-color" <%= selectedColors.includes('All') ? 'checked' : '' %>> All</label>
                    <label><input type="checkbox" name="dialColor" value="Black" class="dial-color" <%= selectedColors.includes('Black') ? 'checked' : '' %>> Black</label>
                    <label><input type="checkbox" name="dialColor" value="Silver" class="dial-color" <%= selectedColors.includes('Silver') ? 'checked' : '' %>> Silver</label>
                    <label><input type="checkbox" name="dialColor" value="Gold" class="dial-color" <%= selectedColors.includes('Gold') ? 'checked' : '' %>> Gold</label>
                    <label><input type="checkbox" name="dialColor" value="Blue" class="dial-color" <%= selectedColors.includes('Blue') ? 'checked' : '' %>> Blue</label>
                    <label><input type="checkbox" name="dialColor" value="White" class="dial-color" <%= selectedColors.includes('White') ? 'checked' : '' %>> White</label>
                    <label><input type="checkbox" name="dialColor" value="Green" class="dial-color" <%= selectedColors.includes('Green') ? 'checked' : '' %>> Green</label>
                    <label><input type="checkbox" name="dialColor" value="Else" class="dial-color" <%= selectedColors.includes('Else') ? 'checked' : '' %>> Else</label>
                </div>

                <!-- Stock Filter -->
                <div class="filter-group stock-filter">
                    <label>
                        <input type="checkbox" name="inStock" id="inStockFilter" <%= filters.inStock ? 'checked' : '' %>> In Stock Only
                    </label>
                </div>

                <!-- Filter Actions -->
                <div class="filter-actions">
                    <button type="submit" class="submit">Apply Filters</button>
                    <a href="/collections/<%= collection.slug %>" class="clear">Clear All</a>
                </div>
            </form>
        </div>

        <!-- Product Grid -->
        <section class="product-container">
            <div class="product-grid" id="productGrid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach((product) => { %>
                        <div class="product-card">
                            <div class="product-image-container">
                                <div class="wishlist-icon" data-product-id="<%= product._id %>">
                                    <svg width="30" height="30" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path class="heart" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 .81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78 -3.4 6.86 -8.55 11.54L12 21.35z"/>
                                    </svg>
                                </div>
                                <a href="/products/<%= product._id %>">
                                    <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
                                </a>
                            </div>
                            <div class="product-details">
                                <a href="/products/<%= product._id %>">
                                    <h4><%= product.name %></h4>
                                </a>
                                <div class="hover-buttons">
                                    <button class="quick-view" data-product-id="<%= product._id %>">Quick View</button>
                                    <button class="compare" data-product-id="<%= product._id %>">Compare</button>
                                </div>
                                <p class="price">$<%= product.price.toLocaleString() %></p>
                                <% if (product.stock || (product.stockCount && product.stockCount > 0)) { %>
                                    <p class="stock in-stock">In Stock</p>
                                <% } else { %>
                                    <p class="stock out-of-stock">Out of Stock</p>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-products">
                        <p>No products found matching your criteria.</p>
                        <a href="/collections/<%= collection.slug %>" class="clear-filters">Clear Filters</a>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Pagination -->
        <div class="pagination">
            <% if (pagination.totalPages > 1) { %>
                <% if (pagination.currentPage > 1) { %>
                    <a href="?page=<%= pagination.currentPage - 1 %><%= Object.entries(filters).map(([key, value]) => `&${key}=${value}`).join('') %><%= sort ? `&sort=${sort}` : '' %>" class="page-link">Previous</a>
                <% } %>
                
                <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                    <a href="?page=<%= i %><%= Object.entries(filters).map(([key, value]) => `&${key}=${value}`).join('') %><%= sort ? `&sort=${sort}` : '' %>" 
                       class="page-link <%= pagination.currentPage === i ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
                
                <% if (pagination.currentPage < pagination.totalPages) { %>
                    <a href="?page=<%= pagination.currentPage + 1 %><%= Object.entries(filters).map(([key, value]) => `&${key}=${value}`).join('') %><%= sort ? `&sort=${sort}` : '' %>" class="page-link">Next</a>
                <% } %>
            <% } %>
        </div>

        <!-- Footer -->
        <%- include('partials/footer') %>
        <%- include('partials/notification') %>
    </body>

<script>
        function updateSort(sortValue) {
        document.querySelector('input[name="sort"]').value = sortValue;
        document.getElementById('filterForm').submit();
    }

    function clearFilters() {
        // Reset all form fields to their default values
        document.querySelectorAll('#filterForm select').forEach(select => {
            select.value = 'All';
        });
        document.querySelectorAll('#filterForm input[type="number"]').forEach(input => {
            input.value = input.placeholder === 'From' ? '0' : '500000';
        });
        document.querySelectorAll('#filterForm input[type="checkbox"]').forEach(checkbox => {
            checkbox.checked = checkbox.value === 'All';
        });
        document.querySelector('input[name="sort"]').value = 'default';
        document.querySelector('input[name="page"]').value = '1';
        document.getElementById('filterForm').submit();
    }

</script>

</html> 