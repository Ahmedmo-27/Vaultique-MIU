    <style>
      :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --secondary: #7c3aed;
        --accent: #ec4899;
        --bg: #f8fafc;
        --card-bg: #ffffff;
        --text: #1e293b;
        --text-light: #64748b;
        --border-radius: 16px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
        --shadow-lg: 0 10px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        --gap: 2rem;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* Typography */
    h1, h2, h3, h4 {
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: 2.5rem;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: inline-block;
    }

    h2 {
        font-size: 2rem;
        color: var(--text);
    }

    h3 {
        font-size: 1.5rem;
    }

    h4 {
        font-size: 1.2rem;
    }

    p {
        color: var(--text-light);
        margin-bottom: 1.5rem;
    }

    /* Header Section */
    .detector-header {
        text-align: center;
        margin-bottom: 4rem;
        position: relative;
    }

    .detector-header h1 {
        margin-bottom: 1.5rem;
        position: relative;
        display: inline-block;
    }

    .detector-header h1::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        border-radius: 2px;
    }

    .detector-header p {
        font-size: 1.1rem;
        max-width: 700px;
        margin: 0 auto 2rem;
    }

    /* Cards Grid */
    .detector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--gap);
        margin-bottom: 4rem;
    }

    .detector-card {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 2.5rem 2rem;
        text-align: center;
        transition: var(--transition);
        border: 1px solid rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }

    .detector-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg);
    }

    .detector-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
    }

    .detector-icon {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: inline-block;
    }

    .detector-card h3 {
        margin-bottom: 1.25rem;
        position: relative;
        padding-bottom: 0.75rem;
    }

    .detector-card h3::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 50px;
        height: 2px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        border-radius: 1px;
    }

    .detector-card p {
        font-size: 1rem;
        margin-bottom: 2rem;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.875rem 1.75rem;
        border-radius: 50px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--transition);
        border: none;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

    .btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        z-index: -1;
        transition: var(--transition);
        opacity: 1;
    }

    .btn:hover::before {
        opacity: 0.9;
        transform: scale(1.05);
    }

    .btn-primary {
        color: white;
    }

    .btn-secondary {
        background: white;
        color: var(--primary);
        border: 1px solid var(--primary);
    }

    .btn-secondary::before {
        background: white;
    }

    .btn-secondary:hover {
        color: white;
    }

    .btn-secondary:hover::before {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
    }

    .btn-icon {
        font-size: 1.1rem;
    }

    /* Features Section */
    .features-section {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 3rem 2rem;
        margin-bottom: 4rem;
        position: relative;
        overflow: hidden;
    }

    .features-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
    }

    .features-section h2 {
        text-align: center;
        margin-bottom: 3rem;
        position: relative;
    }

    .features-section h2::after {
        content: '';
        position: absolute;
        bottom: -12px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        border-radius: 2px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        padding: 1.5rem;
        background: rgba(37, 99, 235, 0.03);
        border-radius: var(--border-radius);
        transition: var(--transition);
        border: 1px solid rgba(0,0,0,0.03);
    }

    .feature-item:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-sm);
        background: rgba(37, 99, 235, 0.05);
    }

    .feature-icon {
        font-size: 1.75rem;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        flex-shrink: 0;
        margin-top: 0.25rem;
    }

    .feature-content h4 {
        margin-bottom: 0.75rem;
        color: var(--text);
    }

    .feature-content p {
        font-size: 0.95rem;
        color: var(--text-light);
    }

    /* Camera Section */
    .camera-section {
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 3rem 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .camera-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 8px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
    }

    .camera-section h2 {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .camera-section h2::after {
        content: '';
        position: absolute;
        bottom: -12px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        border-radius: 2px;
    }

    .camera-placeholder {
        width: 100%;
        max-width: 600px;
        height: 350px;
        background: #f1f5f9;
        border: 2px dashed #cbd5e1;
        border-radius: var(--border-radius);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 2.5rem auto;
        color: #94a3b8;
        font-size: 1.1rem;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

    .camera-placeholder:hover {
        border-color: var(--primary);
    }

    .camera-placeholder i {
        font-size: 3.5rem;
        margin-bottom: 1.5rem;
        color: #cbd5e1;
        transition: var(--transition);
    }

    .camera-placeholder:hover i {
        color: var(--primary);
    }

    .camera-placeholder p {
        max-width: 300px;
    }

    .camera-active {
        border: none;
        background: #000;
    }

    .camera-active i, .camera-active p {
        display: none;
    }

    #camera-feed {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .camera-controls {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    /* Loading Animation */
    .loading-spinner {
        display: none;
        width: 40px;
        height: 40px;
        border: 4px solid rgba(37, 99, 235, 0.2);
        border-radius: 50%;
        border-top-color: var(--primary);
        animation: spin 1s ease-in-out infinite;
        margin: 2rem auto;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Results Section */
    .results-section {
        display: none;
        background: var(--card-bg);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        padding: 3rem 2rem;
        margin-top: 3rem;
        text-align: center;
    }

    .results-section h2 {
        margin-bottom: 1.5rem;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .result-item {
        background: rgba(37, 99, 235, 0.03);
        padding: 1.5rem;
        border-radius: var(--border-radius);
    }

    .result-item h4 {
        color: var(--primary);
        margin-bottom: 0.5rem;
    }

    .result-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
    }

    .result-unit {
        font-size: 1rem;
        color: var(--text-light);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .container {
            padding: 1.5rem 1rem;
        }

        h1 {
            font-size: 2rem;
        }

        h2 {
            font-size: 1.75rem;
        }

        .detector-header {
            margin-bottom: 3rem;
        }

        .detector-card {
            padding: 2rem 1.5rem;
        }

        .features-section, .camera-section {
            padding: 2rem 1.5rem;
        }

        .camera-placeholder {
            height: 280px;
            margin: 1.5rem auto;
        }
    }

    @media (max-width: 480px) {
        .camera-controls {
            flex-direction: column;
            align-items: center;
        }

        .btn {
            width: 100%;
        }
    }

    /* Animation Classes */
    .fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .pulse {
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(37, 99, 235, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
    }
</style>
</head>

<body>
    <!-- Loading Screen -->
    <%- include('partials/loading-screen') %>
    <!-- Nav-Bar -->
    <%- include('partials/navigation') %>

    <div class="app" id="wrist-detector-app">
    <main class="main" id="main-content" role="main">
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <br>
        <div class="container">
            

            <div class="detector-grid">
                <div class="detector-card fade-in" style="animation-delay: 0.1s;">
                    <div class="detector-icon">
                        <i class="fas fa-ruler-combined"></i>
                    </div>
                    <h3 data-translate="sizeMeasurement">Precision Measurement</h3>
                    <p data-translate="sizeMeasurementDesc">Our computer vision technology measures your wrist with millimeter accuracy for the perfect fit.</p>
                    <button class="btn btn-primary" id="measure-btn">
