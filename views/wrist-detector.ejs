                    </div>
                    <h3 data-translate="watchRecommendation">Smart Recommendations</h3>
                    <p data-translate="watchRecommendationDesc">Get personalized watch suggestions based on your wrist size, style, and preferences.</p>
                    <button class="btn btn-primary" id="recommend-btn">
                        <i class="fas fa-magic btn-icon"></i>
                        <span data-translate="getRecommendations">Find Your Watch</span>
                    </button>
                </div>
            </div>

            <div class="features-section fade-in" style="animation-delay: 0.3s;">
                <h2 data-translate="featuresTitle">Why Choose Our Wrist Detector</h2>
                <div class="features-grid">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-bullseye"></i>
                        </div>
                        <div class="feature-content">
                            <h4 data-translate="cameraDetection">99% Accuracy</h4>
                            <p data-translate="cameraDetectionDesc">Industry-leading precision with our advanced measurement algorithms.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-clock"></i>
                        </div>
