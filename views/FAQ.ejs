<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title data-translate="faqTitle">Vaultique FAQ | Luxury Watch Questions & Support</title>
    <meta name="description" content="Find answers to frequently asked questions about Vaultique luxury watches. Learn about ordering, shipping, warranty, and customer support for Swiss timepieces.">
    <meta name="keywords" content="Vaultique FAQ, luxury watch questions, Swiss watch support, watch ordering, watch shipping, watch warranty, luxury watch customer service">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Vaultique FAQ | Luxury Watch Questions & Support">
    <meta property="og:description" content="Find answers to frequently asked questions about Vaultique luxury watches. Learn about ordering, shipping, warranty, and customer support.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/faq">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Vaultique FAQ | Luxury Watch Questions & Support">
    <meta name="twitter:description" content="Find answers to frequently asked questions about Vaultique luxury watches. Learn about ordering, shipping, warranty, and customer support.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/faq">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    
    <link rel="stylesheet" href="/CSS/FAQ.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "name": "Vaultique FAQ",
        "description": "Frequently asked questions about Vaultique luxury watches, ordering, shipping, and customer support",
        "url": "https://vaultique.live/faq",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "How do I place an order?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "To place an order, simply browse our collection, select your desired watch, customize it if desired, and click \"Add to Cart\". Follow the checkout process to complete your purchase."
                }
            },
            {
                "@type": "Question",
                "name": "What payment methods do you accept?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "We accept all major credit cards (Visa, MasterCard, American Express), PayPal, and bank transfers. All payments are processed securely through our encrypted payment system."
                }
            },
            {
                "@type": "Question",
                "name": "How long does shipping take?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Standard shipping typically takes 3-5 business days within the continental US. International shipping may take 7-14 business days depending on the destination."
                }
            },
            {
                "@type": "Question",
                "name": "Do you ship internationally?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes, we ship to most countries worldwide. International shipping rates and delivery times vary by location. You can view shipping options during checkout."
                }
            }
        ]
    }
    </script>
   
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <script src="/Javascript/FAQ.js"></script>
   
</head>
<body>
    <%- include('partials/loading-screen') %>
    <%- include('partials/navigation') %>
    <!-- Theme Toggle Button -->
   

    <main class="faq-container">
        <br>
        <br>
        <br>
        <br>
        <br>
        <h1 data-translate="faqHeader">Frequently Asked Questions</h1>
        
        <!-- Search Container -->
        <div class="search-container">
            <input type="text" id="faq-search" placeholder="Search FAQs..." data-translate="searchPlaceholder">
            <i class="fas fa-search"></i>
        </div>

        <!-- FAQ Categories -->
        <div class="faq-categories">
            <button class="category-btn active" data-category="all" data-translate="allCategories">All</button>
            <button class="category-btn" data-category="ordering" data-translate="ordering">Ordering</button>
            <button class="category-btn" data-category="shipping" data-translate="shipping">Shipping</button>
            <button class="category-btn" data-category="warranty" data-translate="warranty">Warranty</button>
            <button class="category-btn" data-category="returns" data-translate="returns">Returns</button>
        </div>

        <div class="faq-list">
            <!-- Ordering Questions -->
            <div class="faq-item" data-category="ordering">
                <div class="faq-question">
                    <h3 data-translate="faqQ1">How do I place an order?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA1">To place an order, simply browse our collection, select your desired watch, customize it if desired, and click "Add to Cart". Follow the checkout process to complete your purchase.</p>
                </div>
            </div>

            <div class="faq-item" data-category="ordering">
                <div class="faq-question">
                    <h3 data-translate="faqQ2">What payment methods do you accept?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA2">We accept all major credit cards (Visa, MasterCard, American Express), PayPal, and bank transfers. All payments are processed securely through our encrypted payment system.</p>
                </div>
            </div>

            <div class="faq-item" data-category="ordering">
                <div class="faq-question">
                    <h3 data-translate="faqQ3">Is my payment information secure?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA3">Absolutely. We use industry-standard SSL encryption to protect your payment information. We never store your full credit card details on our servers.</p>
                </div>
            </div>

            <div class="faq-item" data-category="ordering">
                <div class="faq-question">
                    <h3 data-translate="faqQ4">Do you offer installment plans?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA4">Yes, we offer flexible installment plans through our financing partners. At checkout, you can select the installment option and choose a payment plan that suits your budget.</p>
                </div>
            </div>

            <!-- Shipping Questions -->
            <div class="faq-item" data-category="shipping">
                <div class="faq-question">
                    <h3 data-translate="faqQ5">How long does shipping take?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA5">Standard shipping typically takes 3-5 business days within the continental US. International shipping may take 7-14 business days depending on the destination.</p>
                </div>
            </div>

            <div class="faq-item" data-category="shipping">
                <div class="faq-question">
                    <h3 data-translate="faqQ6">Do you ship internationally?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA6">Yes, we ship to most countries worldwide. International shipping rates and delivery times vary by location. You can view shipping options during checkout.</p>
                </div>
            </div>

            <div class="faq-item" data-category="shipping">
                <div class="faq-question">
                    <h3 data-translate="faqQ7">Is shipping insured?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA7">All shipments are fully insured against loss or damage during transit. You can shop with confidence knowing your purchase is protected from our facility to your doorstep.</p>
                </div>
            </div>

            <div class="faq-item" data-category="shipping">
                <div class="faq-question">
                    <h3 data-translate="faqQ8">Can I track my order?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA8">Yes, once your order ships, you'll receive a tracking number via email. You can use this number on our website or the carrier's website to monitor your package's journey.</p>
                </div>
            </div>

            <!-- Warranty Questions -->
            <div class="faq-item" data-category="warranty">
                <div class="faq-question">
                    <h3 data-translate="faqQ9">What is your warranty policy?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA9">All our watches come with a 5-year international warranty covering manufacturing defects. The warranty does not cover damage from accidents, misuse, or normal wear and tear.</p>
                </div>
            </div>

            <div class="faq-item" data-category="warranty">
                <div class="faq-question">
                    <h3 data-translate="faqQ10">Do your watches come with a warranty?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA10">Yes, every Vaultique watch comes with our comprehensive 5-year warranty. We also offer extended warranty options for collectors and enthusiasts.</p>
                </div>
            </div>

            <div class="faq-item" data-category="warranty">
                <div class="faq-question">
                    <h3 data-translate="faqQ11">How do I service my watch?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA11">We recommend professional servicing every 3-5 years. You can schedule service through our website, or visit one of our authorized service centers worldwide.</p>
                </div>
            </div>

            <div class="faq-item" data-category="warranty">
                <div class="faq-question">
                    <h3 data-translate="faqQ12">What if my watch needs repair?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA12">Contact our customer service team to initiate a repair request. Most repairs are completed within 2-4 weeks and covered under warranty if applicable.</p>
                </div>
            </div>

            <!-- Returns Questions -->
            <div class="faq-item" data-category="returns">
                <div class="faq-question">
                    <h3 data-translate="faqQ13">What is your return policy?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA13">We offer a 30-day return policy for all unworn watches in their original condition. Customized watches are not eligible for returns unless they arrive damaged or defective.</p>
                </div>
            </div>

            <div class="faq-item" data-category="returns">
                <div class="faq-question">
                    <h3 data-translate="faqQ14">How do I initiate a return?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA14">To initiate a return, contact our customer service team within 30 days of delivery. Include your order number and reason for return. We'll provide you with return shipping instructions.</p>
                </div>
            </div>

            <div class="faq-item" data-category="returns">
                <div class="faq-question">
                    <h3 data-translate="faqQ15">How long do refunds take to process?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA15">Once we receive your return, refunds are processed within 3-5 business days. It may take an additional 5-10 business days for the refund to appear on your original payment method.</p>
                </div>
            </div>

            <div class="faq-item" data-category="returns">
                <div class="faq-question">
                    <h3 data-translate="faqQ16">Do I have to pay return shipping?</h3>
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="faq-answer">
                    <p data-translate="faqA16">For returns due to our error or defective products, we cover return shipping. For other returns, customers are responsible for return shipping costs.</p>
                </div>
            </div>
        </div>
    </main>

    
        <%- include('partials/footer') %>
            <!-- ملفات الترجمة -->
<script src="/Javascript/translations.js"></script>
<script src="/Javascript/language.js"></script>
</body>
</html>