<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="/Javascript/Checkout_scripting.js" defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/CSS/Checkout_styles.css" />
  <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">

    <title data-translate="paymentTitle">Vaultique | Secure Checkout</title>
  </head>

  <body>
    <a href="/" class="logo" id="logo" data-translate="vaultique">Vaultique</a>
    <br />
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress"></div>
      </div>
      <div class="progress-steps">
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label" data-translate="payment">Payment</span>
        </div>
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label" data-translate="shipping">Shipping</span>
        </div>
        <div class="step active">
          <span class="circle"></span>
          <span class="label" data-translate="leaveReview">Leave a review!</span>
        </div>
      </div>
    </div>

    <div class="form-container">
      <h2 class="form-title" data-translate="shippingAddress">SHIPPING ADDRESS</h2>

      <% if (savedAddresses && savedAddresses.length > 0) { %>
        <div class="saved-addresses">
          <h3 data-translate="savedAddresses">Saved Addresses</h3>
          <% savedAddresses.forEach((address, index) => { %>
            <div class="saved-address">
              <input type="radio" name="addressType" id="address<%= index %>" value="<%= index %>" <%= index === 0 ? 'checked' : '' %>>
              <label for="address<%= index %>">
                <%= address.street %>, <%= address.city %>, <%= address.state %>, <%= address.postalCode %>
              </label>
            </div>
          <% }); %>
          <div class="saved-address">
            <input type="radio" name="addressType" id="newAddress" value="new">
            <label for="newAddress" data-translate="useNewAddress">Use a new address</label>
          </div>
        </div>
      <% } %>

      <form action="/user/shipping/process" class="checkout-form" method="post">
        <div class="input-line">
          <label for="name" data-translate="fullName">FULL NAME</label>
          <input
            type="text"
            name="fullName"
            id="name"
            placeholder="Your name and surname"
            value="<%= user ? user.Name : '' %>"
            <%= user && user.googleId ? 'readonly' : 'required' %>
          />
        </div>
        <div class="input-line">
          <label for="Email" data-translate="email">Email:</label>
          <input
            type="email"
            name="email"
            id="Email"
            placeholder="example@example.com"
            value="<%= user ? user.email : '' %>"
            <%= user && user.googleId ? 'readonly' : 'required' %>
          />
        </div>
        <div class="input-line">
          <label for="Address" data-translate="address">Full Address:</label>
          <input
            type="text"
            name="address"
            id="Address"
            placeholder="room-street-locality"
            value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].street : '' %>"
            required
          />
        </div>
        <div class="input-line">
          <label for="City" data-translate="city">City</label>
          <input
            type="text"
            name="city"
            id="City"
            placeholder="Cairo"
            value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].city : '' %>"
            required
          />
        </div>
        <div class="input-container">
          <div class="input-line">
            <label for="State" data-translate="state">State: </label>
            <input
              type="text"
              name="state"
              id="State"
              placeholder="California"
              value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].state : '' %>"
              required
            />
          </div>
          <div class="input-line">
            <label for="Zipcode" data-translate="postalCode">Postal Code: </label>
            <input
              type="text"
              name="zipCode"
              id="Zipcode"
              placeholder="123 456"
              value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].postalCode : '' %>"
              required
            />
          </div>
        </div>

        <% if (isAuthenticated) { %>
          <div class="input-line">
            <label class="checkbox-label" data-translate="saveAddress">Save this address for future orders</label>
          </div>
        <% } %>

        <% if (user && user.googleId) { %>
          <div class="google-user-notice">
            <i class="fas fa-info-circle"></i>
            <p data-translate="googleUserNotice">You're signed in with Google. Your information is pre-filled and secured.</p>
          </div>
        <% } %>

        <button type="submit" class="submit-btn" data-translate="completeOrder">Complete Order</button>
      </form>
    </div>

    <div class="login-message-popup" id="login-message-popup">
      <h2 data-translate="loginSuccess">Login Successful</h2>
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <div class="login-message-popup" id="login-message-error-popup">
      <h2></h2>
      <i class="fa-solid fa-circle-xmark" style="color: #d60000"></i>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const addressInputs = document.querySelectorAll('input[name="addressType"]');
        const formInputs = {
          address: document.getElementById('Address'),
          city: document.getElementById('City'),
          state: document.getElementById('State'),
          zipCode: document.getElementById('Zipcode')
        };

        // Parse saved addresses from the server
        const savedAddresses = JSON.parse('<%- JSON.stringify(savedAddresses || []) %>');

        function updateFormFields(addressIndex) {
          if (addressIndex === 'new') {
            // Clear form fields for new address
            Object.values(formInputs).forEach(input => {
              if (input) input.value = '';
            });
          } else {
            const address = savedAddresses[parseInt(addressIndex)];
            if (address) {
              formInputs.address.value = address.street || '';
              formInputs.city.value = address.city || '';
              formInputs.state.value = address.state || '';
              formInputs.zipCode.value = address.postalCode || '';
            }
          }
        }

        addressInputs.forEach(input => {
          input.addEventListener('change', (e) => {
            updateFormFields(e.target.value);
          });
        });

        // Handle form submission
        const form = document.querySelector('.checkout-form');
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          const formData = {
            fullName: document.getElementById('name').value,
            email: document.getElementById('Email').value,
            address: document.getElementById('Address').value,
            city: document.getElementById('City').value,
            state: document.getElementById('State').value,
            zipCode: document.getElementById('Zipcode').value,
            saveAddress: document.querySelector('input[name="saveAddress"]')?.checked || false
          };

          try {
            const response = await fetch('/user/shipping/process', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (data.success) {
              // Show success message
              const successPopup = document.getElementById('login-message-popup');
              successPopup.querySelector('h2').textContent = 'Order Created Successfully!';
              successPopup.style.display = 'flex';
              
              // Redirect after 2 seconds
              setTimeout(() => {
                window.location.href = data.redirect;
              }, 2000);
            } else {
              // Show error message
              const errorPopup = document.getElementById('login-message-error-popup');
              errorPopup.querySelector('h2').textContent = 'An error occurred. Please login to continue.';
              errorPopup.style.display = 'flex';
              
              // Hide error message after 3 seconds
              setTimeout(() => {
                errorPopup.style.display = 'none';
              }, 3000);
            }
          } catch (error) {
            console.error('Error submitting form:', error);
            const errorPopup = document.getElementById('login-message-error-popup');
            errorPopup.querySelector('h2').textContent = 'An error occurred. Please try again.';
            errorPopup.style.display = 'flex';
            
            // Hide error message after 3 seconds
            setTimeout(() => {
              errorPopup.style.display = 'none';
            }, 3000);
          }
        });
      });
    </script>
                  <!-- ملفات الترجمة -->
  <script src="/Javascript/translations.js"></script>
  <script src="/Javascript/language.js"></script>
  </body>
</html>
