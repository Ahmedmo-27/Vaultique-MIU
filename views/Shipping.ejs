<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/Javascript/Checkout_scripting.js" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/CSS/Checkout_styles.css" />
    <link rel="icon" type="image /x-icon" href="/images/logo.ico" />

    <title>Vaultique | Secure Checkout</title>
  </head>

  <body>
    <a href="/" class="logo" id="logo">Vaultique</a>
    <br />
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress"></div>
      </div>
      <div class="progress-steps">
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Payment</span>
        </div>
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Shipping</span>
        </div>
        <div class="step active">
          <span class="circle"></span>
          <span class="label">Leave a review!</span>
        </div>
      </div>
    </div>

    <div class="container hidden">
      <div class="card-container">
        <div class="front">
          <div class="image">
            <img src="../images/Checkout/chip.png" alt="" />
            <img src="../images/Checkout/visa.png" alt="" />
          </div>
          <div class="card-number-box">################</div>
          <div class="flexbox">
            <div class="box">
              <span>CARD HOLDER</span>
              <div class="card-holder-name">FULL NAME</div>
            </div>
            <div class="box">
              <span>EXPIRES</span>
              <div class="expiration">
                <span class="exp-month">MM</span>
                <span class="exp-year">YY</span>
              </div>
            </div>
          </div>
        </div>

        <div class="back">
          <div class="stripe"></div>
          <div class="box">
            <span>cvv</span>
            <div class="cvv-box"></div>
            <img src="../images/Checkout/visa.png" alt="" />
          </div>
        </div>
      </div>

      <form action="" class="payment-form">
        <div class="inputBox">
          <span>CARD NUMBER</span>
          <input type="text" maxlength="19" class="card-number-input" />
          <p class="card-length-message"></p>
        </div>
        <div class="inputBox">
          <span>CARD HOLDER</span>
          <input type="text" class="card-holder-input" />
          <p class="error-message"></p>
        </div>
        <div class="flexbox">
          <div class="inputBox">
            <span>EXPIRATION MM</span>
            <select name="" id="" class="month-input">
              <option value="month" select disabled>month</option>
              <option value="01">01</option>
              <option value="02">02</option>
              <option value="03">03</option>
              <option value="04">04</option>
              <option value="05">05</option>
              <option value="06">06</option>
              <option value="07">07</option>
              <option value="08">08</option>
              <option value="09">09</option>
              <option value="10">10</option>
              <option value="11">11</option>
              <option value="12">12</option>
            </select>
          </div>
          <div class="inputBox">
            <span>EXPIRATION YY</span>
            <select name="" id="" class="year-input">
              <option value="month" select disabled>year</option>
              <option value="01">2021</option>
              <option value="2022">2022</option>
              <option value="2023">2023</option>
              <option value="2024">2024</option>
              <option value="2025">2025</option>
              <option value="2026">2026</option>
              <option value="2027">2027</option>
              <option value="2028">2028</option>
              <option value="2029">2029</option>
              <option value="2030">2030</option>
            </select>
          </div>
          <div class="inputBox">
            <span>cvv</span>
            <input type="text" maxlength="4" class="cvv-input" />
            <p class="error-message"></p>
          </div>
        </div>
        <input
          type="submit"
          value="PAY EGP 0"
          class="submit-btn"
          id="final-checkout-btn"
          onclick="handlePaymentFormSubmission()"
        />
        <input
          value="Back"
          class="submit-btn"
          onclick="window.history.back()"
        />
      </form>
    </div>

    <div class="form-container">
      <h2 class="form-title">BILLING ADDRESS</h2>

      <% if (savedAddresses && savedAddresses.length > 0) { %>
        <div class="saved-addresses">
          <h3>Saved Addresses</h3>
          <% savedAddresses.forEach((address, index) => { %>
            <div class="saved-address">
              <input type="radio" name="addressType" id="address<%= index %>" value="<%= index %>" <%= index === 0 ? 'checked' : '' %>>
              <label for="address<%= index %>">
                <%= address.street %>, <%= address.city %>, <%= address.state %>, <%= address.postalCode %>
              </label>
            </div>
          <% }); %>
          <div class="saved-address">
            <input type="radio" name="addressType" id="newAddress" value="new">
            <label for="newAddress">Use a new address</label>
          </div>
        </div>
      <% } %>

      <form action="/user/shipping/submit" class="checkout-form" method="post">
        <div class="input-line">
          <label for="name">FULL NAME</label>
          <input
            type="text"
            name="fullName"
            id="name"
            placeholder="Your name and surname"
            value="<%= user ? user.Name : '' %>"
            required
          />
        </div>
        <div class="input-line">
          <label for="Email">Email:</label>
          <input
            type="email"
            name="email"
            id="Email"
            placeholder="example@example.com"
            value="<%= user ? user.email : '' %>"
            required
          />
        </div>
        <div class="input-line">
          <label for="Address">Full Address:</label>
          <input
            type="text"
            name="address"
            id="Address"
            placeholder="room-street-locality"
            value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].street : '' %>"
            required
          />
        </div>
        <div class="input-line">
          <label for="City">City</label>
          <input
            type="text"
            name="city"
            id="City"
            placeholder="Cairo"
            value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].city : '' %>"
            required
          />
        </div>
        <div class="input-container">
          <div class="input-line">
            <label for="State">State: </label>
            <input
              type="text"
              name="state"
              id="State"
              placeholder="California"
              value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].state : '' %>"
              required
            />
          </div>
          <div class="input-line">
            <label for="Zipcode">Postal Code: </label>
            <input
              type="text"
              name="zipCode"
              id="Zipcode"
              placeholder="123 456"
              value="<%= savedAddresses && savedAddresses[0] ? savedAddresses[0].postalCode : '' %>"
              required
            />
          </div>
        </div>

        <% if (isAuthenticated) { %>
          <div class="input-line">
            <label class="checkbox-label">
              <input type="checkbox" name="saveAddress" value="true">
              Save this address for future orders
            </label>
          </div>
        <% } %>

        <button type="submit" class="submit-btn">Continue to Review</button>
      </form>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const addressInputs = document.querySelectorAll('input[name="addressType"]');
        const formInputs = {
          address: document.getElementById('Address'),
          city: document.getElementById('City'),
          state: document.getElementById('State'),
          zipCode: document.getElementById('Zipcode')
        };

        // Parse saved addresses from the server
        const savedAddresses = JSON.stringify(savedAddresses || []) ;

        function updateFormFields(addressIndex) {
          if (addressIndex === 'new') {
            // Clear form fields for new address
            Object.values(formInputs).forEach(input => {
              if (input) input.value = '';
            });
          } else {
            const address = savedAddresses[parseInt(addressIndex)];
            if (address) {
              formInputs.address.value = address.street || '';
              formInputs.city.value = address.city || '';
              formInputs.state.value = address.state || '';
              formInputs.zipCode.value = address.postalCode || '';
            }
          }
        }

        addressInputs.forEach(input => {
          input.addEventListener('change', (e) => {
            updateFormFields(e.target.value);
          });
        });

        // Handle form submission
        const form = document.querySelector('.checkout-form');
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          
          const formData = {
            fullName: document.getElementById('name').value,
            email: document.getElementById('Email').value,
            address: document.getElementById('Address').value,
            city: document.getElementById('City').value,
            state: document.getElementById('State').value,
            zipCode: document.getElementById('Zipcode').value,
            saveAddress: document.querySelector('input[name="saveAddress"]')?.checked || false
          };

          // Submit the form
          this.submit();
        });
      });
    </script>
  </body>
  <div class="login-message-popup" id="login-message-popup">
    <h2>Login Successful</h2>
    <i class="fa-solid fa-circle-check"></i>
  </div>
  <div class="login-message-popup" id="login-message-error-popup">
    <h2></h2>
    <i class="fa-solid fa-circle-xmark" style="color: #d60000"></i>
  </div>
</html>
