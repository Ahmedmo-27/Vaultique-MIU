<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdminHub</title>
    <!-- Boxicons -->
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css">
    <link rel="stylesheet" href="/CSS/AdminHubHomePage.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <script src="/Javascript/nav-bar.js"></script>
</head>

<body>
    <%- include('partials/Admin-navigation') %>
    
    <!-- CONTENT -->
    <section id="content">
        <!-- MAIN -->
        <main>
            <div class="head-title">
                <div class="left">
                    <h1>Dashboard</h1>
                    <ul class="breadcrumb">
                        <li><a href="#">Dashboard</a></li>
                        <li><i class='bx bx-chevron-right'></i></li>
                        <li><span class="active">Home</span></li>
                    </ul>
                </div>
            </div>

            <ul class="box-info">
                <li>
                    <i class='bx bxs-calendar-check'></i>
                    <span class="text">
                        <h3><%= totalOrders || 0 %></h3>
                        <p>New Orders</p>
                    </span>
                </li>
                <li>
                    <i class='bx bxs-group'></i>
                    <span class="text">
                        <h3><%= totalUsers || 0 %></h3>
                        <p>Visitors</p>
                    </span>
                </li>
                <li>
                    <i class='bx bxs-dollar-circle'></i>
                    <span class="text">
                        <h3>$<%= totalSales ? totalSales.toFixed(2) : '0.00' %></h3>
                        <p>Total Sales</p>
                    </span>
                </li>
            </ul>

            <div class="table-data">
                <div class="order">
                    <div class="head">
                        <h3>Recent Orders</h3>
                        <i class='bx bx-search'></i>
                        <i class='bx bx-filter'></i>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Date Order</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentOrders && recentOrders.length > 0) { %>
                                <% recentOrders.forEach(order => { %>
                                    <tr>
                                        <td><%= order.userName %></td>
                                        <td><%= new Date(order.dateOrder).toLocaleDateString() %></td>
                                        <td>
                                            <span class="status <%= order.status.toLowerCase() %>">
                                                <%= order.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3">No recent orders</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <div class="todo">
                    <div class="head">
                        <h3>Todos</h3>
                        <i class='bx bx-plus'></i>
                        <i class='bx bx-filter'></i>
                    </div>
                    <ul class="todo-list">
                        <% if (todos && todos.length > 0) { %>
                            <% todos.forEach(todo => { %>
                                <li class="<%= todo.completed ? 'completed' : '' %>">
                                    <p><%= todo.text %></p>
                                    <i class='bx bx-dots-vertical-rounded'></i>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li>No todos available</li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </main>
        <!-- MAIN -->
    </section>
    <!-- CONTENT -->

    <script src="/Javascript/AdminHub.js"></script>
</body>

</html>