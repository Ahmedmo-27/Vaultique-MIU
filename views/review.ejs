<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/CSS/Checkout_styles.css" />
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <title>Vaultique | Order Review</title>
  </head>
  <body>
    <a href="/" class="logo" id="logo">Vaultique</a>
    <br />
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress"></div>
      </div>
      <div class="progress-steps">
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Payment</span>
        </div>
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Shipping</span>
        </div>
        <div class="step active">
          <span class="circle"></span>
          <span class="label">Review Order</span>
        </div>
      </div>
    </div>

    <div class="form-container">
      <h2 class="form-title">Review Your Order</h2>

      <% if (typeof order === 'undefined' || !order) { %>
        <div class="error-message">
          <h3>No Order Information Found</h3>
          <p>Please complete the shipping process first.</p>
          <a href="/user/shipping" class="back-link">← Back to Shipping</a>
        </div>
      <% } else { %>
        <!-- Order Summary -->
        <div class="order-summary">
          <h3>Order Summary</h3>
          <div class="order-items">
            <% if (order.items && order.items.length > 0) { %>
              <% order.items.forEach(item => { %>
                <div class="order-item">
                  <img src="<%= item.productId?.image || '/Assets/Images/default-product.jpg' %>" 
                       alt="<%= item.productId?.name || 'Product' %>" 
                       class="item-image">
                  <div class="item-details">
                    <h4><%= item.productId?.name || 'Unknown Product' %></h4>
                    <p>Quantity: <%= item.quantity || 0 %></p>
                    <p>Price: $<%= (item.price || 0).toFixed(2) %></p>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <p class="no-items">No items in order</p>
            <% } %>
          </div>
          <div class="order-totals">
            <div class="total-line">
              <span>Subtotal:</span>
              <span>$<%= (orderSummary?.subtotal || 0).toFixed(2) %></span>
            </div>
            <div class="total-line">
              <span>Shipping:</span>
              <span>$<%= (orderSummary?.shippingCost || 0).toFixed(2) %></span>
            </div>
            <div class="total-line grand-total">
              <span>Total:</span>
              <span>$<%= (orderSummary?.total || 0).toFixed(2) %></span>
            </div>
          </div>
        </div>

        <!-- Shipping Information -->
        <div class="shipping-info">
          <h3>Shipping Information</h3>
          <% if (order.shipping) { %>
            <p><strong>Name:</strong> <%= order.shipping.name || 'Not provided' %></p>
            <p><strong>Email:</strong> <%= order.shipping.email || 'Not provided' %></p>
            <p><strong>Address:</strong> <%= order.shipping.address || 'Not provided' %></p>
            <p><strong>City:</strong> <%= order.shipping.city || 'Not provided' %></p>
            <p><strong>State:</strong> <%= order.shipping.state || 'Not provided' %></p>
            <p><strong>Postal Code:</strong> <%= order.shipping.zipCode || 'Not provided' %></p>
          <% } else { %>
            <p>No shipping information available</p>
          <% } %>
        </div>

        <!-- Payment Information -->
        <div class="payment-info">
          <h3>Payment Information</h3>
          <% if (order.payment) { %>
            <p><strong>Card Holder:</strong> <%= order.payment.name || 'Not provided' %></p>
            <p><strong>Card Number:</strong> **** **** **** <%= order.payment.cardNumber || '****' %></p>
            <p><strong>Bank:</strong> <%= order.payment.bankName || 'Not provided' %></p>
            <p><strong>Expiry Date:</strong> <%= order.payment.expiry || 'Not provided' %></p>
          <% } else { %>
            <p>No payment information available</p>
          <% } %>
        </div>

        <!-- Order Confirmation -->
        <div class="order-confirmation">
          <form id="order-confirmation-form">
            <button type="submit" class="submit-btn">Place Order</button>
          </form>
          <a href="/user/shipping" class="back-link">← Back to Shipping</a>
        </div>
      <% } %>
    </div>

    <div class="login-message-popup" id="login-message-popup">
      <h2>Order Confirmed!</h2>
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <div class="login-message-popup" id="login-message-error-popup">
      <h2></h2>
      <i class="fa-solid fa-circle-xmark" style="color: #d60000"></i>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('order-confirmation-form');
        if (!form) return; // Exit if form doesn't exist (no order data)
        
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          // Disable submit button to prevent double submission
          const submitBtn = form.querySelector('button[type="submit"]');
          submitBtn.disabled = true;
          submitBtn.textContent = 'Processing...';
          
          try {
            const response = await fetch('/user/order-confirmation', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              }
            });

            const data = await response.json();

            if (data.success) {
              // Show success message
              const successPopup = document.getElementById('login-message-popup');
              successPopup.style.display = 'flex';
              
              // Redirect after 2 seconds
              setTimeout(() => {
                window.location.href = data.redirect;
              }, 2000);
            } else {
              // Show error message
              const errorPopup = document.getElementById('login-message-error-popup');
              errorPopup.querySelector('h2').textContent = data.message || 'An error occurred';
              errorPopup.style.display = 'flex';
              
              // Re-enable submit button
              submitBtn.disabled = false;
              submitBtn.textContent = 'Place Order';
              
              // Hide error message after 3 seconds
              setTimeout(() => {
                errorPopup.style.display = 'none';
              }, 3000);
            }
          } catch (error) {
            console.error('Error confirming order:', error);
            const errorPopup = document.getElementById('login-message-error-popup');
            errorPopup.querySelector('h2').textContent = 'An error occurred. Please try again.';
            errorPopup.style.display = 'flex';
            
            // Re-enable submit button
            submitBtn.disabled = false;
            submitBtn.textContent = 'Place Order';
            
            // Hide error message after 3 seconds
            setTimeout(() => {
              errorPopup.style.display = 'none';
            }, 3000);
          }
        });
      });
    </script>

    <style>
      .error-message {
        text-align: center;
        padding: 2rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        margin: 2rem 0;
      }

      .error-message h3 {
        color: #dc3545;
        margin-bottom: 1rem;
      }

      .error-message p {
        color: #6c757d;
        margin-bottom: 1.5rem;
      }

      .order-summary {
        margin-bottom: 2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
      }

      .order-items {
        margin: 1rem 0;
      }

      .order-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid #dee2e6;
      }

      .item-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        margin-right: 1rem;
        border-radius: 4px;
      }

      .item-details h4 {
        margin: 0 0 0.5rem 0;
      }

      .item-details p {
        margin: 0.25rem 0;
        color: #6c757d;
      }

      .order-totals {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #dee2e6;
      }

      .total-line {
        display: flex;
        justify-content: space-between;
        margin: 0.5rem 0;
      }

      .grand-total {
        font-weight: bold;
        font-size: 1.2rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #dee2e6;
      }

      .shipping-info,
      .payment-info {
        margin-bottom: 2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
      }

      .shipping-info p,
      .payment-info p {
        margin: 0.5rem 0;
      }

      .order-confirmation {
        margin-top: 2rem;
        text-align: center;
      }

      .back-link {
        display: inline-block;
        margin-top: 1rem;
        color: #6c757d;
        text-decoration: none;
      }

      .back-link:hover {
        color: #495057;
      }

      .submit-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }

      .no-items {
        text-align: center;
        color: #6c757d;
        padding: 1rem;
      }
    </style>
  </body>
</html> 