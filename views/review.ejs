<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/CSS/Checkout_styles.css" />
    <link rel="icon" type="image/x-icon" href="/images/logo.ico" />
    <title>Vaultique | Order Review</title>
  </head>
  <body>
    <a href="/" class="logo" id="logo">Vaultique</a>
    <br />
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress"></div>
      </div>
      <div class="progress-steps">
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Payment</span>
        </div>
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Shipping</span>
        </div>
        <div class="step active">
          <span class="circle"></span>
          <span class="label">Review Order</span>
        </div>
      </div>
    </div>

    <div class="form-container">
      <h2 class="form-title">Review Your Order</h2>

      <!-- Order Summary -->
      <div class="order-summary">
        <h3>Order Summary</h3>
        <div class="order-items">
          <% order.items.forEach(item => { %>
            <div class="order-item">
              <img src="<%= item.productId.image %>" alt="<%= item.productId.name %>" class="item-image">
              <div class="item-details">
                <h4><%= item.productId.name %></h4>
                <p>Quantity: <%= item.quantity %></p>
                <p>Price: $<%= item.price.toFixed(2) %></p>
              </div>
            </div>
          <% }); %>
        </div>
        <div class="order-totals">
          <div class="total-line">
            <span>Subtotal:</span>
            <span>$<%= orderSummary.subtotal.toFixed(2) %></span>
          </div>
          <div class="total-line">
            <span>Shipping:</span>
            <span>$<%= orderSummary.shippingCost.toFixed(2) %></span>
          </div>
          <div class="total-line grand-total">
            <span>Total:</span>
            <span>$<%= orderSummary.total.toFixed(2) %></span>
          </div>
        </div>
      </div>

      <!-- Shipping Information -->
      <div class="shipping-info">
        <h3>Shipping Information</h3>
        <p><strong>Name:</strong> <%= order.shipping.name %></p>
        <p><strong>Email:</strong> <%= order.shipping.email %></p>
        <p><strong>Address:</strong> <%= order.shipping.address %></p>
        <p><strong>City:</strong> <%= order.shipping.city %></p>
        <p><strong>State:</strong> <%= order.shipping.state %></p>
        <p><strong>Postal Code:</strong> <%= order.shipping.zipCode %></p>
      </div>

      <!-- Payment Information -->
      <div class="payment-info">
        <h3>Payment Information</h3>
        <p><strong>Card Holder:</strong> <%= order.payment.name %></p>
        <p><strong>Card Number:</strong> **** **** **** <%= order.payment.cardNumber %></p>
        <p><strong>Bank:</strong> <%= order.payment.bankName %></p>
        <p><strong>Expiry Date:</strong> <%= order.payment.expiry %></p>
      </div>

      <!-- Order Confirmation -->
      <div class="order-confirmation">
        <form action="/user/order-confirmation" method="post">
          <button type="submit" class="submit-btn">Place Order</button>
        </form>
        <a href="/user/shipping" class="back-link">← Back to Shipping</a>
      </div>
    </div>

    <style>
      .order-summary {
        margin-bottom: 2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
      }

      .order-items {
        margin: 1rem 0;
      }

      .order-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid #dee2e6;
      }

      .item-image {
        width: 80px;
        height: 80px;
        object-fit: cover;
        margin-right: 1rem;
        border-radius: 4px;
      }

      .item-details h4 {
        margin: 0 0 0.5rem 0;
      }

      .item-details p {
        margin: 0.25rem 0;
        color: #6c757d;
      }

      .order-totals {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #dee2e6;
      }

      .total-line {
        display: flex;
        justify-content: space-between;
        margin: 0.5rem 0;
      }

      .grand-total {
        font-weight: bold;
        font-size: 1.2rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #dee2e6;
      }

      .shipping-info,
      .payment-info {
        margin-bottom: 2rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
      }

      .shipping-info p,
      .payment-info p {
        margin: 0.5rem 0;
      }

      .order-confirmation {
        margin-top: 2rem;
        text-align: center;
      }

      .back-link {
        display: inline-block;
        margin-top: 1rem;
        color: #6c757d;
        text-decoration: none;
      }

      .back-link:hover {
        color: #495057;
      }
    </style>
  </body>
</html> 