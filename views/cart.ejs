<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    
    <!-- SEO Meta Tags -->
    <title data-translate="cartTitle">Vaultique | Shopping Cart - Luxury Swiss Watches</title>
    <meta name="description" content="View and manage your shopping cart at Vaultique. Secure checkout for luxury Swiss watches, limited editions, and bespoke timepieces. Enjoy exclusive craftsmanship and premium service.">
    <meta name="keywords" content="shopping cart, luxury watches, Swiss watches, checkout, premium timepieces, Vaultique cart">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="noindex, nofollow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Vaultique | Shopping Cart - Luxury Swiss Watches">
    <meta property="og:description" content="View and manage your shopping cart at Vaultique. Secure checkout for luxury Swiss watches, limited editions, and bespoke timepieces.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/user/cart">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Vaultique | Shopping Cart - Luxury Swiss Watches">
    <meta name="twitter:description" content="View and manage your shopping cart at Vaultique. Secure checkout for luxury Swiss watches, limited editions, and bespoke timepieces.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/user/cart">
    
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/CSS/cart (2).css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/notifications.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Vaultique Shopping Cart",
        "description": "View and manage your shopping cart at Vaultique. Secure checkout for luxury Swiss watches, limited editions, and bespoke timepieces.",
        "url": "https://vaultique.live/user/cart"
    }
    </script>
    
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/cart (2).js"></script>
    <script src="/Javascript/notifications.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
</head>
<body>
    <%- include('partials/loading-screen') %>
    <%- include('partials/navigation') %>

    <main class="main-content">
        <div class="container">
            <div class="cart-section">
                <h2 data-translate="shoppingCart">Shopping Cart</h2>
                
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <i class="fas fa-exclamation-circle"></i>
                        <p><%= error %></p>
                    </div>
                <% } %>

                <div class="cart-items">
                    <% if (cart && cart.items && cart.items.length > 0) { %>
                        <% cart.items.forEach(item => { %>
                            <div class="cart-item" data-product-id="<%= item.product || item.productId %>">
                                <img src="<%= item.image %>" alt="<%= item.name %>">
                                <div class="item-details">
                                    <h3 class="product-name"><%= item.name %></h3>
                                    <p class="item-price">$<%= (item.price || 0).toFixed(2) %></p>
                                </div>
                                <div class="quantity-controls">
                                    <button class="decrease" data-product-id="<%= item.product || item.productId %>" data-action="decrease">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <span class="quantity-display"><%= item.quantity %></span>
                                    <button class="increase" data-product-id="<%= item.product || item.productId %>" data-action="increase">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                                <div class="item-total">
                                    $<%= ((item.price || 0) * item.quantity).toFixed(2) %>
                                </div>
                                <button class="remove-item" onclick="removeItem('<%= item.product || item.productId %>')">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-cart">
                            <i class="fas fa-shopping-cart"></i>
                            <p data-translate="cartEmpty">Your cart is empty. Add items to your cart to see them here.</p>
                            <a href="/user/products" class="continue-shopping" data-translate="continueShopping">Continue Shopping</a>
                        </div>
                    <% } %>
                </div>

                <% if (cart && cart.items && cart.items.length > 0) { %>
                    <div class="cart-summary">
                        <div class="summary-section">
                            <h3 data-translate="cartSummary">Cart Summary</h3>
                            <div class="summary-item">
                                <span data-translate="items">Items (<%= cart.items.reduce(function(sum, item) { return sum + item.quantity; }, 0) %>)</span>
                                <span>$<%= cart.subtotal.toFixed(2) %></span>
                            </div>
                            <div class="summary-item">
                                <span data-translate="shipping">Shipping</span>
                                <select id="shipping" class="shipping-method">
                                    <option value="standard" <%= cart.shippingMethod === 'standard' ? 'selected' : '' %> data-translate="standardShipping">Standard ($20)</option>
                                    <option value="fast" <%= cart.shippingMethod === 'fast' ? 'selected' : '' %> data-translate="fastShipping">Fast ($40)</option>
                                </select>
                                <span>$<%= cart.shippingCost.toFixed(2) %></span>
                            </div>
                            <div class="summary-item total">
                                <span data-translate="total">Total</span>
                                <span>$<%= cart.total.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>

                    <div class="cart-actions">
                        <button class="btn clear-cart" onclick="clearCart()" data-translate="clearCart">
                            <i class="fas fa-trash"></i> Clear Cart
                        </button>
                        <a href="/user/shipping" class="btn checkout-btn" data-translate="proceedToCheckout">
                            <i class="fas fa-lock"></i> Proceed to Checkout
                        </a>
                        <a href="/products" class="btn continue-shopping-btn" data-translate="continueShopping">
                            <i class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/notification') %>
    <!-- ملفات الترجمة -->
<script src="/Javascript/translations.js"></script>
<script src="/Javascript/language.js"></script>
</body>
</html>