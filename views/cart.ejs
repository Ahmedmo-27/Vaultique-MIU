<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Vaultique | Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/CSS/cart (2).css">
</head>
<body>
    <div class="header">Vaultique</div>
    <div class="container">
        <div class="cart-section">
            <h2>Shopping Cart</h2>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-circle"></i>
                    <p><%= error %></p>
                </div>
            <% } %>

            <% if (cart && cart.items && cart.items.length > 0) { %>
                <div class="cart-items">
                    <% for (var i = 0; i < cart.items.length; i++) { 
                        var item = cart.items[i];
                        var productId = item.product ? item.product : (item.productId ? item.productId : '');
                        var image = item.image ? item.image : '/images/default-product.jpg';
                        var newQuantity = item.quantity + 1;
                        var prevQuantity = item.quantity - 1;
                    %>
                        <div class="cart-item" data-product-id="<%= productId %>">
                            <img src="<%= image %>" alt="<%= item.name %>">
                            <div class="item-details">
                                <h3 class="product-name"><%= item.name %></h3>
                                <p class="item-price">$<%= (item.price || 0).toFixed(2) %></p>
                            </div>
                            <div class="quantity-controls">
                                <button class="decrease" data-product-id="<%= productId %>" data-action="decrease">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <span class="quantity-display"><%= item.quantity %></span>
                                <button class="increase" data-product-id="<%= productId %>" data-action="increase">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <div class="item-total">
                                $<%= ((item.price || 0) * item.quantity).toFixed(2) %>
                            </div>
                            <button class="remove-item" onclick="removeItem('<%= productId %>')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    <% } %>
                </div>

                <div class="cart-summary">
                    <div class="summary-section">
                        <h3>Cart Summary</h3>
                        <div class="summary-item">
                            <span>Items (<%= cart.items.reduce(function(sum, item) { return sum + item.quantity; }, 0) %>)</span>
                            <span>$<%= cart.subtotal.toFixed(2) %></span>
                        </div>
                        <div class="summary-item">
                            <span>Shipping</span>
                            <span>$<%= cart.shippingCost.toFixed(2) %></span>
                        </div>
                        <div class="summary-item total">
                            <span>Total</span>
                            <span>$<%= cart.total.toFixed(2) %></span>
                        </div>
                    </div>
                </div>

                <div class="cart-actions">
                    <button class="btn clear-cart" onclick="clearCart()">
                        <i class="fas fa-trash"></i> Clear Cart
                    </button>
                    <a href="/user/payment" class="btn checkout-btn">
                        <i class="fas fa-lock"></i> Proceed to Checkout
                    </a>
                    <a href="/products" class="btn continue-shopping-btn">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            <% } else { %>
                <div class="empty-cart">
                    <i class="fas fa-shopping-cart"></i>
                    <p>Your cart is empty. Add items to your cart to see them here.</p>
                    <a href="/products" class="continue-shopping">Continue Shopping</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Message container for notifications -->
    <div id="message-container"></div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quantityControls = document.querySelectorAll('.quantity-controls button');
            quantityControls.forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    const action = this.dataset.action;
                    const currentQuantity = parseInt(this.parentElement.querySelector('.quantity-display').textContent);
                    const newQuantity = action === 'increase' ? currentQuantity + 1 : currentQuantity - 1;
                    updateQuantity(productId, newQuantity);
                });
            });
        });
    </script>
    <script src="/Javascript/cart (2).js"></script>
</body>
</html>