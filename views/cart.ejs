<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Vaultique | Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/CSS/cart (2).css">
</head>
<body>
    <div class="header">Vaultique</div>
    <div class="container">
        <div class="cart-section">
            <h2>Shopping Cart</h2>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-circle"></i>
                    <p><%= error %></p>
                </div>
            <% } %>

            <div class="cart-items">
                <% if (cartItems && cartItems.length > 0) { %>
                    <% cartItems.forEach(item => { %>
                        <div class="cart-item" data-id="<%= item.productId %>">
                            <img src="<%= item.image %>" alt="<%= item.name %>">
                            <p class="product-name"><%= item.name %></p>
                            <p class="item-price">$<%= item.price.toFixed(2) %></p>
                            <div class="quantity-controls">
                                <button class="decrease" onclick="updateQuantity('<%= item.productId %>', -1)">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <p class="quantity-display"><%= item.quantity %></p>
                                <button class="increase" onclick="updateQuantity('<%= item.productId %>', 1)">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <button class="remove-item" onclick="removeItem('<%= item.productId %>')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-cart">
                        <i class="fas fa-shopping-cart"></i>
                        <p>Your cart is empty. Add items to your cart to see them here.</p>
                        <a href="/products" class="continue-shopping">Continue Shopping</a>
                    </div>
                <% } %>
            </div>

            <div class="cart-items-summary">
                <p>Items in Cart: <strong id="cart-items-count"><%= cartItems ? cartItems.reduce((total, item) => total + item.quantity, 0) : 0 %></strong></p>
            </div>

            <div class="shipping-options">
                <label for="shipping">Select Shipping Method:</label>
                <select id="shipping" onchange="updateShipping(this.value)">
                    <option value="standard" <%= shippingMethod === 'standard' ? 'selected' : '' %>>Normal Delivery (4-8 days) - $20</option>
                    <option value="fast" <%= shippingMethod === 'fast' ? 'selected' : '' %>>Fast Delivery (24 hours) - $50</option>
                </select>
            </div>

            <div class="price-summary">
                <p class="subtotal">Subtotal: $<%= subtotal ? subtotal.toFixed(2) : '0.00' %></p>
                <p class="shipping">Shipping: <span id="shipping-cost">$<%= shippingCost ? shippingCost.toFixed(2) : '20.00' %></span></p>
                <div class="total-price">Total: $<%= total ? total.toFixed(2) : '0.00' %></div>
            </div>

            <div class="cart-actions">
                <% if (cartItems && cartItems.length > 0) { %>
                    <button class="btn clear-cart" onclick="clearCart()">
                        <i class="fas fa-trash"></i> Clear Cart
                    </button>
                    <a href="/user/payment" class="btn checkout-btn">
                        <i class="fas fa-lock"></i> Proceed to Checkout
                    </a>
                <% } %>
                <a href="/products" class="btn continue-shopping-btn">
                    <i class="fas fa-arrow-left"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>

    <script src="/Javascript/cart (2).js"></script>
</body>
</html>