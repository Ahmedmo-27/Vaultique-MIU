<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Vaultique | Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&family=Lora:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="cart (2).css">
</head>
<body>
    <div class="header">Vaultique</div>
    <div class="container">
        <div class="cart-section">
            <h2>Shopping Cart</h2>
            <div class="cart-items">
                <% if (cartItems && cartItems.length > 0) { %>
                    <% cartItems.forEach(item => { %>
                        <div class="cart-item" data-id="<%= item.id %>">
                            <img src="<%= item.image %>" alt="Product Image">
                            <p class="product-name"><%= item.name %></p>
                            <p class="item-price">$<%= item.price.toFixed(2) %></p>
                            <div class="quantity-controls">
                                <button class="decrease">-</button>
                                <p class="quantity-display"><%= item.quantity %></p>
                                <button class="increase">+</button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-cart">
                        <p>Your cart is empty. Add items to your cart to see them here.</p>
                    </div>
                <% } %>
            </div>

            <div class="cart-items-summary">
                <p>Items in Cart: <strong id="cart-items-count"><%= cartItems ? cartItems.reduce((total, item) => total + item.quantity, 0) : 0 %></strong></p>
            </div>
            <div class="shipping-options">
                <label for="shipping">Select Shipping Method:</label>
                <select id="shipping">
                    <option value="standard">Normal Delivery (4-8 days) - $20</option>
                    <option value="fast">Fast Delivery (24 hours) -$50 </option>
                </select>
            </div>
            <p class="subtotal">Subtotal: $<%= subtotal ? subtotal.toFixed(2) : '0.00' %></p>
            <p>Shipping: <span id="shipping-cost">$<%= shippingCost ? shippingCost.toFixed(2) : '20.00' %></span></p>
            <div class="total-price">Total: $<%= total ? total.toFixed(2) : '0.00' %></div>
            <a href="/checkout"><button class="btn checkout-btn">Proceed to Checkout</button></a>
            <a href="/products"><button class="btn continue-shopping-btn">Continue Shopping</button></a>
        </div>
    </div>
    <script src="cart (2).js"></script>
</body>
</html>