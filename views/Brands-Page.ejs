<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title data-translate="brandsTitle">Vaultique | Luxury Watch Brands - Premium Swiss Manufacturers</title>
    <meta name="description" content="Discover exclusive luxury watch brands at Vaultique. From Rolex to Audemars Piguet, explore premium Swiss watch manufacturers and their iconic timepieces. Authentic luxury watch brands.">
    <meta name="keywords" content="luxury watch brands, Swiss watch brands, Rolex, Audemars Piguet, Cartier, Omega, premium watch manufacturers, luxury watch brands list, Vaultique brands">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Vaultique | Luxury Watch Brands - Premium Swiss Manufacturers">
    <meta property="og:description" content="Discover exclusive luxury watch brands at Vaultique. From Rolex to Audemars Piguet, explore premium Swiss watch manufacturers and their iconic timepieces.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/user/brands">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Vaultique | Luxury Watch Brands - Premium Swiss Manufacturers">
    <meta name="twitter:description" content="Discover exclusive luxury watch brands at Vaultique. From Rolex to Audemars Piguet, explore premium Swiss watch manufacturers.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/user/brands">
    
      <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/Brands-Page.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link rel="stylesheet" href="/CSS/arrow.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Vaultique Luxury Watch Brands",
        "description": "Exclusive collection of premium Swiss watch brands and manufacturers",
        "url": "https://vaultique.live/user/brands",
        "mainEntity": {
            "@type": "ItemList",
            "name": "Luxury Watch Brands",
            "description": "Premium Swiss watch brands and manufacturers",
            "numberOfItems": "<%= brands ? brands.length : 0 %>",
            "itemListElement": [
                <% if (brands && brands.length > 0) { %>
                    <% brands.slice(0, 5).forEach((brand, index) => { %>
                        {
                            "@type": "ListItem",
                            "position": <%= index + 1 %>,
                            "item": {
                                "@type": "Brand",
                                "name": "<%= brand.name %>",
                                "description": "<%= brand.description || brand.name + ' luxury watch brand' %>",
                                "url": "https://vaultique.live/user/brands/<%= brand.slug %>",
                                "logo": "<%= assetUrl(brand.coverImage || '/Assets/Images/LogoV.jpg') %>"
                            }
                        }<%= index < Math.min(4, brands.length - 1) ? ',' : '' %>
                    <% }); %>
                <% } %>
            ]
        }
    }
    </script>

    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/Brands-Page.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <script src="/Javascript/Landing-page.js"></script>
    
    
</head>

<body>

  
    <!--Loading Screen-->
     <%- include('partials/loading-screen') %>

    <!--Scroll Arrow-->
    <div class="scroll-indicator">
        <div class="scroll-circle">
            <div class="scroll-indicator-inner"></div>
            <div class="scroll-progress"></div>
            <div class="scroll-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 5V19M12 19L19 12M12 19L5 12" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
        </div>
    </div>

    <!--Nav-Bar-->
     <%- include('partials/navigation') %>

    <section class="main" id="main">
        <video src="/Assets/Videos/Rolex Datejust - Timeless style.webm" id="video-background" autoplay="" loop="" muted=""></video>
        <div class="main-text">
            <h1 data-translate="signatureInTime">Your Signature in Time</h1>
            <a class="button" href="/Sobhi/Recommendation.html" data-translate="takeQuiz">TAKE THE QUIZ</a>
        </div>
    </section>

   <!--Section For Him / For Her-->
  <!-- Section For Him / For Her -->
<% if (brands && brands.length > 0) { %>
  <% for(let i = 0; i < brands.length; i += 2) { %>
    <section class="him-her">
      <div class="gender">
        <% if (i < brands.length) { %>
          <div class="female">
            <canvas id="female-fluid-canvas"></canvas>
            <img id="female-img-<%= i %>" src="<%= brands[i].coverImage2 %>" alt="<%= brands[i].name %>">
            <div class="text-container">
              <div class="section-title"><%= brands[i].name %></div>
              <div class="section-description">
                <%= brands[i].description.substring(0, 150) + (brands[i].description.length > 150 ? '...' : '') %>
              </div>
            </div>
            <div class="text-overlay">
              <button onclick="window.location.href='/user/brands/<%= brands[i].slug %>'" data-translate="explore">Explore</button>
            </div>
          </div>
        <% } %>
        
        <% if (i + 1 < brands.length) { %>
          <div class="male">
            <canvas id="male-fluid-canvas"></canvas>
            <img id="male-img-<%= i+1 %>" src="<%= brands[i+1].coverImage2 %>" alt="<%= brands[i+1].name %>">
            <div class="text-container">
              <div class="section-title"><%= brands[i+1].name %></div>
              <div class="section-description">
                <%= brands[i+1].description.substring(0, 150) + (brands[i+1].description.length > 150 ? '...' : '') %>
              </div>
            </div>
            <div class="text-overlay">
              <button onclick="window.location.href='/brands/<%= brands[i+1].slug %>'" data-translate="explore">Explore</button>
            </div>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>
<% } else { %>
  <section class="no-brands">
    <p data-translate="noBrandsAvailable">No brands available at the moment</p>
  </section>
<% } %>


   



   <!-- Include footer partial -->
    <%- include('partials/footer') %>
    <%- include('partials/notification') %>

    <!-- <script src="JavaScript/translations.js"></script>
    <script src="JavaScript/language-switch.js"></script> -->
    
    <script>
        if(history.scrollRestoration)
        {
            history.scrollRestoration='manual';
        }
    
        window.onbeforeunload = function () 
        {
            window.scrollTo(0, 0);
        };
    </script>

  <!-- ملفات الترجمة -->
  <script src="/Javascript/translations.js"></script>
  <script src="/Javascript/language.js"></script>
</body>

</html>