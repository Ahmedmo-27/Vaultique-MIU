<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Analytics Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/CSS/analytics.css">
  <link rel="stylesheet" href="/CSS/nav-bar.css">
  <script src="https://kit.fontawesome.com/your-kit-id.js" crossorigin="anonymous"></script>
  <script src="/Javascript/nav-bar.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
  <script src="/Javascript/analytics.js" defer></script>
</head>
<body>

    <%- include('partials/Admin-navigation') %>

    <div class="container">
      <div class="card dark">
        <h2>Active Users</h2>
        <p class="large"><%= activeUsers || 0 %></p>
      </div>

      <div class="card">
        <h3>Sales Overview</h3>
        <canvas id="trafficChart" width="400" height="200"></canvas>
      </div>

      <div class="card stats-box">
        <p>Users</p>
        <h3><%= totalUsers || 0 %></h3>
        <p class="<%= userGrowth >= 0 ? 'positive' : 'negative' %>">
          <%= userGrowth >= 0 ? '+' : '' %><%= userGrowth || 0 %>%
        </p>
      </div>

      <div class="card stats-box">
        <p>Sessions</p>
        <h3><%= totalSessions || 0 %></h3>
        <p class="<%= sessionGrowth >= 0 ? 'positive' : 'negative' %>">
          <%= sessionGrowth >= 0 ? '+' : '' %><%= sessionGrowth || 0 %>%
        </p>
      </div>

      <div class="card stats-box">
        <p>Bounce Rate</p>
        <h3><%= bounceRate || 0 %>%</h3>
        <p class="<%= bounceRateChange <= 0 ? 'positive' : 'negative' %>">
          <%= bounceRateChange >= 0 ? '+' : '' %><%= bounceRateChange || 0 %>%
        </p>
      </div>

      <div class="card stats">
        <p>Session Duration</p>
        <h3><%= sessionDuration || '0:00' %></h3>
        <p class="<%= sessionDurationChange >= 0 ? 'positive' : 'negative' %>">
          <%= sessionDurationChange >= 0 ? '+' : '' %><%= sessionDurationChange || 0 %>%
        </p>
      </div>

      <div class="card alert">
        <span class="alert-icon">🔔</span>
        <div>
          <strong>No alerts set</strong>
          <p>Get notified when your data drastically changes</p>
        </div>
      </div>

      <div class="card" id="brandStats">
        <h3>Most Selling Brands</h3>
        <% if (brandStats && brandStats.length > 0) { %>
          <ul class="stats-list">
            <% brandStats.forEach(brand => { %>
              <li>
                <span class="brand-name"><%= brand.name %></span>
                <span class="brand-sales">$<%= brand.sales.toFixed(2) %></span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>No brand statistics available</p>
        <% } %>
      </div>

      <div class="card" id="collectionStats">
        <h3>Most Selling Collections</h3>
        <% if (collectionStats && collectionStats.length > 0) { %>
          <ul class="stats-list">
            <% collectionStats.forEach(collection => { %>
              <li>
                <span class="collection-name"><%= collection.name %></span>
                <span class="collection-sales">$<%= collection.sales.toFixed(2) %></span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p>No collection statistics available</p>
        <% } %>
      </div>

      <div class="card highlight">
        <h2>Vaultique</h2>
      </div>

    </div>

    <%- include('partials/notification') %>

</body>
</html>
