<body>

    <%- include('partials/loading-screen') %>
    <%- include('partials/navigation') %>


    <section class="main" id="main">
        <video src="/Assets/Videos/Rolex Datejust - Timeless style.webm" id="video-background" autoplay="" loop=""
            muted=""></video>
        <div class="main-text">
            <h1>Your Signature in Time</h1>
            <a class="button" href="/user/Recommendation-System">TAKE THE QUIZ</a>
        </div>
    </section>

 <!-- In Home-Page.ejs, around line 48 -->
<section>
    <% if (typeof genders !== 'undefined' && genders && genders.length > 0) { %>
        <% genders.forEach((gender) => { %>
            <section class="section hero">
                <div class="video-container">
                    <video autoplay muted loop playsinline>
                        <source src="<%= gender.heroVideo %>" type="video/mp4">
                    </video>
                </div>
                <div class="content hover-text">
                    <h2 data-translate="genderSection"><%= gender.name %></h2>
                    <br>
                    <p data-translate="genderDesc">
                        <%= gender.description %>
                    </p>
                    <br><br>
                    <a class="button" href="/user/Gender/<%= gender.slug %>">
                        See <%= gender.name %> Collection
                    </a>
                </div>
            </section>
        <% }); %>
    <% } else { %>
        <div class="error-message">
            <p>Gender collections are currently unavailable. Please try again later.</p>
        </div>
    <% } %>
</section>

    <!-- Popular Collections Section -->
    <section class="collections">
        <h2>Collections</h2>

        <section class="slider-container">
            <div class="slider-wrapper">
                <div class="slider" id="watchSlider">
                    <!-- Slide 1 - Classic & Dress Collection -->
                    <div class="slide">
                        <div class="collection-grid">
                            <div class="collection-card">
                                <div class="collection-image">
                                    <img src="/Assets/Models/Cartier Tank.jpg" alt="Cartier Tank Watch">
                                </div>
                                <div class="collection-info">
                                    <h3>Classic & Dress Collection</h3>
                                    <p>Timeless elegance for formal occasions</p>
                                    <a href="/user/collections/classic-and-dress" class="explore-btn">Explore</a>
                                </div>
                            </div>

                            <div class="collection-card">
                                <div class="collection-image">
                                    <img src="/Assets/Models/John-Legends-Omega-Seamaster-300m-007-Edition.jpg"
                                        alt="Patek Philippe Watch">
                                </div>
                                <div class="collection-info">
                                    <h3>Casual & Everyday Collection</h3>
                                    <p>Sophisticated timepieces for daily wear</p>
                                    <a href="/user/collections/casual-and-everyday" class="explore-btn">Explore</a>
                                </div>
                            </div>

                            <div class="collection-card">
                                <div class="collection-image">
                                    <img src="/Assets/Models/professional-watches-submariner-titouan-bernicot_pp_coralgardeners_22tm_2146.avif"
                                        alt="Omega Seamaster Watch">
                                </div>
                                <div class="collection-info">
                                    <h3>Sports & Adventure Collection</h3>
                                    <p>Robust watches for active lifestyles</p>
                                    <a href="/user/collections/sports-and-adventure" class="explore-btn">Explore</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2 - Luxury & Heritage -->
                    <div class="slide">
                        <div class="collection-grid">
                            <div class="collection-card">
                                <div class="collection-image">
                                    <img src="/Assets/Models/Charlize Breitling.webp" alt="Breitling Watch">
                                </div>
                                <div class="collection-info">
                                    <h3>Aviation & Travel Collection</h3>
                                    <p>Precision timepieces for global explorers</p>
                                    <a href="/user/collections/aviation-and-travel" class="explore-btn">Explore</a>
                                </div>
                            </div>

                            <div class="collection-card">
                                <div class="collection-image">
                                    <img src="/Assets/Models/Patek Philippe Grand Master Chime Jay Z .jpg"
                                        alt="Luxury Watch">
                                </div>
                                <div class="collection-info">
                                    <h3>Luxury & Heritage Collection</h3>
                                    <p>Prestigious timepieces with rich history</p>
                                    <a href="/user/collections/luxury-and-heritage" class="explore-btn">Explore</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button class="slider-arrow prev" id="prevBtn" aria-label="Previous slide">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>
            <button class="slider-arrow next" id="nextBtn" aria-label="Next slide">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>

            <div class="slider-dots" id="sliderDots"></div>
        </section>
    </section>

