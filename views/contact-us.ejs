<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title data-translate="contactUsTitle">Contact Vaultique | Luxury Watch Customer Support</title>
    <meta name="description" content="Contact Vaultique for luxury watch support, sales inquiries, and warranty information. Expert customer service for Swiss timepieces. Get in touch with our luxury watch specialists.">
    <meta name="keywords" content="contact Vaultique, luxury watch support, Swiss watch customer service, watch warranty, luxury watch sales, Vaultique contact">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Contact Vaultique | Luxury Watch Customer Support">
    <meta property="og:description" content="Contact Vaultique for luxury watch support, sales inquiries, and warranty information. Expert customer service for Swiss timepieces.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.com/contact-us">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Contact Vaultique | Luxury Watch Customer Support">
    <meta name="twitter:description" content="Contact Vaultique for luxury watch support, sales inquiries, and warranty information. Expert customer service for Swiss timepieces.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.com/contact-us">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/contact-us.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Contact Vaultique",
        "description": "Contact page for Vaultique luxury watch customer support and inquiries",
        "url": "https://vaultique.com/contact-us",
        "mainEntity": {
            "@type": "Organization",
            "name": "Vaultique",
            "contactPoint": [
                {
                    "@type": "ContactPoint",
                    "contactType": "customer service",
                    "telephone": "+20 109 123 4567",
                    "email": "vaultique.watches@gmail.com",
                    "availableLanguage": ["English", "Arabic"],
                    "areaServed": "Worldwide"
                },
                {
                    "@type": "ContactPoint",
                    "contactType": "sales",
                    "telephone": "+20 109 123 4567",
                    "email": "vaultique.watches@gmail.com"
                }
            ],
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "15 New Cairo",
                "addressLocality": "Cairo",
                "addressCountry": "Egypt"
            },
            "openingHours": [
                "Mo-Fr 09:00-18:00",
                "Sa 10:00-16:00"
            ]
        }
    }
    </script>
    
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <script src="/Javascript/Contact-Us.js"></script>
</head>
<style>
    .contact-container {
        margin-top: 150px;
    }
</style>
<body>
    <%- include('partials/loading-screen') %>
    <%- include('partials/navigation') %>

    <main class="contact-container">
        <h1 data-translate="contactUs">Contact Us</h1>
        
        <div class="contact-content">
            <div class="contact-info">
                <div class="info-section">
                    <h2 data-translate="getInTouch">Get in Touch</h2>
                    <p data-translate="contactIntro">We'd love to hear from you. Please fill out the form or use our contact information below.</p>
                    
                    <div class="contact-details">
                        <div class="contact-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <h3 data-translate="address">Address</h3>
                                <p>15 New Cairo, Cairo, Egypt</p>
                            </div>
                        </div>
                        
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <div>
                                <h3 data-translate="phone">Phone</h3>
                                <p>+20 109 123 4567</p>
                            </div>
                        </div>
                        
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <div>
                                <h3 data-translate="email">Email</h3>
                                <p>vaultique.watches@gmail.com</p>
                            </div>
                        </div>
                        
                        <div class="contact-item">
                            <i class="fas fa-clock"></i>
                            <div>
                                <h3 data-translate="businessHours">Business Hours</h3>
                                <p data-translate="businessHoursDetails">Monday - Friday: 9:00 AM - 6:00 PM<br>Saturday: 10:00 AM - 4:00 PM<br>Sunday: Closed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <h2 data-translate="sendMessage">Send us a Message</h2>
                <form id="contactForm">
                    <div class="form-group">
                        <label for="name" data-translate="fullName">Full Name</label>
                        <input type="text" id="name" name="name" required>
                    </div>

                    <div class="form-group">
                        <label for="email" data-translate="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="phone" data-translate="phoneNumber">Phone Number</label>
                        <input type="tel" id="phone" name="phone" pattern="^\+?[1-9]\d{1,14}$">
                    </div>

                    <div class="form-group">
                        <label for="subject" data-translate="subject">Subject</label>
                        <select id="subject" name="subject" required>
                            <option value="" data-translate="selectSubject">Select a subject</option>
                            <option value="general" data-translate="generalInquiry">General Inquiry</option>
                            <option value="support" data-translate="technicalSupport">Technical Support</option>
                            <option value="sales" data-translate="salesQuestion">Sales Question</option>
                            <option value="warranty" data-translate="warrantyInformation">Warranty Information</option>
                            <option value="other" data-translate="other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message" data-translate="message">Message</label>
                        <textarea id="message" name="message" rows="5" required></textarea>
                    </div>

                    <button type="submit" class="submit-btn" data-translate="sendMessageBtn">Send Message</button>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
      <!-- ملفات الترجمة -->
  <script src="/Javascript/translations.js"></script>
  <script src="/Javascript/language.js"></script>
</body>
</html>