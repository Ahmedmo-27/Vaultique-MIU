<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Collection - <%= collection.name %></title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/AdminHubHomePage.css">
    <link rel="stylesheet" href="/CSS/CreateCollection.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
</head>
<body>
    <%- include('partials/Admin-navigation') %>

    <div class="container">
        <div class="form-container">
            <h2 class="mb-4">Edit Collection: <%= collection.name %></h2>
            <form id="editCollectionForm" action="/admin/collections/<%= collection._id %>" method="POST" enctype="multipart/form-data">
                <!-- Basic Information -->
                <div class="form-group">
                    <label for="name">Collection Name</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= collection.name %>" required>
                </div>

                <div class="form-group">
                    <label for="slug">Slug</label>
                    <input type="text" class="form-control" id="slug" name="slug" value="<%= collection.slug %>" required>
                    <small class="form-text text-muted">This will be used in the URL (e.g., "classic-and-dress")</small>
                </div>

                <div class="form-group">
                    <label for="header">Header</label>
                    <input type="text" class="form-control" id="header" name="header" value="<%= collection.header %>" required>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="4" required><%= collection.description %></textarea>
                </div>

                <!-- Media -->
                <div class="form-group">
                    <label for="logo">Logo</label>
                    <input type="file" class="form-control" id="logo" name="logo" accept="image/*">
                    <% if (collection.logo) { %>
                        <div class="current-image">
                            <p>Current Logo:</p>
                            <img src="<%= collection.logo %>" alt="Current Logo" class="preview-image">
                        </div>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="coverImage">Cover Image</label>
                    <input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/*">
                    <% if (collection.coverImage) { %>
                        <div class="current-image">
                            <p>Current Cover Image:</p>
                            <img src="<%= collection.coverImage %>" alt="Current Cover" class="preview-image">
                        </div>
                    <% } %>
                </div>

                <div class="form-group">
                    <label for="heroVideo">Hero Video</label>
                    <input type="file" class="form-control" id="heroVideo" name="heroVideo" accept="video/*">
                    <% if (collection.heroVideo) { %>
                        <div class="current-video">
                            <p>Current Video:</p>
                            <video controls class="preview-image">
                                <source src="<%= collection.heroVideo %>" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    <% } %>
                </div>

                <!-- Featured Items -->
                <div class="form-group">
                    <label>Featured Items</label>
                    <button type="button" class="btn btn-secondary btn-add-featured" onclick="addFeaturedItem()">
                        <i class="fas fa-plus"></i> Add Featured Item
                    </button>
                    <div id="featuredItems">
                        <% collection.featuredItems.forEach((item, index) => { %>
                            <div class="featured-item">
                                <div class="featured-item-header">
                                    <h3>Featured Item <%= index + 1 %></h3>
                                    <button type="button" class="remove-item-btn" onclick="this.closest('.featured-item').remove()">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <div class="form-group">
                                    <label for="featuredItems[<%= index %>][name]">Name</label>
                                    <input type="text" class="form-control" name="featuredItems[<%= index %>][name]" value="<%= item.name %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="featuredItems[<%= index %>][image]">Image</label>
                                    <input type="file" class="form-control" name="featuredItems[<%= index %>][image]" accept="image/*">
                                    <% if (item.image) { %>
                                        <div class="current-image">
                                            <p>Current Image:</p>
                                            <img src="<%= item.image %>" alt="Current Item Image" class="preview-image">
                                        </div>
                                    <% } %>
                                </div>
                                <div class="form-group">
                                    <label for="featuredItems[<%= index %>][tagline]">Tagline</label>
                                    <input type="text" class="form-control" name="featuredItems[<%= index %>][tagline]" value="<%= item.tagline %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="featuredItems[<%= index %>][description]">Description</label>
                                    <textarea class="form-control" name="featuredItems[<%= index %>][description]" rows="3" required><%= item.description %></textarea>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/admin/collections" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Preview images when selected
        document.querySelectorAll('input[type="file"]').forEach(input => {
            input.addEventListener('change', function(e) {
                const preview = this.closest('.form-group').querySelector('.preview-image');
                if (preview) {
                    if (this.files && this.files[0]) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.src = e.target.result;
                        }
                        reader.readAsDataURL(this.files[0]);
                    }
                }
            });
        });

        // Generate slug from name
        document.getElementById('name').addEventListener('input', function(e) {
            const slug = e.target.value
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/(^-|-$)/g, '');
            document.getElementById('slug').value = slug;
        });

        // Add featured item
        let featuredItemCount = (collection && collection.featuredItems) ? collection.featuredItems.length : 0;

        function addFeaturedItem() {
            const container = document.getElementById('featuredItems');
            const itemDiv = document.createElement('div');
            itemDiv.className = 'featured-item';
            itemDiv.innerHTML = `
                <div class="featured-item-header">
                    <h3>Featured Item ${featuredItemCount + 1}</h3>
                    <button type="button" class="remove-item-btn" onclick="this.closest('.featured-item').remove()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="form-group">
                    <label for="featuredItems[${featuredItemCount}][name]">Name</label>
                    <input type="text" class="form-control" name="featuredItems[${featuredItemCount}][name]" required>
                </div>
                <div class="form-group">
                    <label for="featuredItems[${featuredItemCount}][image]">Image</label>
                    <input type="file" class="form-control" name="featuredItems[${featuredItemCount}][image]" accept="image/*" required>
                </div>
                <div class="form-group">
                    <label for="featuredItems[${featuredItemCount}][tagline]">Tagline</label>
                    <input type="text" class="form-control" name="featuredItems[${featuredItemCount}][tagline]" required>
                </div>
                <div class="form-group">
                    <label for="featuredItems[${featuredItemCount}][description]">Description</label>
                    <textarea class="form-control" name="featuredItems[${featuredItemCount}][description]" rows="3" required></textarea>
                </div>
            `;
            container.appendChild(itemDiv);
            featuredItemCount++;
        }

        // Form submission
        document.getElementById('editCollectionForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            try {
                const formData = new FormData(this);
                
                const response = await fetch(this.action, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (response.ok) {
                    showNotification(result.message || 'Collection updated successfully!', 'success');
                    setTimeout(() => {
                        window.location.href = '/admin/collections';
                    }, 1500);
                } else {
                    showNotification(result.message || 'Failed to update collection', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('An error occurred while updating the collection', 'error');
            }
        });

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
    </script>
</body>
</html> 