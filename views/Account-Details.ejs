  flex: 1;
  min-width: 300px;
  padding-top: 20px;
}

.product-header h1 {
  font-size: 2.2rem;
  color: #050a30;
  margin-bottom: 15px;
  font-family: "futura pt", sans-serif;
}

.price-qv {
  font-size: 1.8rem;
  color: #785D32;
  font-weight: bold;
  margin-bottom: 5px;
}

.rating {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #050a30;
}

.rating i {
  color: #FFD700;
}

/* Product Actions */
.product-actions {
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  gap: 1rem;
  margin: 2rem 0;
}

.product-actions button {
  padding: 1rem;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-family: "futura pt", sans-serif;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: all 0.3s ease;
}

.wishlist-btn {
  background-color: transparent;
  border: 1px solid #333 !important;
  transition: all 0.3s ease;
}

.wishlist-btn i {
  transition: all 0.3s ease;
}

.wishlist-btn.filled i {
  color: #ff4444;
}

.wishlist-btn:hover i {
  transform: scale(1.2);
}

.wishlist-btn.filled:hover i {
  color: #ff0000;
}

.add-to-cart {
  background-color: #050a30;
  color: white;
  grid-column: 1 / -1;
}

.find-store {
  background-color: #f5f5f5;
  color: #333;
  grid-column: 1 / -1;
}

.product-description {
  line-height: 1.6;
  color: #444;
  margin-top: 2rem;
}

/* Close Button */
.close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #f0f0f0;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.close-btn:hover {
  background: #e0e0e0;
}

/* Responsive */
@media (max-width: 992px) {
  .quick-view-content {
    flex-direction: column;
  }
  
  .main-image {
    height: 400px;
  }
  
  .thumbnail {
    width: 80px;
    height: 80px;
    min-width: 80px;
  }
}

@media (max-width: 576px) {
  .quick-view-modal {
    width: 95%;
    padding: 20px;
  }
  
  .main-image {
    height: 300px;
  }
  
  .product-actions {
    grid-template-columns: 1fr;
  }
  
  .product-header h1 {
    font-size: 1.8rem;
  }
}

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            .product-card {
                background: var(--card-bg-dark, #2d2d2d);
