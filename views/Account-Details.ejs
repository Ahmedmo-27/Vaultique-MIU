<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user?.Name || 'User' %> | Account Details</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/Account-Details.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Account-Details.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <script type="application/json" id="userData"><%- JSON.stringify(user || {}) %></script>
    <script type="application/json" id="wishlistData"><%- JSON.stringify(user?.wishlist?.filter(item => item.product).map(item => item.product) || []) %></script>
</head>
<body>

    <%- include('partials/loading-screen') %>

    <%- include('partials/navigation') %>
   
    <div class="account-container">
        <div class="sidebar">
            <div class="sidebar-item active" data-tab="personal-info"><i class="fas fa-user"></i> Personal Information</div>
            <div class="sidebar-item" data-tab="addresses"><i class="fas fa-map-marker-alt"></i> My Addresses</div>
            <div class="sidebar-item" data-tab="orders"><i class="fas fa-box"></i> My Orders</div>
            <div class="sidebar-item" data-tab="wishlist"><i class="fas fa-heart"></i> My Wishlist</div>
            <div class="sidebar-item" data-tab="refunds"><i class="fas fa-undo"></i> My Refunds</div>
            <div class="sidebar-item" data-tab="payment-methods"><i class="fas fa-credit-card"></i> Payment Methods</div>
            <div class="sidebar-item" data-tab="reviews"><i class="fas fa-star"></i> My Reviews</div>
            <div class="sidebar-item" data-tab="logout"><i class="fas fa-sign-out-alt"></i> Logout</div>
        </div>
        
        <div class="main-content">
            <!-- Personal Information Tab (Default Active) -->
            <div class="tab-content active" id="personal-info">
                <div class="section-title">Account Settings</div>
                
                <div class="form-group">
                    <label class="form-label">Full Name</label>
                    <div class="form-value"><%= user?.Name || 'Not provided' %></div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <div class="form-value"><%= user?.email || 'Not provided' %></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="form-value">********** <a href="#" class="edit-link" id="changePasswordLink">Change Password</a></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label">Date of Birth</label>
                    <div class="form-value"><%= user?.DOB ? new Date(user.DOB).toLocaleDateString() : 'Not provided' %></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label">Phone Number</label>
                    <div class="phone-input-container">
                        <select id="countrySelect" class="country-select">
                            <!-- Options populated by JavaScript -->
                        </select>
                        <input id="phoneNumber" type="tel" value="<%= user?.phone_number || '' %>" placeholder="Enter your phone number">
                        <!-- Debug info -->
                        <script>
                            console.log('Phone number:', '<%= user?.phone_number || "" %>');
                        </script>
                    </div>
                </div>
    
                <div class="form-group">
                    <label class="form-label">Preferred Language</label>
                    <select id="languageSelect">
                        <option value="English" <%= user?.language === 'English' ? 'selected' : '' %>>English</option>
                        <option value="Arabic" <%= user?.language === 'Arabic' ? 'selected' : '' %>>Arabic</option>
                    </select>
                </div>
            </div>
            
            <!-- Addresses Tab -->
            <div class="tab-content" id="addresses">
                <div class="section-title">My Addresses</div>
                
                <div class="address-list">
                    <% if (user?.Address) { %>
                        <div class="address-card default">
                            <div class="address-header">
                                <h4><%= user.Address.addressType || 'Home' %> Address</h4>
                                <span class="default-badge">Default</span>
                            </div>
                            <p><%= user.Address.street || 'No street provided' %></p>
                            <p><%= user.Address.city || '' %><%= user.Address.city && user.Address.state ? ', ' : '' %><%= user.Address.state || '' %></p>
                            <p><%= user.Address.country || '' %></p>
                            <div class="address-actions">
                                <button class="edit-address">Edit</button>
                                <button class="remove-address">Remove</button>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="no-addresses">
                            <p>No addresses have been added yet.</p>
                        </div>
                    <% } %>
                    
                    <button class="add-address-btn">
                        <i class="fas fa-plus"></i> Add New Address
                    </button>
                </div>
            </div>
            
            <!-- Orders Tab -->
            <div class="tab-content" id="orders">
                <div class="section-title">My Orders</div>
                
                <div class="order-filters">
                    <select id="orderFilter">
                        <option value="all">All Orders</option>
                        <option value="pending">Pending</option>
                        <option value="shipped">Shipped</option>
                        <option value="delivered">Delivered</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                    <input type="text" placeholder="Search orders..." id="orderSearch">
                </div>
                
                <div class="orders-list">
                    <% if (user?.orders && user.orders.length > 0) { %>
                        <% user.orders.forEach(order => { %>
                            <div class="order-card" data-order-id="<%= order.orderId %>">
                                <div class="order-header">
                                    <div class="order-id">Order #<%= order.orderId %></div>
                                    <div class="order-date">Placed on <%= new Date(order.orderDate).toLocaleDateString() %></div>
                                    <div class="order-status <%= order.status.toLowerCase() %>"><%= order.status %></div>
                                    <div class="order-total">$<%= order.total.toFixed(2) %></div>
                                </div>
                                <div class="order-products">
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach(item => { %>
                                            <div class="order-product">
                                                <img src="<%=item.product.image%>" alt="<%=item.product.name%>">
                                                <div class="product-info">
                                                    <h5><%= item.product && item.product.name ? item.product.name : 'Unknown Product' %></h5>
                                                    <p>Qty: <%= item.quantity || 1 %></p>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                                <div class="order-actions">
                                    <% if (order.status === 'Shipped') { %>
                                        <button class="track-order">Track Order</button>
                                    <% } else if (order.status === 'Delivered') { %>
                                        <button class="buy-again">Buy Again</button>
                                    <% } %>
                                    <button class="order-details">View Details</button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="no-orders">
                            <p>You haven't placed any orders yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Wishlist Tab -->
            <div class="tab-content" id="wishlist">
                <div class="section-title">My Wishlist</div>
                <% const wishlistItems = user?.wishlist?.filter(item => item.product).map(item => item.product) || []; %>
                <div class="wishlist-grid" id="wishlistGrid">
                    <% if (wishlistItems && wishlistItems.length > 0) { %>
                        <% wishlistItems.forEach(product => { %>
                                <div class="product-card" data-product-id="<%= product._id %>">
                                    <div class="product-image-container">
                                        <div class="wishlist-icon remove-item" data-product-id="<%= product._id %>">
                                            <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                            </svg>
                                        </div>
                                        <a href="/user/product?id=<%- product._id %>">
                                            <img src="<%= product.image ? (product.image.startsWith('/') ? product.image : `/Assets/Images/Watches/${product.image}`) : '/Assets/Images/product-placeholder.jpg' %>" alt="<%- product.name %>" loading="lazy">
                                        </a>
                                        <div class="hover-buttons">
                                            <button class="quick-view" data-product-id="<%= product._id %>">Quick View</button>
                                            <button class="compare" data-product-id="<%= product._id %>">Compare</button>
                                        </div>
                                    </div>
                                    <div class="product-details">
                                        <h4><%- product.name %></h4>
                                        <div class="product-meta">
                                            <p class="price">€ <%= (product.price || 0).toLocaleString() %></p>
                                        </div>
                                        <div class="product-status">
                                            <% if (product.stock || (product.stockCount && product.stockCount > 0)) { %>
                                                <p class="stock in-stock">In Stock</p>
                                            <% } else { %>
                                                <p class="stock out-of-stock">Out of Stock</p>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-wishlist">
                            <i class="far fa-heart"></i>
                            <h2>Your wishlist is empty</h2>
                            <p>Start adding products to your wishlist by clicking the heart icon on any product.</p>
                            <a href="/user/products" class="browse-products-btn">Browse Products</a>
                        </div>
                    <% } %>
                </div>

                <!-- Loading Spinner -->
                <div class="wishlist-loading" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </div>
            
            <!-- Refunds Tab -->
            <div class="tab-content" id="refunds">
                <div class="section-title">My Refunds</div>
                
                <div class="refunds-list">
                    <% if (user?.refunds && user.refunds.length > 0) { %>
                        <% user.refunds.forEach(refund => { %>
                            <div class="refund-card <%= refund.status.toLowerCase() %>">
                                <div class="refund-header">
                                    <div class="refund-id">Refund #<%= refund.refundId %></div>
                                    <div class="refund-status"><%= refund.status %></div>
                                </div>
                                <div class="refund-details">
                                    <% if (refund.order && refund.order.orderId) { %>
                                        <p><strong>Order:</strong> #<%= refund.order.orderId %> 
                                            <% if (refund.order.items && refund.order.items.length > 0 && refund.order.items[0].product) { %>
                                                - <%= refund.order.items[0].product.name || 'Product' %>
                                            <% } %>
                                        </p>
                                    <% } %>
                                    <p><strong>Reason:</strong> <%= refund.reason || 'Not specified' %></p>
                                    <p><strong>Amount:</strong> $<%= refund.amount ? refund.amount.toFixed(2) : '0.00' %></p>
                                    <p><strong><%= refund.status === 'Pending' ? 'Requested' : 'Processed' %> on:</strong> <%= refund.date ? new Date(refund.date).toLocaleDateString() : 'Unknown date' %></p>
                                </div>
                                <div class="refund-actions">
                                    <button class="view-details">View Details</button>
                                    <% if (refund.status === 'Pending') { %>
                                        <button class="cancel-request" data-refund-id="<%= refund._id %>">Cancel Request</button>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="no-refunds">
                            <p>You haven't requested any refunds yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Payment Methods Tab -->
            <div class="tab-content" id="payment-methods">
                <div class="section-title">Payment Methods</div>
                
                <div class="payment-methods-list">
                    <% if (user?.Payment && user.Payment.cardNumber) { %>
                        <div class="payment-method-card default">
                            <div class="payment-method-header">
                                <div class="payment-method-type">
                                    <i class="fab fa-cc-<%= (user.Payment.paymentType && user.Payment.paymentType.toLowerCase().includes('visa')) ? 'visa' : 'mastercard' %>"></i>
                                    <span><%= user.Payment.paymentType || 'Credit Card' %></span>
                                </div>
                                <span class="default-badge">Default</span>
                            </div>
                            <div class="payment-method-details">
                                <p>**** **** **** <%= user.Payment.cardNumber.slice(-4) %></p>
                                <p>Expires <%= user.Payment.expiryDate || 'N/A' %></p>
                            </div>
                            <div class="payment-method-actions">
                                <button class="edit-method">Edit</button>
                                <button class="remove-method">Remove</button>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="no-payment-methods">
                            <p>No payment methods added yet.</p>
                        </div>
                    <% } %>
                    
                    <button class="add-payment-method">
                        <i class="fas fa-plus"></i> Add New Payment Method
                    </button>
                </div>
            </div>
            
            <!-- Reviews Tab -->
            <div class="tab-content" id="reviews">
                <div class="section-title">My Reviews</div>
                
                <div class="reviews-list">
                    <% if (user?.reviews && user.reviews.length > 0) { %>
                        <% user.reviews.forEach(review => { %>
                            <% if (review && review.product) { %>
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="review-product">
                                            <img src="<%= review.product.image || '/Assets/Images/product-placeholder.jpg' %>" alt="<%= review.product.name || 'Product' %>">
                                            <h5><%= review.product.name || 'Unknown Product' %></h5>
                                        </div>
                                        <div class="review-rating">
                                            <div class="stars">
                                                <% for(let i = 1; i <= 5; i++) { %>
                                                    <i class="<%= i <= review.rating ? 'fas' : 'far' %> fa-star"></i>
                                                <% } %>
                                            </div>
                                            <div class="review-date"><%= review.date ? new Date(review.date).toLocaleDateString() : 'Unknown date' %></div>
                                        </div>
                                    </div>
                                    <div class="review-content">
                                        <h6><%= review.title || '' %></h6>
                                        <p><%= review.content || 'No content provided.' %></p>
                                    </div>
                                    <div class="review-actions">
                                        <button class="edit-review" data-review-id="<%= review._id %>">Edit Review</button>
                                        <button class="delete-review" data-review-id="<%= review._id %>">Delete</button>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                        <div class="no-reviews">
                            <p>You haven't written any reviews yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('partials/footer') %>

    <%- include('partials/notification', { 
        type: locals.type || 'info',
        message: locals.message || '',
        show: locals.show || false 
    }) %>

    <%- include('partials/modals') %>

    <!-- Quick View Modal -->
    <div id="quickViewModal" class="quick-view-modal">
        <button class="close-btn" id="closeQuickView">✖</button>
        <div class="quick-view-content">
            <section class="product-gallery">
                <div class="all_image">
                    <div class="main-image">
                        <img id="quickViewMainImage" alt="Product Image">
                    </div>
                    <div class="thumbnail-container" id="thumbnailContainer">
                        <!-- Thumbnails will be populated here -->
                    </div>
                </div>
            </section>
            
            <div class="product-info">
                <div class="product-header">
                    <h1 id="quickViewProductName"></h1>
                    <div class="product-meta">
                        <div class="price-qv" id="quickViewPrice"></div>
                    </div>
                </div>
                
                <div class="product-actions">
                    <button class="wishlist-btn" id="quickViewWishlistBtn">
                        <i class="far fa-heart"></i>
                    </button>
                    <button class="add-to-cart" id="quickViewAddToCart">
                        <i class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                    <button class="find-store">
                        <i class="fas fa-map-marker-alt"></i> View 3D Model
                    </button>
                </div>
                
                <div class="product-description">
                    <p id="quickViewDescription"></p>
                </div>
            </div>
        </div>
    </div>
    <div id="quickViewOverlay" class="quick-view-overlay"></div>

    <!-- Modals Section -->
    <div id="modalsContainer" style="display: none;">
        <!-- Order Details Modal -->
        <div id="orderDetailsModal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Order Details</h3>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <!-- Content will be dynamically populated -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn">Close</button>
                    <button type="button" class="track-order-btn">Track Order</button>
                </div>
            </div>
        </div>

        <!-- Tracking Modal -->
        <div id="trackingModal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Order Tracking</h3>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <!-- Content will be dynamically populated -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn">Close</button>
                </div>
            </div>
        </div>

        <!-- Refund Details Modal -->
        <div id="refundDetailsModal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Refund Details</h3>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <!-- Content will be dynamically populated -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn">Close</button>
                    <button type="button" class="cancel-request-btn">Cancel Request</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize modal elements
            const quickViewModal = document.getElementById('quickViewModal');
            const quickViewOverlay = document.getElementById('quickViewOverlay');
            const closeQuickViewBtn = document.getElementById('closeQuickView');
            const wishlistGrid = document.getElementById('wishlistGrid');
            const loadingSpinner = document.querySelector('.wishlist-loading');
            const userData = JSON.parse(document.getElementById('userData').textContent);
            const wishlistData = JSON.parse(document.getElementById('wishlistData').textContent);

            console.log(userData);
            console.log(wishlistData);

            // Function to show modal
            function showModal(modalId) {
                console.log('Showing modal:', modalId);
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.add('show');
                    document.body.style.overflow = 'hidden';
                } else {
                    console.error('Modal not found:', modalId);
                }
            }

            // Function to hide modal
            function hideModal(modalId) {
                console.log('Hiding modal:', modalId);
                const modal = document.getElementById(modalId);
                if (modal) {
                    modal.classList.remove('show');
                    document.body.style.overflow = '';
                }
            }

            // Initialize modals container
            const modalsContainer = document.getElementById('modalsContainer');
            if (modalsContainer) {
                modalsContainer.style.display = 'block';
            }

            // Close modal when clicking the close button
            document.querySelectorAll('.close-modal, .cancel-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const modal = this.closest('.modal-overlay');
                    if (modal) {
                        hideModal(modal.id);
                    }
                });
            });

            // Close modal when clicking outside
            document.querySelectorAll('.modal-overlay').forEach(modal => {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        hideModal(this.id);
                    }
                });
            });

            // Close modal when pressing Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-overlay.show').forEach(modal => {
                        hideModal(modal.id);
                    });
                }
            });

            // Order Details button click handler
            document.querySelectorAll('.order-details').forEach(button => {
                button.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const orderCard = this.closest('.order-card');
                    if (!orderCard) {
                        console.error('Order card not found');
                        return;
                    }
                    
                    const orderId = orderCard.dataset.orderId;
                    if (!orderId) {
                        console.error('Order ID not found in data attributes');
                        showNotification('Order ID is missing', 'error');
                        return;
                    }
                    
                    console.log('Order details button clicked for order:', orderId);
                    
                    try {
                        const response = await fetch(`/user/orders/${orderId}`);
                        if (!response.ok) {
                            throw new Error('Failed to fetch order details');
                        }
                        
                        const data = await response.json();
                        if (!data.success) {
                            throw new Error(data.message || 'Failed to load order details');
                        }

                        const order = data.data;
                        if (!order) {
                            throw new Error('Order not found');
                        }

                        // Create order details content
                        const content = `
                            <div class="order-info">
                                <h4>Order #${order._id}</h4>
                                <p><strong>Status:</strong> <span class="status-${order.status.toLowerCase()}">${order.status}</span></p>
                                <p><strong>Order Date:</strong> ${new Date(order.createdAt).toLocaleDateString()}</p>
                                <p><strong>Estimated Delivery:</strong> ${order.estimatedDelivery || 'Not available'}</p>
                            </div>
                            
                            <div class="order-summary">
                                <h5>Order Summary</h5>
                                <div class="summary-grid">
                                    <div><strong>Subtotal:</strong></div>
                                    <div>$${order.total.toFixed(2)}</div>
                                    <div><strong>Shipping:</strong></div>
                                    <div>$${order.shippingCost?.toFixed(2) || '0.00'}</div>
                                    <div><strong>Tax:</strong></div>
                                    <div>$${order.tax?.toFixed(2) || '0.00'}</div>
                                    <div><strong>Total:</strong></div>
                                    <div>$${order.total.toFixed(2)}</div>
                                </div>
                            </div>
                            
                            <div class="order-products">
                                <h5>Products</h5>
                                ${order.items.map(item => `
                                    <div class="order-product-detail">
                                        <img src="${item.product && item.product.image ? item.product.image : '/Assets/Images/product-placeholder.jpg'}" alt="${item.product && item.product.name ? item.product.name : 'Product'}">
                                        <div>
                                            <h5>${item.product && item.product.name ? item.product.name : 'Unknown Product'}</h5>
                                            <p>Qty: ${item.quantity || 1}</p>
                                            <p>Price: $${item.price?.toFixed(2) || '0.00'}</p>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            
                            <div class="shipping-details">
                                <h5>Shipping Details</h5>
                                <p><strong>Name:</strong> ${order.shipping?.name || 'N/A'}</p>
                                <p><strong>Address:</strong> ${order.shipping?.address || 'N/A'}</p>
                                <p><strong>City:</strong> ${order.shipping?.city || 'N/A'}</p>
                                <p><strong>State:</strong> ${order.shipping?.state || 'N/A'}</p>
                                <p><strong>ZIP Code:</strong> ${order.shipping?.zipCode || 'N/A'}</p>
                            </div>
                            
                            <div class="payment-details">
                                <h5>Payment Details</h5>
                                <p><strong>Payment Method:</strong> <span class="payment-method">
                                    <i class="fab fa-cc-${order.payment?.bankName?.toLowerCase() || 'credit-card'}"></i> 
                                    ${order.payment?.bankName || 'Credit Card'} ending in ${order.payment?.cardNumber || '****'}
                                </span></p>
                                <p><strong>Cardholder:</strong> ${order.payment?.name || 'N/A'}</p>
                                <p><strong>Expiry:</strong> ${order.payment?.expiry || 'N/A'}</p>
                            </div>
                        `;

                        // Update modal content and show it
                        const modalBody = document.querySelector('#orderDetailsModal .modal-body');
                        if (modalBody) {
                            modalBody.innerHTML = content;
                            showModal('orderDetailsModal');
                        } else {
                            console.error('Modal body not found');
                        }
                    } catch (error) {
                        console.error('Error loading order details:', error);
