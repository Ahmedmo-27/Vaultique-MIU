<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title><%= user?.Name || 'User' %> | Vaultique Account Details & Profile</title>
    <meta name="description" content="Manage your Vaultique account details, orders, wishlist, and preferences. View order history, update personal information, and manage your luxury watch collection.">
    <meta name="keywords" content="Vaultique account, user profile, order history, wishlist management, account settings, luxury watch account, Vaultique profile">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="noindex, nofollow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="<%= user?.Name || 'User' %> | Vaultique Account Details & Profile">
    <meta property="og:description" content="Manage your Vaultique account details, orders, wishlist, and preferences. View order history and update personal information.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/user/account">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= user?.Name || 'User' %> | Vaultique Account Details & Profile">
    <meta name="twitter:description" content="Manage your Vaultique account details, orders, wishlist, and preferences. View order history and update personal information.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/user/account">
    
    <link rel="icon" type="image/x-icon" href="/Assets/Images/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/Account-Details.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Vaultique Account Details",
        "description": "User account management page for Vaultique luxury watch platform",
        "url": "https://vaultique.live/user/account",
        "mainEntity": {
            "@type": "Person",
            "name": "<%= user?.Name || 'User' %>",
            "email": "<%= user?.email || '' %>",
            "memberOf": {
                "@type": "Organization",
                "name": "Vaultique"
            }
        }
    }
    </script>
    
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Account-Details.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <script type="application/json" id="userData"><%- JSON.stringify(user || {}) %></script>
    <script type="application/json" id="wishlistData"><%- JSON.stringify(user?.wishlist?.filter(item => item.product).map(item => item.product) || []) %></script>
</head>
<body>

    <%- include('partials/loading-screen') %>

    <%- include('partials/navigation') %>
   
    <div class="account-container">
        <div class="sidebar">
            <div class="sidebar-item active" data-tab="personal-info">
                <i class="fas fa-user"></i>
                <span data-translate="personalInfo">Personal Information</span>
            </div>
            <div class="sidebar-item" data-tab="addresses">
                <i class="fas fa-map-marker-alt"></i>
                <span data-translate="myAddresses">My Addresses</span>
            </div>
            <div class="sidebar-item" data-tab="orders">
                <i class="fas fa-box"></i>
                <span data-translate="myOrders">My Orders</span>
            </div>
            <div class="sidebar-item" data-tab="wishlist">
                <i class="fas fa-heart"></i>
                <span data-translate="myWishlist">My Wishlist</span>
            </div>
            <div class="sidebar-item" data-tab="refunds">
                <i class="fas fa-undo"></i>
                <span data-translate="myRefunds">My Refunds</span>
            </div>
            <div class="sidebar-item" data-tab="payment-methods">
                <i class="fas fa-credit-card"></i>
                <span data-translate="paymentMethods">Payment Methods</span>
            </div>
            <div class="sidebar-item" data-tab="reviews">
                <i class="fas fa-star"></i>
                <span data-translate="myReviews">My Reviews</span>
            </div>
            <div class="sidebar-item" data-tab="logout">
                <i class="fas fa-sign-out-alt"></i>
                <span data-translate="logout">Logout</span>
            </div>
        </div>
        
        <div class="main-content">
            <!-- Personal Information Tab (Default Active) -->
            <div class="tab-content active" id="personal-info">
                <div class="section-title" data-translate="accountSettings">Account Settings</div>
                
                <div class="form-group">
                    <label class="form-label" data-translate="fullName">Full Name</label>
                    <div class="form-value"><%= user?.Name || '<span data-translate="notProvided">Not provided</span>' %></div>
                </div>
                
                <div class="form-group">
                    <label class="form-label" data-translate="email">Email</label>
                    <div class="form-value"><%= user?.email || '<span data-translate="notProvided">Not provided</span>' %></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label" data-translate="password">Password</label>
                    <div class="form-value">********** <a href="#" class="edit-link" id="changePasswordLink" data-translate="changePassword">Change Password</a></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label" data-translate="dob">Date of Birth</label>
                    <div class="form-value"><%= user?.DOB ? new Date(user.DOB).toLocaleDateString() : '<span data-translate="notProvided">Not provided</span>' %></div>
                </div>
    
                <div class="form-group">
                    <label class="form-label" data-translate="phoneNumber">Phone Number</label>
                    <div class="phone-input-container">
                        <select id="countrySelect" class="country-select">
                            <option value="20">+20 (Egypt)</option>
                            <option value="1">+1 (USA/Canada)</option>
                            <option value="44">+44 (UK)</option>
                            <option value="971">+971 (UAE)</option>
                            <option value="966">+966 (Saudi Arabia)</option>
                        </select>
                        <input id="phoneNumber" type="tel" value="<%= user?.phone_number || '' %>" placeholder="Enter your phone number">
                    </div>
                </div>
    
                <div class="form-group">
                    <label class="form-label" data-translate="preferredLanguage">Preferred Language</label>
                    <select id="languageSelect">
                        <option value="English" <%= user?.language === 'English' ? 'selected' : '' %>>English</option>
                        <option value="Arabic" <%= user?.language === 'Arabic' ? 'selected' : '' %>>Arabic</option>
                    </select>
                </div>
            </div>
            
            <!-- Addresses Tab -->
            <div class="tab-content" id="addresses">
                <div class="section-title" data-translate="myAddresses">My Addresses</div>
                
                <div class="address-list">
                    <% if (user?.Address) { %>
                        <div class="address-card default">
                            <div class="address-header">
                                <h4 data-translate="addressType"><%= user.Address.addressType || 'Home' %> Address</h4>
                                <span class="default-badge" data-translate="default">Default</span>
                            </div>
                            <p><%= user.Address.street || 'No street provided' %></p>
                            <p><%= user.Address.city || '' %><%= user.Address.city && user.Address.state ? ', ' : '' %><%= user.Address.state || '' %></p>
                            <p><%= user.Address.country || '' %></p>
                            <div class="address-actions">
                                <button class="edit-address" data-translate="edit">Edit</button>
                                <button class="remove-address" data-translate="remove">Remove</button>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="no-addresses">
                            <p data-translate="noAddresses">No addresses have been added yet.</p>
                        </div>
                    <% } %>
                    
                    <button class="add-address-btn" data-translate="addNewAddress">
                        <i class="fas fa-plus"></i> Add New Address
                    </button>
                </div>
            </div>
            
            <!-- Orders Tab -->
            <div class="tab-content" id="orders">
                <div class="section-title" data-translate="myOrders">My Orders</div>
                
                <div class="order-filters">
                    <select id="orderFilter">
                        <option value="all" data-translate="allOrders">All Orders</option>
                        <option value="pending" data-translate="pending">Pending</option>
                        <option value="shipped" data-translate="shipped">Shipped</option>
                        <option value="delivered" data-translate="delivered">Delivered</option>
                        <option value="cancelled" data-translate="cancelled">Cancelled</option>
                    </select>
                    <input type="text" placeholder="Search orders..." id="orderSearch" data-translate="searchOrdersPlaceholder">
                </div>
                
                <div class="orders-list">
                    <% if (user?.orders && user.orders.length > 0) { %>
                        <% user.orders.forEach(order => { %>
                            <div class="order-card" data-order-id="<%= order.orderId %>">
                                <div class="order-header">
                                    <div class="order-id" data-translate="orderNumber">Order #<%= order.orderNumber %></div>
                                    <div class="order-date" data-translate="placedOn">Placed on <%= new Date(order.orderDate).toLocaleDateString() %></div>
                                    <div class="order-status <%= order.status %>" data-translate="orderStatus"><%= order.status %></div>
                                    <div class="order-total" data-translate="orderTotal">$<%= order.total %></div>
                                </div>
                                <div class="order-products">
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach(item => { %>
                                            <div class="order-product-detail">
                                                <img src="<%= item.product && item.product.image ? (item.product.image.startsWith('/') ? item.product.image : `/Assets/Images/Watches/${item.product.image}`) : '/Assets/Images/product-placeholder.jpg' %>" 
                                                     alt="<%= item.product && item.product.name ? item.product.name : 'Product' %>">
                                                <div>
                                                    <h5><%= item.product && item.product.name %></h5>
                                                    <p data-translate="brand">Brand: <%= item.productDetails && item.productDetails.brand ? item.productDetails.brand : 'N/A' %></p>
                                                    <p data-translate="qty">Qty: <%= item.quantity %></p>
                                                    <p data-translate="price">Price: $<%= item.price ? item.price.toFixed(2) : '0.00' %></p>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                                <div class="order-actions">
                                    <% if (order.status === 'Shipped') { %>
                                        <button class="track-order" data-translate="trackOrder">Track Order</button>
                                    <% } else if (order.status === 'Delivered') { %>
                                        <button class="buy-again" data-translate="buyAgain">Buy Again</button>
                                    <% } %>
                                    <button class="order-details" data-order-id="<%= order.orderId %>" data-translate="viewDetails">View Details</button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="no-orders">
                            <p data-translate="noOrders">You haven't placed any orders yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Wishlist Tab -->
            <div class="tab-content" id="wishlist">
                <div class="section-title" data-translate="myWishlist">My Wishlist</div>
                <% const wishlistItems = user?.wishlist?.filter(item => item.product).map(item => item.product) || []; %>
                <div class="wishlist-grid" id="wishlistGrid">
                    <% if (wishlistItems && wishlistItems.length > 0) { %>
                        <% wishlistItems.forEach(product => { %>
                            <div class="product-card" data-product-id="<%= product._id %>">
                                <div class="product-image-container">
                                    <div class="wishlist-icon remove-item" data-product-id="<%= product._id %>">
                                        <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                        </svg>
                                    </div>
                                    <a href="/user/product?id=<%- product._id %>">
                                        <img src="<%= product.image ? (product.image.startsWith('/') ? product.image : `/Assets/Images/Watches/${product.image}`) : '/Assets/Images/product-placeholder.jpg' %>" alt="<%- product.name %>" loading="lazy">
                                    </a>
                                    <div class="hover-buttons">
                                        <button class="quick-view" data-product-id="<%= product._id %>">Quick View</button>
                                        <button class="compare" data-product-id="<%= product._id %>">Compare</button>
                                    </div>
                                </div>
                                <div class="product-details">
                                    <h4><%- product.name %></h4>
                                    <div class="product-meta">
                                        <p class="price">$ <%= (product.price || 0).toLocaleString() %></p>
                                    </div>
                                    <div class="product-status">
                                        <% if (product.stock || (product.stockCount && product.stockCount > 0)) { %>
                                            <p class="stock in-stock">In Stock</p>
                                        <% } else { %>
                                            <p class="stock out-of-stock">Out of Stock</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-wishlist">
                            <i class="far fa-heart"></i>
                            <h2>Your wishlist is empty</h2>
                            <p>Start adding products to your wishlist by clicking the heart icon on any product.</p>
                            <a href="/user/products" class="browse-products-btn">Browse Products</a>
                        </div>
                    <% } %>
                </div>

                <!-- Loading Spinner -->
                <div class="wishlist-loading" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </div>
            
            <!-- Refunds Tab -->
            <div class="tab-content" id="refunds">
                <div class="section-title" data-translate="myRefunds">My Refunds</div>
                
                <div class="refunds-list">
                    <% if (user?.refunds && user.refunds.length > 0) { %>
                        <% user.refunds.forEach(refund => { %>
                            <div class="refund-card <%= refund.status.toLowerCase() %>">
                                <div class="refund-header">
                                    <div class="refund-id">Refund #<%= refund.refundId %></div>
                                    <div class="refund-status"><%= refund.status %></div>
                                </div>
                                <div class="refund-details">
                                    <% if (refund.order && refund.order.orderId) { %>
                                        <p><strong>Order:</strong> #<%= refund.order.orderId %> 
                                            <% if (refund.order.items && refund.order.items.length > 0 && refund.order.items[0].product) { %>
                                                - <%= refund.order.items[0].product.name || 'Product' %>
                                            <% } %>
                                        </p>
                                    <% } %>
                                    <p><strong>Reason:</strong> <%= refund.reason || 'Not specified' %></p>
                                    <p><strong>Amount:</strong> $<%= refund.amount ? refund.amount.toFixed(2) : '0.00' %></p>
                                    <p><strong><%= refund.status === 'Pending' ? 'Requested' : 'Processed' %> on:</strong> <%= refund.date ? new Date(refund.date).toLocaleDateString() : 'Unknown date' %></p>
                                </div>
                                <div class="refund-actions">
                                    <button class="view-details">View Details</button>
                                    <% if (refund.status === 'Pending') { %>
                                        <button class="cancel-request" data-refund-id="<%= refund._id %>">Cancel Request</button>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="no-refunds">
                            <p>You haven't requested any refunds yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Payment Methods Tab -->
            <div class="tab-content" id="payment-methods">
                <div class="section-title" data-translate="paymentMethods">Payment Methods</div>
                
                <div class="payment-methods-list">
                    <% if (user?.Payment && user.Payment.cardNumber) { %>
                        <div class="payment-method-card default">
                            <div class="payment-method-header">
                                <div class="payment-method-type">
                                    <i class="fab fa-cc-<%= (user.Payment.paymentType && user.Payment.paymentType.toLowerCase().includes('visa')) ? 'visa' : 'mastercard' %>"></i>
                                    <span><%= user.Payment.paymentType || 'Credit Card' %></span>
                                </div>
                                <span class="default-badge">Default</span>
                            </div>
                            <div class="payment-method-details">
                                <p>**** **** **** <%= user.Payment.cardNumber.slice(-4) %></p>
                                <p>Expires <%= user.Payment.expiryDate || 'N/A' %></p>
                            </div>
                            <div class="payment-method-actions">
                                <button class="edit-method">Edit</button>
                                <button class="remove-method">Remove</button>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="no-payment-methods">
                            <p>No payment methods added yet.</p>
                        </div>
                    <% } %>
                    
                    <button class="add-payment-method">
                        <i class="fas fa-plus"></i> Add New Payment Method
                    </button>
                </div>
            </div>
            
            <!-- Reviews Tab -->
            <div class="tab-content" id="reviews">
                <div class="section-title" data-translate="myReviews">My Reviews</div>
                
                <div class="reviews-list">
                    <% if (user?.reviews && user.reviews.length > 0) { %>
                        <% user.reviews.forEach(review => { %>
                            <% if (review && review.product) { %>
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="review-product">
                                            <img src="<%= review.product.image || '/Assets/Images/product-placeholder.jpg' %>" alt="<%= review.product.name || 'Product' %>">
                                            <h5><%= review.product.name || 'Unknown Product' %></h5>
                                        </div>
                                        <div class="review-rating">
                                            <div class="stars">
                                                <% for(let i = 1; i <= 5; i++) { %>
                                                    <i class="<%= i <= review.rating ? 'fas' : 'far' %> fa-star"></i>
                                                <% } %>
                                            </div>
                                            <div class="review-date"><%= review.date ? new Date(review.date).toLocaleDateString() : 'Unknown date' %></div>
                                        </div>
                                    </div>
                                    <div class="review-content">
                                        <h6><%= review.title || '' %></h6>
                                        <p><%= review.content || 'No content provided.' %></p>
                                    </div>
                                    <div class="review-actions">
                                        <button class="edit-review" data-review-id="<%= review._id %>">Edit Review</button>
                                        <button class="delete-review" data-review-id="<%= review._id %>">Delete</button>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                        <div class="no-reviews">
                            <p>You haven't written any reviews yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('partials/footer') %>

    <%- include('partials/notification', { 
        type: locals.type || 'info',
        message: locals.message || '',
        show: locals.show || false 
    }) %>

    <%- include('partials/modals') %>

    <!-- Quick View Modal -->
    <div id="quickViewModal" class="quick-view-modal">
        <button class="close-btn" id="closeQuickView">✖</button>
        <div class="quick-view-content">
            <% if (user?.wishlist && user.wishlist.length > 0) { %>
                <% user.wishlist.filter(item => item.product).forEach(item => { %>
                    <div class="product-quick-view" id="quickView-<%= item.product._id %>" style="display: none;">
                        <section class="product-gallery">
                            <div class="all_image">
                                <div class="main-image">
                                    <img src="<%= item.product.image ? (item.product.image.startsWith('/') ? item.product.image : `/Assets/Images/Watches/${item.product.image}`) : '/Assets/Images/product-placeholder.jpg' %>" 
                                         alt="<%= item.product.name %>">
                                </div>
                            </div>
                        </section>
                        
                        <div class="product-info">
                            <div class="product-header">
                                <h1><%= item.product.name %></h1>
                                <div class="product-meta">
                                    <div class="price-qv">$ <%= (item.product.price || 0).toLocaleString() %></div>
                                </div>
                            </div>
                            
                            <div class="product-actions">
                                <button class="wishlist-btn filled" data-product-id="<%= item.product._id %>">
                                    <i class="fas fa-heart"></i>
                                </button>
                                <button class="add-to-cart" data-product-id="<%= item.product._id %>">
                                    <i class="fas fa-shopping-bag"></i> Add to Cart
                                </button>
                                <button class="find-store">
                                    <i class="fas fa-map-marker-alt"></i> View 3D Model
                                </button>
                            </div>
                            
                            <div class="product-description">
                                <p><%= item.product.description || 'No description available' %></p>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
    <div id="quickViewOverlay" class="quick-view-overlay"></div>

    <!-- Modals Section -->
    <div id="modalsContainer">
        <!-- Order Details Modal -->
        <div id="orderDetailsModal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Order Details</h3>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <% if (user?.orders && user.orders.length > 0) { %>
                        <% user.orders.forEach(order => { %>
                            <div class="order-details-content" id="orderDetails-<%= order.orderId %>" style="display: none;">
                                <div class="order-info">
                                    <h4>Order Information</h4>
                                    <p><strong>Order Number:</strong> <%= order.orderNumber %></p>
                                    <p><strong>Date:</strong> <%= new Date(order.orderDate).toLocaleDateString() %></p>
                                    <p><strong>Status:</strong> <span class="status <%= order.status.toLowerCase() %>"><%= order.status %></span></p>
                                    <p><strong>Total:</strong> $<%= order.total %></p>
                                </div>
                                
                                <div class="shipping-info">
                                    <h4>Shipping Information</h4>
                                    <p><strong>Address:</strong> <%= order.shippingAddress?.street || 'N/A' %></p>
                                    <p><strong>City:</strong> <%= order.shippingAddress?.city || 'N/A' %></p>
                                    <p><strong>State:</strong> <%= order.shippingAddress?.state || 'N/A' %></p>
                                    <p><strong>Country:</strong> <%= order.shippingAddress?.country || 'N/A' %></p>
                                </div>
                                
                                <div class="order-items">
                                    <h4>Order Items</h4>
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach(item => { %>
                                            <div class="order-item">
                                                <img src="<%= item.product && item.product.image ? (item.product.image.startsWith('/') ? item.product.image : `/Assets/Images/Watches/${item.product.image}`) : '/Assets/Images/product-placeholder.jpg' %>" 
                                                     alt="<%= item.product && item.product.name ? item.product.name : 'Product' %>">
                                                <div class="item-details">
                                                    <h5><%= item.product && item.product.name %></h5>
                                                    <p data-translate="brand">Brand: <%= item.productDetails && item.productDetails.brand ? item.productDetails.brand : 'N/A' %></p>
                                                    <p data-translate="qty">Qty: <%= item.quantity %></p>
                                                    <p data-translate="price">Price: $<%= item.price ? item.price.toFixed(2) : '0.00' %></p>
                                                </div>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn">Close</button>
                    <button type="button" class="track-order-btn" style="display: none;">Track Order</button>
                </div>
            </div>
        </div>

        <!-- Tracking Modal -->
        <div id="trackingModal" class="modal-overlay">
            <div class="modal-container">
                <div class="modal-header">
                    <h3>Order Tracking</h3>
                    <button class="close-modal">&times;</button>
                </div>
                <div class="modal-body">
                    <!-- Content will be dynamically populated -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="cancel-btn">Close</button>
                </div>
            </div>
