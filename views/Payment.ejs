<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/images/logo.ico" />
    <link rel="stylesheet" href="/CSS/stylepayment.css" />
    <title> Vaultique | Secure Checkout </title>
  </head>
  <body>
    <br />
    <a href="/" class="logo" id="logo">Vaultique</a>
    <br />
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress"></div>
      </div>
      <div class="progress-steps">
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Payment</span>
        </div>
        <div class="step completed">
          <span class="circle">&#10003;</span>
          <span class="label">Shipping</span>
        </div>
        <div class="step active">
          <span class="circle"></span>
          <span class="label">Leave a review!</span>
        </div>
      </div>
    </div>

    <div class="form-container">
      <h2 class="form-title">Payment</h2>

      <!-- Guest Checkout Notice -->
      <% if (!isAuthenticated) { %>
        <div class="guest-notice">
          <i class="fas fa-info-circle"></i>
          <p>You're checking out as a guest. <a href="/user/LoginSignup">Sign in</a> to save your payment information for future purchases.</p>
        </div>
      <% } %>

      <!-- Cart Summary -->
      <div class="cart-summary">
        <h3>Order Summary</h3>
        <div class="cart-summary-item">
          <span>Subtotal:</span>
          <span>$<%= cart.subtotal.toFixed(2) %></span>
        </div>
        <div class="cart-summary-item">
          <span>Shipping:</span>
          <span>$<%= cart.shippingCost.toFixed(2) %></span>
        </div>
        <div class="cart-summary-item cart-summary-total">
          <span>Total:</span>
          <span>$<%= cart.total.toFixed(2) %></span>
        </div>
      </div>

      <!-- Payment Methods -->
      <div class="payment-methods">
        <h3>Select Payment Method</h3>
        <div class="payment-method">
          <input type="radio" id="credit-card" name="payment-method" value="credit-card" checked>
          <label for="credit-card">
            <i class="fas fa-credit-card"></i>
            Credit Card
          </label>
        </div>
      </div>

      <form id="payment-form" class="checkout-form">
        <div class="input-line">
          <label for="name">FULL NAME</label>
          <input
            type="text"
            name="name"
            id="name"
            placeholder="Your name and surname"
            value="<%= paymentInfo ? paymentInfo.name : '' %>"
            required
          />
        </div>
        <div class="input-line">
          <label for="card-number">Credit Card Number</label>
          <input
            type="text"
            name="card-number"
            id="card-number"
            placeholder="1234 5678 9012 3456"
            value="<%= paymentInfo ? paymentInfo.card_number : '' %>"
            maxlength="19"
            required
          />
        </div>

        <div class="input-line">
          <label for="bank-name">BANK NAME</label>
          <input
            type="text"
            name="bank-name"
            id="bank-name"
            placeholder="Your bank name"
            value="<%= paymentInfo ? paymentInfo.bank_name : '' %>"
            required
          />
        </div>

        <div class="input-container">
          <div class="input-line">
            <label for="cvv">CVV</label>
            <input
              type="text"
              name="cvv"
              id="cvv"
              placeholder="123"
              value=""
              maxlength="4"
              class="cvv-input"
              required
            />
            <p class="error" id="cvvError">
              Please enter a valid 3 or 4 digit CVV
            </p>
          </div>

          <div class="input-line">
            <label for="expiry">Expiry (MM/YY)</label>
            <input
              type="text"
              name="expiry"
              id="expiry"
              placeholder="MM/YY"
              value="<%= paymentInfo ? paymentInfo.expiry : '' %>"
              maxlength="5"
              class="expiry-input"
              required
            />
            <p class="error" id="expiryError">
              Please enter a valid expiry date in MM/YY format
            </p>
          </div>
        </div>

        <button type="button" class="flip-card-btn" id="flip-card-btn">
          View Card Details
        </button>

        <!-- 3D Flip Card Component -->
        <div class="card-flip-container">
          <div id="flip-card">
            <div id="flip-front">
              <div class="card-header">
                <div class="bank-name" id="display-bank-name">BANK NAME</div>
                <div class="card-holder" id="display-card-holder">
                  FULL NAME
                </div>
              </div>
              <div class="card-number" id="display-card-number">
                ################
              </div>
              <div class="card-footer">
                <div class="expiry-date" id="display-expiry">MM/YY</div>
              </div>
            </div>
            <div id="flip-back">
              <div class="card-stripe"></div>
              <div class="card-signature">Authorized Signature</div>
              <div class="card-cvv" id="display-cvv">CVV</div>
            </div>
          </div>
        </div>

        <!-- Complete Purchase Button -->
        <button type="submit" class="complete-purchase-btn">
          Complete purchase
        </button>

        <!-- Back to Cart Link -->
        <a href="/cart" class="back-to-cart">
          <i class="fas fa-arrow-left"></i> Back to Cart
        </a>
      </form>
    </div>

    <!-- Add Popup Elements -->
    <div id="login-message-popup" class="popup" style="display: none;">
      <div class="popup-content">
        <h2></h2>
      </div>
    </div>

    <div id="login-message-error-popup" class="popup error" style="display: none;">
      <div class="popup-content">
        <h2></h2>
      </div>
    </div>

    <script src="/Javascript/Checkout_scripting.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Real-time card preview
        const updateCardPreview = () => {
          const bankNameEl = document.getElementById('display-bank-name');
          const cardHolderEl = document.getElementById('display-card-holder');
          const cardNumberEl = document.getElementById('display-card-number');
          const expiryEl = document.getElementById('display-expiry');
          const cvvEl = document.getElementById('display-cvv');

          if (bankNameEl) bankNameEl.textContent = document.getElementById('bank-name')?.value || 'BANK NAME';
          if (cardHolderEl) cardHolderEl.textContent = document.getElementById('name')?.value || 'FULL NAME';
          if (cardNumberEl) cardNumberEl.textContent = document.getElementById('card-number')?.value || '################';
          if (expiryEl) expiryEl.textContent = document.getElementById('expiry')?.value || 'MM/YY';
          if (cvvEl) cvvEl.textContent = document.getElementById('cvv')?.value || 'CVV';
        };

        // Add event listeners for real-time updates
        ['name', 'card-number', 'bank-name', 'expiry', 'cvv'].forEach(id => {
          const element = document.getElementById(id);
          if (element) {
            element.addEventListener('input', updateCardPreview);
          }
        });

        // Card flip functionality
        const flipCardBtn = document.getElementById('flip-card-btn');
        const flipCard = document.getElementById('flip-card');
        if (flipCardBtn && flipCard) {
          flipCardBtn.addEventListener('click', () => {
            flipCard.classList.toggle('flipped');
          });
        }

        // Form submission
        const paymentForm = document.getElementById('payment-form');
        if (paymentForm) {
          paymentForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Get form values
            const name = document.getElementById('name')?.value;
            const cardNumber = document.getElementById('card-number')?.value.replace(/\s/g, '');
            const bankName = document.getElementById('bank-name')?.value;
            const expiry = document.getElementById('expiry')?.value;
            const cvv = document.getElementById('cvv')?.value;

            // Validate required fields
            if (!name || !cardNumber || !bankName || !expiry || !cvv) {
              alert('Please fill in all required fields');
              return;
            }

            // Validate card number
            if (!/^\d{16}$/.test(cardNumber)) {
              alert('Please enter a valid 16-digit card number');
              return;
            }

            // Validate expiry date
            if (!/^(0[1-9]|1[0-2])\/([0-9]{2})$/.test(expiry)) {
              alert('Please enter a valid expiry date (MM/YY)');
              return;
            }

            // Validate CVV
            if (!/^\d{3,4}$/.test(cvv)) {
              alert('Please enter a valid 3 or 4 digit CVV');
              return;
            }

            try {
              const response = await fetch('/api/payment/process', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  name,
                  card_number: cardNumber,
                  bank_name: bankName,
                  expiry,
                  cvv
                })
              });

              const data = await response.json();

              if (data.success) {
                const successPopup = document.getElementById('login-message-popup');
                if (successPopup) {
                  successPopup.style.display = 'flex';
                  successPopup.querySelector('h2').textContent = 'Payment information saved successfully!';
                  
                  // Wait for 2 seconds before redirecting
                  setTimeout(() => {
                    window.location.href = '/user/shipping';
                  }, 2000);
                }
              } else {
                const errorPopup = document.getElementById('login-message-error-popup');
                if (errorPopup) {
                  errorPopup.style.display = 'flex';
                  errorPopup.querySelector('h2').textContent = data.message || 'Payment failed. Please try again.';
                  
                  setTimeout(() => {
                    errorPopup.style.display = 'none';
                  }, 3000);
                }
              }
            } catch (error) {
              console.error('Payment error:', error);
              const errorPopup = document.getElementById('login-message-error-popup');
              if (errorPopup) {
                errorPopup.style.display = 'flex';
                errorPopup.querySelector('h2').textContent = 'An error occurred. Please try again.';
                
                setTimeout(() => {
                  errorPopup.style.display = 'none';
                }, 3000);
              }
            }
          });
        }
      });
    </script>
  </body>
</html>
