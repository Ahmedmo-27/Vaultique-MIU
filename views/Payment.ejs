<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title data-translate="paymentTitle">Vaultique | Secure Payment & Checkout - Luxury Watch Purchase</title>
    <meta name="description" content="Complete your luxury watch purchase securely at Vaultique. Multiple payment options, SSL encryption, and secure checkout process. Buy premium Swiss timepieces with confidence.">
    <meta name="keywords" content="secure payment, luxury watch checkout, Swiss watch purchase, secure checkout, payment gateway, Vaultique payment, luxury watch payment">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="noindex, nofollow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Vaultique | Secure Payment & Checkout - Luxury Watch Purchase">
    <meta property="og:description" content="Complete your luxury watch purchase securely at Vaultique. Multiple payment options, SSL encryption, and secure checkout process.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/user/payment">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Vaultique | Secure Payment & Checkout - Luxury Watch Purchase">
    <meta name="twitter:description" content="Complete your luxury watch purchase securely at Vaultique. Multiple payment options, SSL encryption, and secure checkout process.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/user/payment">
    
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link rel="stylesheet" href="/CSS/stylepayment.css" />
    <link rel="stylesheet" href="/CSS/stripe-payment.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Vaultique Secure Payment",
        "description": "Secure payment and checkout page for luxury watch purchases",
        "url": "https://vaultique.live/user/payment",
        "mainEntity": {
            "@type": "CheckoutPage",
            "name": "Secure Checkout",
            "description": "Complete your luxury watch purchase with secure payment processing"
        }
    }
    </script>
  </head>
  <body>
    <br />
    <a href="/" class="logo" id="logo" data-translate="vaultique">Vaultique</a>
    <br />
    
    <div class="progress-container">
      <div class="progress-bar">
        <div class="progress" style="width: 33%;"></div>
      </div>
      <div class="progress-steps">
        <div class="step active" aria-current="step">
          <span class="circle">1</span>
          <span class="label" data-translate="payment">Payment</span>
        </div>
        <div class="step">
          <span class="circle">2</span>
          <span class="label" data-translate="shipping">Shipping</span>
        </div>
        <div class="step">
          <span class="circle">3</span>
          <span class="label" data-translate="leaveReview">Leave a review!</span>
        </div>
      </div>
    </div>

    <div class="payment-container">
      <div class="payment-header">
        <h1>Secure Payment</h1>
        <p>Complete your purchase with confidence</p>
      </div>

      <div class="payment-content">
        <!-- Order Summary -->
        <div class="order-summary">
          <h3>Order Summary</h3>
          <div class="summary-items">
            <% if (cart && cart.items && cart.items.length) { %>
              <% cart.items.forEach(item => { %>
                <div class="summary-item">
                  <img src="<%= item.image %>" alt="<%= item.name %>">
                  <div class="item-details">
                    <h4><%= item.name %></h4>
                    <p>Qty: <%= item.quantity %></p>
                  </div>
                  <div class="item-price">$<%= (item.price * item.quantity).toFixed(2) %></div>
                </div>
              <% }); %>
            <% } else { %>
              <p class="empty-cart-message">Your cart is empty. <a href="/cart">Continue shopping</a>.</p>
            <% } %>
          </div>
          
          <div class="summary-totals">
            <div class="total-line">
              <span>Subtotal:</span>
              <span>$<%= Number(cart?.subtotal || 0).toFixed(2) %></span>
            </div>
            <div class="total-line">
              <span>Shipping:</span>
              <span>$<%= Number(cart?.shippingCost || 0).toFixed(2) %></span>
            </div>
            <div class="total-line">
              <span>Tax:</span>
              <span>$<%= Number(cart?.tax || 0).toFixed(2) %></span>
            </div>
            <div class="total-line total">
              <span>Total:</span>
              <span>$<%= Number(cart?.total || 0).toFixed(2) %></span>
            </div>
          </div>
        </div>

        <!-- Payment Form -->
        <div class="payment-form-container">
          <h3>Payment Information</h3>
          
          <!-- Guest Checkout Notice -->
          <% if (!isAuthenticated) { %>
            <div class="guest-notice">
              <i class="fas fa-info-circle"></i>
              <p>You're checking out as a guest. <a href="/user/LoginSignup">Sign in</a> to save your payment information for future purchases.</p>
            </div>
          <% } %>
          
          <!-- Saved Payment Methods (for logged-in users) -->
          <% if (isAuthenticated) { %>
            <div class="saved-payment-methods">
              <h4>Saved Payment Methods</h4>
              <div id="saved-payment-methods">
                <p>Loading saved payment methods...</p>
              </div>
              <div class="divider">
                <span>or</span>
              </div>
            </div>
          <% } %>

          <!-- Stripe Payment Form -->
          <form id="payment-form">
            <div id="payment-element">
              <!-- Stripe Elements will be mounted here -->
            </div>
            
            <div id="payment-error" class="error-message" style="display: none;" aria-live="assertive"></div>
            <div id="payment-success" class="success-message" style="display: none;" aria-live="polite"></div>
            
            <button type="submit" id="submit-payment" class="pay-button">
              <span class="button-text">Pay $<%= Number(cart?.total || 0).toFixed(2) %></span>
              <div class="spinner" id="spinner" style="display: none;"></div>
            </button>
          </form>

          <!-- Loading Message -->
          <div id="loading-message" class="loading-message" style="display: none;"></div>

          <!-- Security Notice -->
          <div class="security-notice">
            <i class="fas fa-shield-alt"></i>
            <p>Your payment information is secured by Stripe's industry-standard encryption. We never store your card details.</p>
          </div>
        </div>
      </div>

      <!-- Back to Cart Link -->
      <div class="back-to-cart">
        <a href="/cart" class="back-link">
          <i class="fas fa-arrow-left"></i> Back to Cart
        </a>
      </div>
    </div>

    <!-- Hidden inputs for authentication status -->
    <input type="hidden" id="isAuthenticated" value="<%= !!isAuthenticated %>">
    <% if (isAuthenticated) { %>
      <input type="hidden" id="userId" value="<%= user._id %>">
    <% } %>

    <!-- Stripe Configuration -->
    <script>
      const stripePublishableKey = '<%= stripePublishableKey %>';
    </script>
    
    <!-- Load Stripe.js -->
    <script src="https://js.stripe.com/v3/"></script>
    <script src="/Javascript/stripe-payment.js"></script>
  </body>
</html>
