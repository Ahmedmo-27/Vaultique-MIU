<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-translate="compareTitle">Compare Products</title>
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css" />
    <link rel="stylesheet" href="/CSS/footer.css" />
    <link rel="stylesheet" href="/CSS/product-type.css" />
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <script src="/Javascript/Light-Mode.js"></script>
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/image-zoom.js"></script>
    <style>
        .comparison-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            padding-top: calc(180px + 2rem);
            background-color: #e8d9c4;
            color: #050a30;
        }

        body.dark-mode .comparison-container {
            background-color: #1C2E4A;
            color: #e8d9c4;
        }

        .comparison-container h1 {
            font-family: "futura pt", sans-serif;
            font-size: 2.5rem;
            margin-bottom: 2rem;
            color: #050a30;
        }

        body.dark-mode .comparison-container h1 {
            color: #e8d9c4;
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        body.dark-mode .comparison-table {
            background-color: #2a3f5f;
        }

        .comparison-table th,
        .comparison-table td {
            border: 1px solid #ddd;
            padding: 1.5rem;
            text-align: left;
        }

        body.dark-mode .comparison-table th,
        body.dark-mode .comparison-table td {
            border-color: #3d4f6d;
        }

        .comparison-table th {
            background-color: #f5f5f5;
            font-weight: bold;
            font-family: "futura pt", sans-serif;
            color: #050a30;
        }

        body.dark-mode .comparison-table th {
            background-color: #1C2E4A;
            color: #e8d9c4;
        }

        .product-image {
            width: 200px;
            height: 200px;
            object-fit: contain;
            border-radius: 8px;
            transition: transform 0.3s ease;
        }

        .product-image:hover {
            transform: scale(1.05);
        }

        .product-name {
            font-size: 1.2em;
            font-weight: bold;
            margin: 1rem 0;
            font-family: "futura pt", sans-serif;
            color: #050a30;
        }

        body.dark-mode .product-name {
            color: #e8d9c4;
        }

        .product-price {
            color: #050a30;
            font-size: 1.3em;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        body.dark-mode .product-price {
            color: #e8d9c4;
        }

        .remove-from-compare {
            color: #e44d26;
            cursor: pointer;
            text-decoration: none;
            font-family: "futura pt", sans-serif;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: color 0.3s ease;
        }

        .remove-from-compare:hover {
            color: #ff6b4a;
        }

        .empty-state {
            text-align: center;
            padding: 4rem;
            color: #666;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        body.dark-mode .empty-state {
            background-color: #2a3f5f;
            color: #e8d9c4;
        }

        .empty-state h2 {
            font-family: "futura pt", sans-serif;
            font-size: 2rem;
            margin-bottom: 1rem;
            color: #050a30;
        }

        body.dark-mode .empty-state h2 {
            color: #e8d9c4;
        }

        .empty-state p {
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        .add-to-compare {
            display: inline-block;
            padding: 1rem 2rem;
            background-color: #050a30;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            font-family: "futura pt", sans-serif;
            transition: background-color 0.3s ease;
        }

        .add-to-compare:hover {
            background-color: #1a2a4a;
        }

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .feature-list li {
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .feature-list strong {
            color: #050a30;
        }

        body.dark-mode .feature-list strong {
            color: #e8d9c4;
        }

        @media (max-width: 768px) {
            .comparison-container {
                padding: 1rem;
                padding-top: calc(180px + 1rem);
            }

            .comparison-table {
                display: block;
                overflow-x: auto;
            }

            .product-image {
                width: 150px;
                height: 150px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/loading-screen') %>
    <%- include('partials/navigation') %>

    <div class="comparison-container">
        <h1 data-translate="compareProducts">Compare Products</h1>
        
        <% if (products && products.length > 0) { %>
            <table class="comparison-table">
                <tr>
                    <th data-translate="image">Image</th>
                    <% products.forEach(product => { %>
                        <td>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
                            <div class="product-name"><%= product.name %></div>
                            <div class="product-price">€<%= product.price.toLocaleString() %></div>
                            <a href="#" class="remove-from-compare" data-product-id="<%= product._id %>">
                                <i class="fas fa-times"></i> <span data-translate="remove">Remove</span>
                            </a>
                        </td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="brand">Brand</th>
                    <% products.forEach(product => { %>
                        <td><%= product.brand || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="strapMaterial">Strap Material</th>
                    <% products.forEach(product => { %>
                        <td><%= product.strapMaterial || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="movement">Movement</th>
                    <% products.forEach(product => { %>
                        <td><%= product.movement || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="waterResistance">Water Resistance</th>
                    <% products.forEach(product => { %>
                        <td><%= product.waterResistance || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="caseMaterial">Case Material</th>
                    <% products.forEach(product => { %>
                        <td><%= product.caseMaterial || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="dialColor">Dial Color</th>
                    <% products.forEach(product => { %>
                        <td><%= product.dialColor || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="collection">Collection</th>
                    <% products.forEach(product => { %>
                        <td><%= product.Vcollection || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="gender">Gender</th>
                    <% products.forEach(product => { %>
                        <td><%= product.gender || 'N/A' %></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="stockStatus">Stock Status</th>
                    <% products.forEach(product => { %>
                        <td><span data-translate="<%= product.stock ? 'inStock' : 'outOfStock' %>"><%= product.stock ? 'In Stock' : 'Out of Stock' %></span></td>
                    <% }); %>
                </tr>
                <tr>
                    <th data-translate="specialFeatures">Special Features</th>
                    <% products.forEach(product => { %>
                        <td>
                            <% if (product.specialFeatures && product.specialFeatures.length > 0) { %>
                                <ul class="feature-list">
                                    <% product.specialFeatures.forEach(feature => { %>
                                        <li><strong><%= feature.featureName %>:</strong> <%= feature.featureDesc %></li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <span data-translate="noSpecialFeatures">No special features</span>
                            <% } %>
                        </td>
                    <% }); %>
                </tr>
            </table>
        <% } else { %>
            <div class="empty-state">
                <h2 data-translate="noProductsToCompare">No Products to Compare</h2>
                <p data-translate="addProductsToCompare">Add products to your comparison list to see them side by side.</p>
                <a href="/products" class="add-to-compare" data-translate="browseProducts">Browse Products</a>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>

    <script>
        // Remove from comparison functionality
        document.querySelectorAll('.remove-from-compare').forEach(button => {
            button.addEventListener('click', async (e) => {
                e.preventDefault();
                const productId = button.getAttribute('data-product-id');
                try {
                    const response = await fetch(`/user/compare/remove/${productId}`, {
                        method: 'DELETE'
                    });
                    const data = await response.json();
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.message || 'Failed to remove product from comparison');
                    }
                } catch (error) {
                    console.error('Error removing from comparison:', error);
                    alert('An error occurred while removing from comparison');
                }
            });
        });
    </script>
    <!-- ملفات الترجمة -->
    <script src="/Javascript/translations.js"></script>
    <script src="/Javascript/language.js"></script>
</body>
</html> 