    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const modelViewer = document.querySelector('#watch-model');
            const modelSelect = document.querySelector('#model-selector');
            const rotateBtn = document.getElementById('toggle-rotate');
            const resetBtn = document.getElementById('reset-camera');
            const fullscreenBtn = document.getElementById('fullscreen');
            const totalPrice = document.getElementById('total-price');
            
            // Material mappings for different watch models
            const materialMappings = {
                'Omega Sea Master': {
                    strap: ['Strap_MORK.001'],
                    case: ['Screws'],
                    bezel: ['Urtavla_PrimarOpaqueTEXT.001'],
                    numerals: ['Siffor+Kvartar_UrtavlaFYLL.001'],
                    dial: ['Brushed Aluminum 2.001'],
                    clasp: ['Brushed Aluminum 2']
                },
                'Rolex Daytona': {
                    strap: ['Bracelet', 'Bracelet_Links'],
                    case: ['Case', 'Case_Metal'],
                    bezel: ['Bezel', 'Bezel_Insert'],
                    dial: ['Dial', 'Dial_Base'],
                    numerals: ['Numerals', 'Hour_Markers']
                }
            };

            // Color mappings for different materials and components
            const colorMappings = {
                black: [0.0, 0.0, 0.0, 1.0],
                white: [1.0, 1.0, 1.0, 1.0],
                silver: [0.75, 0.75, 0.75, 1.0],
                gold: [1.0, 0.84, 0.0, 1.0],
                'rose-gold': [0.72, 0.45, 0.2, 1.0],
                brown: [0.55, 0.27, 0.07, 1.0],
                navy: [0.0, 0.0, 0.5, 1.0]
            };

            // Current colors state
            let currentColors = {
                strap: 'black',
                case: 'silver',
                bezel: 'silver',
                dial: 'black',
                numerals: 'white'
            };

            // Toggle auto-rotation
            rotateBtn.addEventListener('click', () => {
                modelViewer.autoRotate = !modelViewer.autoRotate;
                rotateBtn.classList.toggle('active');
            });

            // Reset camera
            resetBtn.addEventListener('click', () => {
                modelViewer.cameraOrbit = '0deg 75deg 105%';
                modelViewer.fieldOfView = '45deg';
            });

            // Toggle fullscreen
            fullscreenBtn.addEventListener('click', () => {
                if (document.fullscreenElement) {
                    document.exitFullscreen();
                } else {
                    modelViewer.requestFullscreen();
                }
            });

            // Model loading progress
            modelViewer.addEventListener('progress', (event) => {
                const progressBar = document.querySelector('.progress-bar');
                progressBar.style.setProperty('--progress', event.detail.totalProgress * 100 + '%');
            });

            // Model loaded successfully
            modelViewer.addEventListener('load', () => {
                console.log('3D model loaded successfully');
                // Apply initial colors for all components
                Object.entries(currentColors).forEach(([component, color]) => {
                    updateModelComponent(component, color);
                });
            });

            // Error handling
            modelViewer.addEventListener('error', (error) => {
                console.error('Error loading 3D model:', error);
            });

            // Handle model selection change
            modelSelect.addEventListener('change', function() {
                const selectedModel = this.value;
                modelViewer.src = selectedModel;
            });

            // Add color selection for all components
            const colorOptions = document.querySelectorAll('.color-option');
            colorOptions.forEach(option => {
                option.addEventListener('click', () => {
                    const color = option.dataset.color;
                    const section = option.closest('.customization-section');
                    const component = section.querySelector('h3').textContent.toLowerCase().replace(' color', '');
                    
                    // Remove active class from all color options in this section
                    section.querySelectorAll('.color-option').forEach(opt => opt.classList.remove('active'));
                    option.classList.add('active');

                    // Update the current color for the component
                    currentColors[component] = color;

                    // Update the model based on the component
                    updateModelComponent(component, color);

                    // Update summary
                    document.querySelector(`#summary-${component}`).textContent = 
                        color.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

                    // Update price
                    updateTotalPrice();
                });
            });

            function updateModelComponent(component, color) {
                if (!modelViewer.model || !modelViewer.model.materials) {
                    console.log('Model or materials not yet loaded');
                    return;
                }

                try {
                    const currentModel = modelSelect.options[modelSelect.selectedIndex].text;
                    const mappings = materialMappings[currentModel] || materialMappings['Omega Sea Master'];
                    const componentMaterials = mappings[component] || [];

                    modelViewer.model.materials.forEach((material, index) => {
                        if (!material || !material.name) return;

                        const materialName = material.name;
                        const shouldUpdate = componentMaterials.some(name => materialName === name);

                        if (shouldUpdate) {
                            if (material.pbrMetallicRoughness) {
                                material.pbrMetallicRoughness.setBaseColorFactor(colorMappings[color] || colorMappings.black);
                                
                                // Adjust material properties based on color and component
                                if (color === 'silver' || color === 'gold' || color === 'rose-gold') {
                                    material.pbrMetallicRoughness.setMetallicFactor(0.8);
                                    material.pbrMetallicRoughness.setRoughnessFactor(0.3);
                                } else {
                                    material.pbrMetallicRoughness.setMetallicFactor(0.0);
                                    material.pbrMetallicRoughness.setRoughnessFactor(0.5);
                                }
                            }
                        }
                    });
                } catch (error) {
                    console.error('Error updating material:', error);
                }
            }

            // Price calculation
            function updateTotalPrice() {
                const basePrice = 8500;
                const priceAdjustments = {
                    case: {
                        'silver': 0,
                        'gold': 2000,
                        'rose-gold': 2500,
                        'black': 1500
                    },
                    bezel: {
                        'silver': 0,
                        'gold': 1000,
                        'rose-gold': 1500,
                        'black': 800
                    }
                };

                let totalPrice = basePrice;
                
                // Add case price adjustment
                if (priceAdjustments.case[currentColors.case]) {
                    totalPrice += priceAdjustments.case[currentColors.case];
                }

                // Add bezel price adjustment
                if (priceAdjustments.bezel[currentColors.bezel]) {
                    totalPrice += priceAdjustments.bezel[currentColors.bezel];
                }

                document.getElementById('total-price').textContent = totalPrice.toLocaleString();
                document.getElementById('summary-price').textContent = `$${totalPrice.toLocaleString()}`;
            }

            const customizationPanel = document.querySelector('.customization-panel');
            // Listen for loading screen to finish
            const loadingScreen = document.querySelector('.loading-screen');
            if (loadingScreen) {
                const observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.attributeName === 'style' && loadingScreen.style.display === 'none') {
                            customizationPanel.classList.remove('hidden');
                        }
                    });
                });
                observer.observe(loadingScreen, { attributes: true });
            } else {
                // Fallback: show panel if loading screen not found
                customizationPanel.classList.remove('hidden');
            }
        
        });
    </script>

   <!-- Add this modal structure at the bottom of your body, just before the closing </body> tag -->
<div id="qrModal" class="modal">
    <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h3 class="modal-title">Scan to Try On</h3>
        
       <div id="qr-code-container" class="qr-code">
            <!-- QR code will be generated here -->
             <img id="customImage" src="../Assets/Images/QR-Rolex.png" alt="QR-Rolex">
           
        </div>
        
        <p class="modal-text">Scan this QR code with your smartphone camera to launch the virtual try-on experience.</p>
        
        
        
        <p>Open your camera app, point it at the QR code, and follow the link to try our watches virtually!</p>
    </div>
</div>

<style>
    /* Add these styles to your existing CSS */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        z-index: 1000;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .modal.active {
        display: flex;
        opacity: 1;
    }
    
    .modal-content {
        background: white;
        border-radius: 20px;
        width: 90%;
        max-width: 400px;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        transform: scale(0.9);
        transition: transform 0.4s ease;
    }
    
    .modal.active .modal-content {
        transform: scale(1);
    }
    
    .close-modal {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 28px;
        color: #7f8c8d;
        cursor: pointer;
        transition: color 0.3s ease;
    }
    
    .close-modal:hover {
        color: #e74c3c;
    }
    
    .modal-title {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 20px;
    }
    
    .qr-code {
        width: 300px;
        height: 300px;
        margin: 20px auto;
        background: #f8f9fa;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
    }
    
    .qr-code::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: 
            linear-gradient(45deg, transparent 48%, #2c3e50 48%, #2c3e50 52%, transparent 52%),
            linear-gradient(-45deg, transparent 48%, #2c3e50 48%, #2c3e50 52%, transparent 52%);
        background-size: 20px 20px;
        opacity: 0.1;
    }
    
    .qr-center {
        width: 50px;
        height: 50px;
        background: #2c3e50;
        border-radius: 10px;
        position: relative;
        z-index: 2;
    }
    
    .qr-center::before {
        content: "";
        position: absolute;
        width: 30px;
        height: 30px;
        background: white;
        border-radius: 5px;
        top: 10px;
        left: 10px;
    }
    
    .modal-text {
        color: #7f8c8d;
        line-height: 1.6;
        margin: 20px 0;
    }
    
    .steps {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin: 25px 0;
    }
    
    .step {
        background: #f1f8ff;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        color: #4b6cb7;
        font-size: 18px;
    }
</style>

<script>
    // Add this JavaScript to your existing script section
    document.addEventListener('DOMContentLoaded', function() {
        const tryOnBtn = document.getElementById('virtual-try-on');
        const modal = document.getElementById('qrModal');
        const closeBtn = document.querySelector('.close-modal');
        
        // Open modal when try-on button is clicked
        if (tryOnBtn) {
            tryOnBtn.addEventListener('click', function() {
                modal.classList.add('active');
            });
        }
        
        // Close modal when close button is clicked
        if (closeBtn) {
            closeBtn.addEventListener('click', function() {
                modal.classList.remove('active');
            });
        }
        
        // Close modal when clicking outside of modal content
        window.addEventListener('click', function(event) {
            if (event.target === modal) {
                modal.classList.remove('active');
            }
        });

        

        // QR Code mapping
            const qrImages = {
                'rolex': '/Assets/Images/QR-Rolex.png',
                'omega': '/Assets/Images/QR-Omega.png',
                'patek': '/Assets/Images/QR-Patek.png',
                'cartier': '/Assets/Images/QR-Cartier.png'
            };
            
            // Current watch model
            let currentModel = 'rolex';
            
            // Handle model selection change
            modelSelect.addEventListener('change', function() {
                const selectedModel = this.value;
                currentModel = selectedModel;
                
                // Update watch details
                const modelInfo = modelData[selectedModel];
                document.querySelector('.watch-details h2').textContent = modelInfo.name;
                document.querySelector('.watch-details p').textContent = modelInfo.description;
                document.querySelector('#summary-price').textContent = '$' + modelInfo.price.toLocaleString();
                document.querySelector('#total-price').textContent = modelInfo.price.toLocaleString();
                
                // Update QR code based on model
                qrImage.src = qrImages[selectedModel];
            });
