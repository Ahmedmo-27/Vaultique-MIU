<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title data-translate="configuratorTitle">Vaultique | 3D Watch Configurator - Customize Luxury Timepieces</title>
    <meta name="description" content="Design your perfect luxury watch with Vaultique's 3D configurator. Customize straps, cases, dials, and bezels in real-time. Experience premium Swiss watch customization with virtual try-on technology.">
    <meta name="keywords" content="3D watch configurator, luxury watch customization, Swiss watch designer, virtual try-on, watch customization tool, bespoke timepieces, luxury watch configurator">
    <meta name="author" content="Vaultique">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Vaultique | 3D Watch Configurator - Customize Luxury Timepieces">
    <meta property="og:description" content="Design your perfect luxury watch with Vaultique's 3D configurator. Customize straps, cases, dials, and bezels in real-time.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vaultique.live/user/configurator">
    <meta property="og:image" content="/Assets/Images/LogoV.jpg">
    <meta property="og:site_name" content="Vaultique">
    <meta property="og:locale" content="en_US">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Vaultique | 3D Watch Configurator - Customize Luxury Timepieces">
    <meta name="twitter:description" content="Design your perfect luxury watch with Vaultique's 3D configurator. Customize straps, cases, dials, and bezels in real-time.">
    <meta name="twitter:image" content="/Assets/Images/LogoV.jpg">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://vaultique.live/user/configurator">
    
    <link rel="stylesheet" href="/CSS/configure-3D.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    
    <!-- JSON-LD Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Vaultique 3D Watch Configurator",
        "description": "Interactive 3D watch customization tool for designing luxury Swiss timepieces",
        "url": "https://vaultique.live/user/configurator",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web Browser",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/InStock"
        },
        "featureList": [
            "3D Model Visualization",
            "Real-time Customization",
            "Virtual Try-on",
            "Color Customization",
            "Material Selection",
            "Price Calculation"
        ],
        "screenshot": '/Assets/Images/LogoV.jpg',
        "softwareVersion": "1.0",
        "author": {
            "@type": "Organization",
            "name": "Vaultique"
        }
    }
    </script>
    
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <style>
:root {
  --primary: #2c3e50;
  --secondary: #3498db;
  --accent: #e74c3c;
  --bg: #f5f6fa;
  --card-bg: #fff;
  --border-radius: 14px;
  --shadow: 0 4px 16px rgba(44,62,80,0.08);
  --gap: 2rem;
  --transition: 0.2s;
}

body {
  background: var(--bg);
  font-family: 'Inter', sans-serif;
  color: var(--primary);
  margin: 0;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: var(--gap);
  align-items: flex-start;
}

.configurator-column
{
  background: var(--card-bg);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  padding: 2rem;
}

.customization-column
{
  background: var(--card-bg);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  padding: 2rem;
}

.model-selector {
  margin-bottom: 1.5rem;
}

.model-selector label {
  font-weight: 600;
  margin-bottom: 0.5rem;
  display: block;
}

.model-selector select {
  width: 100%;
  padding: 0.7rem 1rem;
  border-radius: var(--border-radius);
  border: 1.5px solid #e0e0e0;
  font-size: 1rem;
  background: #fafbfc;
  margin-top: 0.5rem;
}

.watch-specs-horizontal {
  display: flex;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
  background: #f8f9fa;
  border-radius: var(--border-radius);
  padding: 1rem;
  font-size: 1rem;
}

.spec-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.model-container {
  aspect-ratio: 1/1;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  margin-bottom: 1.5rem;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.controls {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.btn {
  padding: 0.7rem 1.2rem;
  border-radius: var(--border-radius);
  border: none;
  background: #f8f9fa;
  color: var(--primary);
  cursor: pointer;
  font-weight: 500;
  transition: background var(--transition), color var(--transition), transform var(--transition);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn:hover {
  background: var(--secondary);
  color: #fff;
  transform: translateY(-2px);
}

.customization-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.customization-header h3 {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 1.2rem;
}

.customization-sections {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.customization-section {
  background: #f8f9fa;
  border-radius: var(--border-radius);
  padding: 1.2rem 1rem;
}

.customization-section h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.7rem;
}

.strap-options {
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.strap-option {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background: #fff;
  border: 1.5px solid #e0e0e0;
  cursor: pointer;
  transition: background var(--transition), color var(--transition), border var(--transition);
}

.strap-option.active,
.strap-option:hover {
  background: var(--secondary);
  color: #fff;
  border-color: var(--secondary);
}

.color-options {
  display: flex;
  gap: 0.7rem;
  flex-wrap: wrap;
}

.color-option {
  width: 2.1rem;
  height: 2.1rem;
  border-radius: 50%;
  border: 2.5px solid #e0e0e0;
  cursor: pointer;
  transition: border var(--transition), box-shadow var(--transition), transform var(--transition);
  box-shadow: 0 1px 4px rgba(44,62,80,0.07);
}

.color-option.active,
.color-option:hover {
  border: 2.5px solid var(--secondary);
  box-shadow: 0 0 0 2px var(--primary);
  transform: scale(1.08);
}

.config-summary {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  padding: 2rem;
  margin-bottom: 2rem;
}

.config-summary h3 {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 1.2rem;
}

.summary-details {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #ececec;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  color: #888;
  font-weight: 500;
}

.summary-value {
  color: var(--primary);
  font-weight: 600;
}

.summary-total {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 2px solid #ececec;
  font-size: 1.15rem;
  font-weight: 700;
}

.price-display {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 1rem;
  text-align: right;
}

.add-to-cart {
  width: 100%;
  padding: 1rem;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: var(--border-radius);
  cursor: pointer;
  font-size: 1.1rem;
  font-weight: 600;
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.add-to-cart:hover {
  background: var(--secondary);
  transform: translateY(-2px);
  box-shadow: var(--hover-shadow);
}

@media (max-width: 1024px) {
  .grid {
    grid-template-columns: 1fr;
  }
  .configurator-column,
  .customization-column {
    margin-bottom: 2rem;
  }
}

@media (max-width: 700px) {
  .container {
    padding: 0.5rem;
  }
  .configurator-column,
  .customization-column {
    padding: 1rem;
  }
  .customization-section {
    padding: 0.7rem 0.5rem;
  }
}

.share-form {
  margin-top: 1.5rem;
}

.form-group {
  margin-bottom: 1.2rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--primary);
  font-weight: 500;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.8rem;
  border: 1.5px solid #e0e0e0;
  border-radius: var(--border-radius);
  font-size: 1rem;
  background: #fafbfc;
  transition: border-color var(--transition);
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--secondary);
}

.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background-color: white;
  padding: 2rem;
  border-radius: var(--border-radius);
  max-width: 500px;
  width: 90%;
  position: relative;
}

.close-modal {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 1.5rem;
  cursor: pointer;
  color: #666;
}

.modal-title {
  color: var(--primary);
  margin-bottom: 1.5rem;
  text-align: center;
}

.form-info {
  border-left: 4px solid #3498db;
}

.form-info p {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.form-info i {
  margin-top: 0.2rem;
}

.request-form {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  padding: 2rem;
  margin-top: 2rem;
}

.request-form h3 {
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 1.2rem;
  color: var(--primary);
}

.share-form {
  margin-top: 0;
}

.form-group {
  margin-bottom: 1.2rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--primary);
  font-weight: 500;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 0.8rem;
  border: 1.5px solid #e0e0e0;
  border-radius: var(--border-radius);
  font-size: 1rem;
  background: #fafbfc;
  transition: border-color var(--transition);
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--secondary);
}

.form-info {
  border-left: 4px solid #3498db;
}

.form-info p {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
}

.form-info i {
  margin-top: 0.2rem;
}

@media (max-width: 1024px) {
  .request-form {
    margin-top: 1rem;
  }
}
    </style>
</head>

<body>
    <!-- Loading Screen -->
    <%- include('partials/loading-screen') %>
    <!-- Nav-Bar -->
    <%- include('partials/navigation') %>

    <div class="app" id="configurator-app">
        <main class="main" id="main-content" role="main">
            <div class="container">
                <div class="grid">
                    <!-- Left Column - Configurator -->
                    <div class="configurator-column">
                        <div class="model-selector">
                            <label for="model-selector" data-translate="selectWatchModel">Select Watch Model:</label>
                            <select id="model-selector" class="model-selector">
                                <option value="/Assets/3D Models/Omega Sea Master.glb" data-translate="omega">Omega</option>
                                <option value="/Assets/3D Models/Santos.glb" data-translate="cartier">Cartier</option>
                                <option value="/Assets/3D Models/Audemars Piguet Royal Oak.gltf" data-translate="audemars">Audemars</option>
                            </select>
                        </div>

                        <div class="watch-specs-horizontal">
                            <div class="spec-item">
                                <i class="fas fa-clock" aria-hidden="true"></i>
                                <span data-translate="movement">3235 Calibre</span>
                            </div>
                            <div class="spec-item">
                                <i class="fas fa-tint" aria-hidden="true"></i>
                                <span data-translate="waterResistance">300m Water Resistant</span>
                            </div>
                            <div class="spec-item">
                                <i class="fas fa-battery-full" aria-hidden="true"></i>
                                <span data-translate="powerReserve">70h Power Reserve</span>
                            </div>
                        </div>

                        <div class="model-container">
                            <model-viewer 
                                id="watch-model"
                                src="/Assets/3D Models/Omega Sea Master.glb"
                                camera-controls
                                auto-rotate
                                ar
                                ar-modes="webxr scene-viewer quick-look"
                                camera-orbit="0deg 75deg 105%"
                                min-camera-orbit="auto auto 50%"
                                max-camera-orbit="auto auto 150%"
                                min-field-of-view="30deg"
                                max-field-of-view="90deg"
                                shadow-intensity="1"
                                exposure="1"
                                environment-image="neutral"
                                loading="lazy"
                                reveal="auto"
                                preload="metadata"
                                style="width: 100%; height: 100%;"
                            >
                                <div class="progress-bar" slot="progress-bar"></div>
                                <div slot="poster" style="width:100%;height:100%;display:flex;justify-content:center;align-items:center;">
                                    <div class="loading-spinner"></div>
                                </div>
                            </model-viewer>
                        </div>

                        <div class="controls">
                            <button id="toggle-rotate" class="btn" data-translate="toggleRotation">
                                <i class="fas fa-sync-alt"></i> <span data-translate="toggleRotation">Toggle Rotation</span>
                            </button>
                            <button id="reset-camera" class="btn" data-translate="resetView">
                                <i class="fas fa-undo"></i> <span data-translate="resetView">Reset View</span>
                            </button>
                            <button id="fullscreen" class="btn" data-translate="fullscreen">
                                <i class="fas fa-expand"></i> <span data-translate="fullscreen">Fullscreen</span>
                            </button>
                            <button id="virtual-try-on" class="btn" data-translate="virtualTryOn">
                                <i class="fas fa-vr-cardboard"></i> <span data-translate="virtualTryOn">Virtual Try-On</span>
                            </button>
                            <button id="detector" class="btn" data-translate="detector">
                                <i class="fas fa-search"></i> <span data-translate="detector">Detector</span>
                            </button>
                        </div>
                    </div>

                    <div class="customization-panel">
                        <div class="customization-sections">
                            <!-- Color Sections -->
                            <div class="customization-section">
                                <h3 data-translate="strapColor">Strap Color</h3>
                                <div class="color-options">
                                    <div class="color-option" style="background-color: #1A1A1A;" data-color="black"></div>
                                    <div class="color-option" style="background-color: #8B4513;" data-color="brown"></div>
                                    <div class="color-option" style="background-color: #C0C0C0;" data-color="silver"></div>
                                    <div class="color-option" style="background-color: #D4AF37;" data-color="gold"></div>
                                    <div class="color-option" style="background-color: #B87333;" data-color="rose-gold"></div>
                                </div>
                            </div>

                            <div class="customization-section">
                                <h3 data-translate="caseColor">Case Color</h3>
                                <div class="color-options">
                                    <div class="color-option" style="background-color: #1A1A1A;" data-color="black"></div>
                                    <div class="color-option" style="background-color: #C0C0C0;" data-color="silver"></div>
                                    <div class="color-option" style="background-color: #D4AF37;" data-color="gold"></div>
                                    <div class="color-option" style="background-color: #B87333;" data-color="rose-gold"></div>
                                    <div class="color-option" style="background-color: #2F4F4F;" data-color="platinum"></div>
                                </div>
                            </div>

                            <div class="customization-section">
                                <h3 data-translate="bezelColor">Bezel Color</h3>
                                <div class="color-options">
                                    <div class="color-option" style="background-color: #1A1A1A;" data-color="black"></div>
                                    <div class="color-option" style="background-color: #C0C0C0;" data-color="silver"></div>
                                    <div class="color-option" style="background-color: #D4AF37;" data-color="gold"></div>
                                    <div class="color-option" style="background-color: #B87333;" data-color="rose-gold"></div>
                                    <div class="color-option" style="background-color: #2F4F4F;" data-color="platinum"></div>
                                </div>
                            </div>

                            <div class="customization-section">
                                <h3 data-translate="dialColor">Dial Color</h3>
                                <div class="color-options">
                                    <div class="color-option" style="background-color: #1A1A1A;" data-color="black"></div>
                                    <div class="color-option" style="background-color: #FFFFFF;" data-color="white"></div>
                                    <div class="color-option" style="background-color: #2F4F4F;" data-color="platinum"></div>
                                    <div class="color-option" style="background-color: #8B4513;" data-color="brown"></div>
                                    <div class="color-option" style="background-color: #4682B4;" data-color="blue"></div>
                                </div>
                            </div>
                        </div>

                        <div class="customization-footer">
                            <div class="price-display">
                                <span data-translate="total">Total</span>: $<span id="total-price">8,500</span>
                            </div>
                            <button id="share-config" class="btn" style="width: 100%; margin-top: 1rem;" data-translate="requestOrder">
                                <i class="fas fa-shopping-cart"></i> <span data-translate="requestOrder">Request Order</span>
                            </button>
                        </div>
                    </div>


                    <div class="customization-column">
                        <div class="watch-details">
                            <h2 id="details-heading" data-translate="modelName">Omega Sea Master</h2>
                            <p id="watch-description" data-translate="modelDescription">
                                <%= locals.watch?.description || 'The Omega Sea Master is a professional diving watch that is designed for those who are passionate about diving and the ocean. It is a true icon in the world of luxury diving watches, it offers exceptional precision and reliability.' %>
                            </p>
                        </div>

                        <div class="config-summary">
                            <h3 data-translate="yourConfiguration">Your Configuration</h3>
                            <div class="summary-details">
                                <div class="summary-row">
                                    <span class="summary-label" data-translate="model">Model</span>
                                    <span class="summary-value" id="summary-model">Omega Sea Master</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-label" data-translate="strap">Strap</span>
                                    <span id="summary-strap" class="summary-value">Black</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-label" data-translate="case">Case</span>
                                    <span id="summary-case" class="summary-value">Silver</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-label" data-translate="dial">Dial</span>
                                    <span id="summary-dial" class="summary-value">Black</span>
                                </div>
                                <div class="summary-row">
                                    <span class="summary-label" data-translate="bezel">Bezel</span>
                                    <span id="summary-bezel" class="summary-value">Black</span>
                                </div>
                                <div class="summary-row summary-total">
                                    <span class="summary-label" data-translate="totalPrice">Total Price</span>
                                    <span id="summary-price" class="summary-value price">
                                        $<%= (locals.watch?.basePrice || 7500).toLocaleString() %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                        <!-- Request Form -->
                        <div class="request-form">
                            <h3 data-translate="requestCustomWatch">Request Custom Watch</h3>
                            <form id="share-form" class="share-form">
                                <div class="form-group">
                                    <label for="share-name" data-translate="yourName">Your Name:</label>
                                    <input type="text" id="share-name" name="name" value="<%= locals.user?.Name || '' %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="share-email" data-translate="yourEmail">Your Email:</label>
                                    <input type="email" id="share-email" name="email" value="<%= locals.user?.email || '' %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="share-message" data-translate="specialRequirements">Special Requirements or Notes:</label>
                                    <textarea id="share-message" name="message" rows="3" placeholder="Please let us know if you have any special requirements or preferences for your custom watch..." data-translate-placeholder="specialRequirementsPlaceholder"></textarea>
                                </div>
                                <div class="form-info" style="margin-bottom: 1.5rem; padding: 1rem; background-color: #f8f9fa; border-radius: var(--border-radius);">
                                    <p style="color: #34495e; font-size: 0.9rem; line-height: 1.5; margin: 0;" data-translate="afterSubmitting">
                                        <i class="fas fa-info-circle" style="color: #3498db;"></i>
                                        After submitting your request, our team will review it and contact you within 2-3 business days to discuss the details and provide a final quote.
                                    </p>
                                </div>
                                <button type="submit" class="btn" style="width: 100%;" data-translate="submitCustomizationRequest">
                                    <i class="fas fa-paper-plane"></i> <span data-translate="submitCustomizationRequest">Submit Customization Request</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <%- include('partials/footer') %>
    </div>

    <!-- QR Modal -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <h3 class="modal-title" data-translate="scanToTryOn">Scan to Try On</h3>
            <div id="qr-code-container" class="qr-code">
                <img id="customImage" src="../Assets/Images/QR-Rolex.png" alt="QR-Rolex">
            </div>
            <p class="modal-text" data-translate="scanQrInstruction">Scan this QR code with your smartphone camera to launch the virtual try-on experience.</p>
            <p data-translate="openCameraInstruction">Open your camera app, point it at the QR code, and follow the link to try our watches virtually!</p>
        </div>
    </div>

    <script>
        // Client-side asset URL helper injected from server `assetBaseUrl`
        const ASSET_BASE_URL = <%- JSON.stringify(assetBaseUrl || '') %>;
        function assetUrl(p) {
            if (!p) return p;
            if (typeof p === 'string' && (p.startsWith('http://') || p.startsWith('https://'))) return p;
            if (typeof p === 'string' && p.startsWith('/')) {
                return ASSET_BASE_URL.replace(/\/$/, '') + encodeURI(p);
            }
            return ASSET_BASE_URL.replace(/\/$/, '') + '/' + encodeURI(p.replace(/^public\//, '').replace(/^\/+/, ''));
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Constants and configuration
            const CONFIG = {
                basePrice: 8500,
                priceAdjustments: {
                    strap: {
                        leather: 0,
                        metal: 1000,
                        rubber: 500,
                        fabric: 300
                    },
                    case: {
                        'silver': 0,
                        'gold': 2000,
                        'rose-gold': 2500,
                        'black': 1500
                    },
                    bezel: {
                        'silver': 0,
                        'gold': 1000,
                        'rose-gold': 1500,
                        'black': 800
                    }
                },
                colorMap: {
                    black: [0.102, 0.102, 0.102, 1.0],      // #1A1A1A - Rich black
                    white: [1.0, 1.0, 1.0, 1.0],            // #FFFFFF - Pure white
                    silver: [0.75, 0.75, 0.75, 1.0],        // #C0C0C0 - Classic silver
                    gold: [0.831, 0.686, 0.216, 1.0],       // #D4AF37 - Classic gold
                    'rose-gold': [0.722, 0.451, 0.2, 1.0],  // #B87333 - Rose gold
                    brown: [0.545, 0.271, 0.075, 1.0],      // #8B4513 - Saddle brown
                    platinum: [0.184, 0.31, 0.31, 1.0],     // #2F4F4F - Platinum
                    blue: [0.275, 0.51, 0.706, 1.0]         // #4682B4 - Steel blue
                },
                watchData: {
                    "Omega": {
                        name: "Omega Sea Master",
                        description: "The Omega Sea Master combines elegance with professional diving capabilities. A true icon in the world of luxury diving watches, it offers exceptional precision and reliability.",
                        movement: "8800 Calibre",
                        waterResistance: "300m Water Resistant",
                        powerReserve: "55h Power Reserve",
                        price: 7500
                    },
                    "Cartier": {
                        name: "Santos",
                        description: "The Cartier Santos is a masterpiece of design and elegance. With its distinctive rectangular case and Roman numerals, it has become one of the most iconic timepieces in watchmaking history.",
                        movement: "1847 MC Calibre",
                        waterResistance: "30m Water Resistant",
                        powerReserve: "40h Power Reserve",
                        price: 6800
                    },
                    "Audemars": {
                        name: "Royal Oak",
                        description: "The Audemars Piguet Royal Oak revolutionized watchmaking with its distinctive octagonal bezel and integrated bracelet. A true icon of luxury sports watches.",
                        movement: "3120 Calibre",
                        waterResistance: "50m Water Resistant",
                        powerReserve: "60h Power Reserve",
                        price: 9200
                    }
                }
            };

            // DOM Elements
            const elements = {
                modelViewer: document.querySelector('model-viewer'),
                resetBtn: document.getElementById('reset-camera'),
                rotateBtn: document.getElementById('toggle-rotate'),
                fullscreenBtn: document.getElementById('fullscreen'),
                tryOnBtn: document.getElementById('virtual-try-on'),
                detectorBtn: document.getElementById('detector'),
                modal: document.getElementById('qrModal'),
                closeBtn: document.querySelector('.close-modal'),
                modelSelect: document.getElementById('model-selector'),
                totalPrice: document.getElementById('total-price'),
                strapOptions: document.querySelectorAll('.strap-option'),
                colorOptions: document.querySelectorAll('.color-option')
            };

            // State management
            const state = {
                currentColors: {
                    strap: 'black',
                    case: 'silver',
                    bezel: 'silver',
                    dial: 'black'
                },
                currentModel: null,
                currentPrice: CONFIG.basePrice,
                modelCache: new Map(), // Cache for preloaded models
                isLoading: false
            };

            // Model preloading and caching
            function preloadModel(modelPath) {
                if (state.modelCache.has(modelPath)) {
                    return Promise.resolve(state.modelCache.get(modelPath));
                }

                return new Promise((resolve, reject) => {
                    // Use fetch instead of link preload for 3D models
                    fetch(modelPath, { 
                        method: 'HEAD',
                        cache: 'force-cache'
                    })
                    .then(response => {
                        if (response.ok) {
                            state.modelCache.set(modelPath, true);
                            resolve(true);
                        } else {
                            reject(new Error(`Failed to preload model: ${modelPath}`));
                        }
                    })
                    .catch(error => {
                        reject(new Error(`Failed to preload model: ${modelPath} - ${error.message}`));
                    });
                });
            }
            const omegaPath = assetUrl('/Assets/3D Models/Omega Sea Master.glb');
            const cartierPath = assetUrl('/Assets/3D Models/Santos.glb');
            const audemarsPath = assetUrl('/Assets/3D Models/Audemars Piguet Royal Oak.gltf');

            // Preload all models in background
            function preloadAllModels() {
                const modelPaths = [
                    omegaPath,
                    cartierPath,
                    audemarsPath
                ];

                console.log('🔄 Starting intelligent model preloading...');
                
                // Preload the first model immediately (current default)
                preloadModel(modelPaths[0])
                    .then(() => {
                        console.log(`✅ Preloaded default model: ${modelPaths[0].split('/').pop()}`);
                        
                        // Preload the next most likely model (Rolex)
                        return preloadModel(modelPaths[1]);
                    })
                    .then(() => {
                        console.log(`✅ Preloaded secondary model: ${modelPaths[1].split('/').pop()}`);
                    })
                    .catch(error => {
                        console.warn(`⚠️ Preload failed:`, error.message);
                    });
                
                // Preload remaining models with longer delays
                setTimeout(() => {
                    preloadModel(modelPaths[2])
                        .then(() => console.log(`✅ Preloaded: ${modelPaths[2].split('/').pop()}`))
                        .catch(error => console.warn(`⚠️ Failed to preload: ${modelPaths[2].split('/').pop()}`));
                }, 2000);
                
                setTimeout(() => {
                    preloadModel(modelPaths[3])
                        .then(() => console.log(`✅ Preloaded: ${modelPaths[3].split('/').pop()}`))
                        .catch(error => console.warn(`⚠️ Failed to preload: ${modelPaths[3].split('/').pop()}`));
                }, 4000);
            }

            // Model viewer setup
            function setupModelViewer() {
                if (!elements.modelViewer) return;

                elements.modelViewer.addEventListener('progress', (event) => {
                    const progressBar = document.querySelector('.progress-bar');
                    if (progressBar) {
                        const progress = event.detail.totalProgress * 100;
                        progressBar.style.setProperty('--progress', progress + '%');
                        console.log(`📊 Loading progress: ${progress.toFixed(1)}%`);
                    }
                });

                elements.modelViewer.addEventListener('load', () => {
                    console.log('✅ 3D model loaded successfully');
                    updateModelStrap('Rubber');
                    
                    // Hide loading spinner
                    const spinner = document.querySelector('.loading-spinner');
                    if (spinner) {
                        spinner.style.display = 'none';
                    }
                });

                elements.modelViewer.addEventListener('error', (error) => {
                    console.error('❌ Error loading 3D model:', error);
                    
                    // Show error message
                    const modelContainer = document.querySelector('.model-container');
                    if (modelContainer) {
                        const errorDiv = document.createElement('div');
                        errorDiv.style.cssText = `
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -50%);
                            background: rgba(255, 0, 0, 0.1);
                            color: #d32f2f;
                            padding: 1rem;
                            border-radius: 8px;
                            text-align: center;
                            z-index: 10;
                        `;
                        errorDiv.innerHTML = `
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>Failed to load 3D model</p>
                            <small>Please try refreshing the page</small>
                        `;
                        modelContainer.appendChild(errorDiv);
                    }
                });
            }

            // Controls setup
            function setupControls() {
                if (elements.rotateBtn) {
                    elements.rotateBtn.addEventListener('click', () => {
                        elements.modelViewer.autoRotate = !elements.modelViewer.autoRotate;
                        elements.rotateBtn.textContent = elements.modelViewer.autoRotate ? 'Stop Rotation' : 'Start Rotation';
                    });
                }

                if (elements.resetBtn) {
                    elements.resetBtn.addEventListener('click', () => {
                        elements.modelViewer.cameraOrbit = "0deg 75deg 105%";
                    });
                }

                if (elements.fullscreenBtn) {
                    elements.fullscreenBtn.addEventListener('click', () => {
                        elements.modelViewer.requestFullscreen();
                    });
                }

                if (elements.detectorBtn) {
                    elements.detectorBtn.addEventListener('click', () => {
                        // Navigate to wrist detector page
                        window.location.href = '/wrist-detector';
                    });
                }
            }

            // Customization handlers
            function setupCustomizationHandlers() {
                // Strap selection
                elements.strapOptions.forEach(option => {
                    option.addEventListener('click', () => {
                        elements.strapOptions.forEach(opt => opt.classList.remove('active'));
                        option.classList.add('active');
                        const strap = option.dataset.strap;
                        updateModelStrap(strap);
                        updateSummaryText('strap', strap);
                        updateTotalPrice();
                    });
                });

                // Color selection
                elements.colorOptions.forEach(option => {
                    option.addEventListener('click', () => {
                        const color = option.dataset.color;
                        const section = option.closest('.customization-section');
                        const component = section.querySelector('h3').textContent.toLowerCase().replace(' color', '');
                        
                        section.querySelectorAll('.color-option').forEach(opt => opt.classList.remove('active'));
                        option.classList.add('active');

                        state.currentColors[component] = color;
                        updateModelComponent(component, color);
                        updateTotalPrice();
                    });
                });
            }

            // Model selection handler
            function setupModelSelection() {
                if (!elements.modelSelect) return;

                elements.modelSelect.addEventListener('change', async function() {
                    if (state.isLoading) return; // Prevent multiple simultaneous loads
                    
                    const selectedModel = this.value;
                    const modelName = this.options[this.selectedIndex].text;
                    const modelInfo = CONFIG.watchData[modelName];
                    
                    if (modelInfo) {
                        state.isLoading = true;
                        state.currentModel = modelName;
                        
                        // Show loading state
                        const modelContainer = document.querySelector('.model-container');
                        if (modelContainer) {
                            modelContainer.style.opacity = '0.7';
                        }
                        
                        try {
                            // Check if model is cached
                            if (!state.modelCache.has(selectedModel)) {
                                await preloadModel(selectedModel);
                            }
                            
                            updateModelViewer(selectedModel, modelInfo);
                            updateWatchDetails(modelInfo);
                        } catch (error) {
                            console.error('Error loading model:', error);
                            // Fallback to direct loading
                            updateModelViewer(selectedModel, modelInfo);
                            updateWatchDetails(modelInfo);
                        } finally {
                            state.isLoading = false;
                            if (modelContainer) {
                                modelContainer.style.opacity = '1';
                            }
                        }
                    }
                });

                // Initialize with first model
                const initialModel = elements.modelSelect.options[0].text;
                const initialModelInfo = CONFIG.watchData[initialModel];
                if (initialModelInfo) {
                    updateWatchDetails(initialModelInfo);
                }
            }

            // Update functions
            function updateModelViewer(modelPath, modelInfo) {
                if (!elements.modelViewer) return;
                
                // Check if model is already cached
                if (state.modelCache.has(modelPath)) {
                    console.log(`🚀 Using cached model: ${modelPath.split('/').pop()}`);
                } else {
                    console.log(`📥 Loading new model: ${modelPath.split('/').pop()}`);
                }
                
                elements.modelViewer.src = modelPath;
            }

            function updateWatchDetails(modelInfo) {
                const elements = {
                    heading: document.getElementById('details-heading'),
                    description: document.getElementById('watch-description'),
                    model: document.getElementById('summary-model'),
                    price: document.getElementById('summary-price'),
                    totalPrice: document.getElementById('total-price')
                };

                if (elements.heading) elements.heading.textContent = modelInfo.name;
                if (elements.description) elements.description.textContent = modelInfo.description;
                if (elements.model) elements.model.textContent = modelInfo.name;
                if (elements.price) elements.price.textContent = '$' + modelInfo.price.toLocaleString();
                if (elements.totalPrice) elements.totalPrice.textContent = modelInfo.price.toLocaleString();

                // Update specs
                const specsContainer = document.querySelector('.watch-specs-horizontal');
                if (specsContainer) {
                    specsContainer.innerHTML = `
                        <div class="spec-item">
                            <i class="fas fa-clock" aria-hidden="true"></i>
                            <span>${modelInfo.movement}</span>
                        </div>
                        <div class="spec-item">
                            <i class="fas fa-tint" aria-hidden="true"></i>
                            <span>${modelInfo.waterResistance}</span>
                        </div>
                        <div class="spec-item">
                            <i class="fas fa-battery-full" aria-hidden="true"></i>
                            <span>${modelInfo.powerReserve}</span>
                        </div>
                    `;
                }
            }

            

            function updateTotalPrice() {
                let totalPrice = state.currentPrice;

                // Add strap price adjustment
                const currentStrap = document.querySelector('.strap-option.active')?.dataset.strap;
                if (currentStrap && CONFIG.priceAdjustments.strap[currentStrap]) {
                    totalPrice += CONFIG.priceAdjustments.strap[currentStrap];
                }

                // Add case price adjustment
                if (CONFIG.priceAdjustments.case[state.currentColors.case]) {
                    totalPrice += CONFIG.priceAdjustments.case[state.currentColors.case];
                }

                // Add bezel price adjustment
                if (CONFIG.priceAdjustments.bezel[state.currentColors.bezel]) {
                    totalPrice += CONFIG.priceAdjustments.bezel[state.currentColors.bezel];
                }

                if (elements.totalPrice) {
                    elements.totalPrice.textContent = totalPrice.toLocaleString();
                }
            }

            // Add updateModelStrap function
            function updateModelStrap(strapType) {
                if (!elements.modelViewer || !elements.modelViewer.model || !elements.modelViewer.model.materials) {
                    console.log('Model or materials not yet loaded');
                    return;
                }

                const materials = elements.modelViewer.model.materials;
                const strapMaterial = materials.find(m => m.name === 'Strap_MORK.001');
                
                if (strapMaterial && strapMaterial.pbrMetallicRoughness) {
                    try {
                        switch(strapType) {
                            case 'leather':
                                strapMaterial.pbrMetallicRoughness.setBaseColorFactor([0.545, 0.271, 0.075, 1.0]); // Brown
                                strapMaterial.pbrMetallicRoughness.setMetallicFactor(0.0);
                                strapMaterial.pbrMetallicRoughness.setRoughnessFactor(0.8);
                                break;
                            case 'metal':
                                strapMaterial.pbrMetallicRoughness.setBaseColorFactor([0.75, 0.75, 0.75, 1.0]); // Silver
                                strapMaterial.pbrMetallicRoughness.setMetallicFactor(0.9);
                                strapMaterial.pbrMetallicRoughness.setRoughnessFactor(0.2);
                                break;
                            case 'rubber':
                                strapMaterial.pbrMetallicRoughness.setBaseColorFactor([0.102, 0.102, 0.102, 1.0]); // Black
                                strapMaterial.pbrMetallicRoughness.setMetallicFactor(0.0);
                                strapMaterial.pbrMetallicRoughness.setRoughnessFactor(0.5);
                                break;
                            case 'fabric':
                                strapMaterial.pbrMetallicRoughness.setBaseColorFactor([0.275, 0.51, 0.706, 1.0]); // Blue
                                strapMaterial.pbrMetallicRoughness.setMetallicFactor(0.0);
                                strapMaterial.pbrMetallicRoughness.setRoughnessFactor(0.7);
                                break;
                        }
                    } catch (error) {
                        console.error('Error updating strap material:', error);
                    }
                }
            }

            // Update material mappings based on actual material names
            const materialMappings = {
                'Omega Sea Master': {
                    strap: ['Strap_MORK.001'],
                    case: ['Screws', 'Brushed Aluminum 2', 'Silver'],
                    bezel: ['Urtavla_PrimarOpaqueTEXT.001'],
                    dial: ['Brushed Aluminum 2.001'],
                    numerals: ['Siffror+Kvartar_UrtavlaFYLL.001', 'Siffor+kvartar_UrtavlaRAM.001'],
                    logo: ['Urtavla_OMEGA_Logo_VIT.001'],
                    glass: ['Glass']
                },
                'Cartier': {
                    strap: ['Strap'],
                    case: ['Case'],
                    bezel: ['Bezel'],
                    dial: ['Face'],
                    numerals: ['Face'],
                    screws: ['Screws']
                },
                'Audemars': {
                    strap: ['metal.001'],
                    case: ['Screws', 'Silver', 'back plate'],
                    bezel: ['metal.001'],
                    dial: ['blue'],
                    numerals: ['AP inner text'],
                    glass: ['Glass']
                },
                'Rolex': {
                    strap: ['Strap'],
                    case: ['Case', 'Silver', 'Screws'],
                    bezel: ['Bezel'],
                    dial: ['Face'],
                    numerals: ['Analogs'],
                    glass: ['Glass']
                }
            };

            function updateModelComponent(component, color) {
                if (!elements.modelViewer || !elements.modelViewer.model || !elements.modelViewer.model.materials) {
                    console.log('Model or materials not yet loaded');
                    return;
                }

                const materials = elements.modelViewer.model.materials;
                console.log('Current materials:', materials.map(m => m.name));
                console.log('Updating component:', component, 'with color:', color);

                // Detect current model from source URL
                const currentModel = elements.modelViewer.src.includes('Santos') ? 'Cartier' : 
                                   elements.modelViewer.src.includes('Royal') ? 'Audemars' : 
                                   elements.modelViewer.src.includes('Rolex') ? 'Rolex' :
                                   'Omega Sea Master';
                console.log('Current model:', currentModel);

                const mappings = materialMappings[currentModel];
                if (!mappings || !mappings[component]) {
                    console.log('No material mappings found for model:', currentModel, 'component:', component);
                    return;
                }

                // Update materials based on mapping
                mappings[component].forEach(materialName => {
                    const material = materials.find(m => m.name === materialName);
                    if (material && material.pbrMetallicRoughness) {
                        console.log('Updating material:', materialName);
                        material.pbrMetallicRoughness.setBaseColorFactor(CONFIG.colorMap[color]);
                        
                        // Set appropriate metallic and roughness values based on material type
                        if (materialName.includes('Strap') || materialName.includes('strap')) {
                            material.pbrMetallicRoughness.setMetallicFactor(0.0);
                            material.pbrMetallicRoughness.setRoughnessFactor(0.5);
                        } else if (materialName.includes('Glass') || materialName.includes('glass')) {
                            material.pbrMetallicRoughness.setMetallicFactor(0.0);
                            material.pbrMetallicRoughness.setRoughnessFactor(0.1);
                        } else if (materialName.includes('Dial') || materialName.includes('Face') || materialName.includes('dial') || materialName.includes('blue')) {
                            material.pbrMetallicRoughness.setMetallicFactor(0.0);
                            material.pbrMetallicRoughness.setRoughnessFactor(0.4);
                        } else {
                            material.pbrMetallicRoughness.setMetallicFactor(0.9);
                            material.pbrMetallicRoughness.setRoughnessFactor(0.2);
                        }
                    }
                });

                // Update summary text
                updateSummaryText(component, color);
            }

            // Add function to update summary text
            function updateSummaryText(component, color) {
                const summaryElement = document.getElementById(`summary-${component}`);
                if (summaryElement) {
                    // Capitalize first letter of color
                    const formattedColor = color.charAt(0).toUpperCase() + color.slice(1);
                    summaryElement.textContent = formattedColor;
                }
            }

            // Modal setup
            function setupModal() {
                if (!elements.tryOnBtn || !elements.modal || !elements.closeBtn) return;

                elements.tryOnBtn.addEventListener('click', () => {
                    elements.modal.classList.add('active');
                });

                elements.closeBtn.addEventListener('click', () => {
                    elements.modal.classList.remove('active');
                });

                window.addEventListener('click', (event) => {
                    if (event.target === elements.modal) {
                        elements.modal.classList.remove('active');
                    }
                });
            }

            // Share configuration functionality
            function setupShareConfiguration() {
                const shareForm = document.getElementById('share-form');

                shareForm.addEventListener('submit', async (e) => {
                    e.preventDefault();

                    const formData = {
                        name: document.getElementById('share-name').value,
                        email: document.getElementById('share-email').value,
                        message: document.getElementById('share-message').value,
                        configuration: {
                            model: state.currentModel,
                            strap: state.currentColors.strap,
                            case: state.currentColors.case,
                            bezel: state.currentColors.bezel,
                            dial: state.currentColors.dial,
                            price: state.currentPrice
                        }
                    };

                    try {
                        const response = await fetch('/api/share-configuration', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(formData)
                        });

                        if (response.ok) {
                            alert('Your customization request has been submitted successfully! We will contact you within 2-3 business days.');
                            shareForm.reset();
                        } else {
                            throw new Error('Failed to submit customization request');
                        }
                    } catch (error) {
                        console.error('Error submitting customization request:', error);
                        alert('Failed to submit customization request. Please try again.');
                    }
                });
            }

            // Initialize
            function init() {
                setupModelViewer();
                setupControls();
                setupCustomizationHandlers();
                setupModelSelection();
                setupModal();
                setupShareConfiguration();
                
                // Start preloading models after initial setup
                setTimeout(() => {
                    preloadAllModels();
                }, 1000); // Delay to prioritize initial page load
                
                // Add performance monitoring
                if ('performance' in window) {
                    window.addEventListener('load', () => {
                        // Use modern Performance API
                        const navigation = performance.getEntriesByType('navigation')[0];
                        if (navigation) {
                            const loadTime = navigation.loadEventEnd - navigation.loadEventStart;
                            const domContentLoaded = navigation.domContentLoadedEventEnd - navigation.domContentLoadedEventStart;
                            const totalLoadTime = navigation.loadEventEnd - navigation.fetchStart;
                            
                            console.log(`📊 Performance Metrics:`);
                            console.log(`- DOM Content Loaded: ${domContentLoaded}ms`);
                            console.log(`- Page Load Time: ${loadTime}ms`);
                            console.log(`- Total Load Time: ${totalLoadTime}ms`);
                        } else {
                            // Fallback for older browsers
                            const loadTime = performance.now();
                            console.log(`📊 Page load time: ${loadTime.toFixed(2)}ms`);
                        }
                    });
                }
            }

            // Start the application
            init();
        });
    </script>
    <!-- ملفات الترجمة -->
<script src="/Javascript/translations.js"></script>
<script src="/Javascript/language.js"></script>
</body>

