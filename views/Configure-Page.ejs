<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vaultique | Configurator</title>
    <link rel="stylesheet" href="/CSS/configure-3D.css">
    <link rel="stylesheet" href="/CSS/nav-bar.css">
    <link rel="stylesheet" href="/CSS/footer.css">
    <link rel="stylesheet" href="/CSS/Loading Screen.css">
    <link rel="icon" type="image/x-icon" href="/Assets/Images/LogoV.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    <script src="/Javascript/nav-bar.js"></script>
    <script src="/Javascript/Loading Screen.js"></script>
    <script src="/Javascript/Light-Mode.js"></script>
    <style>
      .customization-panel {
            background: rgba(255, 255, 255, 0.95);
            padding: 16px 20px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 18px;
            width: 100%;
            align-items: flex-end;
            margin-bottom: 24px;
            position: static;
            max-width: 100%;
            overflow-x: visible;
        }

        .customization-section {
            margin-bottom: 0;
            margin-right: 10px;
            min-width: 90px;
        }

        .customization-section h3 {
            margin-bottom: 10px;
            color: #333;
            font-size: 16px;
        }

        .color-options {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .color-option {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #ddd;
            transition: transform 0.2s;
        }

        .color-option:hover {
            transform: scale(1.1);
        }

        .color-option.active {
            border-color: #333;
        }

        .price-display {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            font-size: 18px;
            font-weight: bold;
        }

        .add-to-cart {
            width: 100%;
            padding: 12px;
            background: #333;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.2s;
        }

        .add-to-cart:hover {
            background: #444;
        }
    </style>
</head>

<body>
    <!-- Loading Screen -->
    <%- include('partials/loading-screen') %>
    <!-- Nav-Bar -->
    <%- include('partials/navigation') %>

