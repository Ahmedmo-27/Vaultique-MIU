   <!-- Replace <div class="container">...</div> with this -->
<div class="container">
    <div class="controls">
      <input type="text" id="search" placeholder="Search by Name or Email" />
      <button id="addUserBtn">+ Add User</button>
    </div>
  
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Division</th>
          <th>Access Level</th>
          <th>Date Added</th>
          <th>Last Login</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="userTableBody"></tbody>
    </table>
  </div>
  
    
      <!-- View Orders Modal -->
      <div id="ordersModal" class="modal hidden">
        <div class="modal-content">
          <h2>User Orders</h2>
          <ul id="ordersList"></ul>
          <button id="closeOrdersBtn">Close</button>
        </div>
      </div>
    
      <!-- View User Details Modal -->
      <div id="userDetailsModal" class="modal hidden">
        <div class="modal-content">
          <h2>User Details</h2>
          <div id="userDetailsContent">
            <p><strong>Name:</strong> <span id="detailName"></span></p>
            <p><strong>Email:</strong> <span id="detailEmail"></span></p>
            <p><strong>Phone:</strong> <span id="detailPhone"></span></p>
            <p><strong>Date of Birth:</strong> <span id="detailDOB"></span></p>
            <p><strong>Language:</strong> <span id="detailLanguage"></span></p>
            <p><strong>Role:</strong> <span id="detailRole"></span></p>
            <p><strong>Access Level:</strong> <span id="detailAccess"></span></p>
            <p><strong>Date Added:</strong> <span id="detailDateAdded"></span></p>
            <p><strong>Last Login:</strong> <span id="detailLastLogin"></span></p>
            <p><strong>Credit Card:</strong> <span id="detailCreditCard"></span></p>
          </div>
          <button id="closeDetailsBtn">Close</button>
        </div>
      </div>
    
      <!-- Add User Modal -->
      <div id="addUserModal" class="modal hidden">
        <div class="modal-content">
          <h2>Add New User</h2>
          <input type="text" id="nameInput" placeholder="Name" />
          <input type="email" id="emailInput" placeholder="Email" />
          <input type="text" id="roleInput" placeholder="Role" />
          <input type="text" id="divisionInput" placeholder="Division" />
          <input type="text" id="accessInput" placeholder="Access Level" />
          <button id="saveUserBtn">Save</button>
          <button id="closeModalBtn">Cancel</button>
        </div>
      </div>
    
      <script src="ManageUsers.js"></script>
    </body>
    
